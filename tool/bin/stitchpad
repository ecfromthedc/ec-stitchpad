#!/usr/bin/env bash
# stitchpad — a model-agnostic agent channel that's just a markdown file.
#
#   stitchpad init [--name <pad>]         create .stitchpad/ in the current project
#   stitchpad join <name> <adapter> [wake] [target] [--role <r>] [--level <l>]   add a participant
#   stitchpad leave [name]                remove a name from the roster (active seat only)
#   stitchpad set-wake <name> <push|pull> <target> [adapter]   update wake mode for an existing row
#   stitchpad rename <old> <new>          rename a member everywhere local state knows them
#   STITCHPAD_NAME=<you> stitchpad say [--image <path>] <text...>   post a message (auto-commits)
#   STITCHPAD_NAME=<you> stitchpad say [--re <#m-id>] [--image <path>] <text...>   post a message (auto-commits; --re threads it)
#   STITCHPAD_NAME=<you> stitchpad react <#m-id> <emoji>   react to a message (toggle; never wakes)
#   STITCHPAD_NAME=<you> stitchpad amend <#m-id> <text|--file f>   rewrite YOUR message's body in place (live cards)
#   STITCHPAD_NAME=<you> stitchpad run [--title t] <label>=<cmd>...   run steps as a live-amending ui timeline
#   STITCHPAD_NAME=<you> stitchpad drop <file> [note]   share a doc: dropbox/ + relay mirror + one 📎 pad line
#   stitchpad read [-n N]                 print the recent conversation (plain)
#   stitchpad who / stitchpad roster      print parsed roster
#   stitchpad whoami                      print your own resolved name for this terminal
#   stitchpad task new|list|show|move|edit|migrate   kanban board — cards live in tasks.md
#   stitchpad task                        bare 'task' prints the board
#   stitchpad meta set|get <name> <key> [value]  runtime/model metadata
#   stitchpad dnd on|off [--drain]|status silence/resume wake delivery
#   stitchpad wake [name] [--peek]        print new @name messages since last drain
#   stitchpad watch                       run the daemon (foreground)
#   stitchpad start|stop|status|restart   manage the daemon (background)
#   stitchpad health [--json] [--deep] [--strict]  non-mutating local health snapshot
#                                         --strict: exit 1 on error, 2 on warnings
#   stitchpad sessions [--json]           read-only session-registry projection
#   stitchpad telemetry [--json] [--model M] [--days N] [--limit N]   per-model reliability + cost-value summary
#   stitchpad invite [--name <handle>] [--ttl 1h|30m|7d|never]   make a remote-join invite
#   stitchpad invite --revoke <token>     revoke an invite token
#   stitchpad operator <keygen|env|grant|revoke|status>   operator credential (root of authority)
#   stitchpad keeper [repo ...]           wake idle Ocean seats for current open tasks
#   stitchpad archive [--keep N]          move old messages to .stitchpad/archive/<date>-conversation.md
#   stitchpad compact [--keep N]          archive old transcript to sqlite, replace with rolling summary
#   stitchpad task migrate                move legacy inline ```task blocks into tasks.md
#   stitchpad summarize [-n N]            LLM summary of the recent thread (read-only)
#   stitchpad search <query> [-n N]       full-history search: live pad + compaction archive
#   stitchpad shift-change --save <n> --file <f>   agent hands itself off to a fresh session
#   stitchpad log [-n N]                  show recent history (git log)
#   stitchpad reset [name] [--redeliver N] [--recovery-counters]   repair a wedged seat
#   stitchpad scope <set|show|check|clear|violations|clear-violation> ...   authority scope
#   stitchpad migration-check <name>      push-target reachability verifier
#   stitchpad color <name>|--all          collision-aware color assignment
#   stitchpad restore-roster <backup>     internal bridge recovery primitive
#   stitchpad doctor                      self-heal the daemon and heartbeat watchdog
#   stitchpad instructions [mode]         print the runtime-neutral prompt source
#   stitchpad prompt-context [mode]       prefix stdin with canonical rules exactly once
#   stitchpad bind-session                bind a terminal to the current pad
#   stitchpad hook                         internal bridge post-commit signal
#   stitchpad heal-roster                 repair a corrupt roster via operator credential
#   stitchpad reconcile                   backfill contributors missing from the roster
#   stitchpad lanes [--json]             per-seat status, artifact expected vs present, verdict
#   stitchpad pads [--scratch]            list pads; --scratch shows ephemeral ones
#   stitchpad evidence list|verify        list sealed artifacts / verify their sha256 sidecars
#   stitchpad spawn <name> --brief <t> --artifact <p>   delegate to a sub-agent under contract
#   stitchpad spawn --tree                show the delegation lineage and each seat's contract
#   stitchpad supervise <name>|--all [--max N]   re-prompt a seat whose artifact is
#                                         still missing; FAILED after N tries
#   stitchpad directive [text]            set/print the orchestrator standing order that
#                                         every spawned sub-agent inherits verbatim
#
# The roster lives INSIDE stitchpad.md as a ```roster fenced block. To add an agent
# from any runtime (pi/codex/cline/claude), drop an adapter in ~/.stitchpad/adapters
# and add one roster line — or connect via the stitchpad MCP server. That's the
# whole extension model.
set -uo pipefail
# Resolve our real dir even when invoked through a symlink (install puts a
# symlink on PATH; lib.sh sits next to the real script).
_src="${BASH_SOURCE[0]}"; while [ -h "$_src" ]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"; _src="$(readlink "$_src")"
  [ "${_src#/}" = "$_src" ] && _src="$_dir/$_src"
done
BIN_DIR="$(cd -P "$(dirname "$_src")" && pwd)"
source "$BIN_DIR/lib.sh"
source "$BIN_DIR/date-divider.sh"
source "$BIN_DIR/session-registry.sh"

cmd="${1:-help}"; shift || true

sp_autostart_name() {
  if [ -n "${STITCHPAD_NAME:-}" ]; then
    printf '%s\n' "$STITCHPAD_NAME"
    return 0
  fi
  if [ -n "${STITCHPAD_SESSION:-}" ] && [ -f "$PAD_STATE/sessions/$STITCHPAD_SESSION" ]; then
    cat "$PAD_STATE/sessions/$STITCHPAD_SESSION" 2>/dev/null
    return 0
  fi
  local surface
  surface="$(sp_this_surface)"
  if [ -n "$surface" ]; then
    sp_roster | awk -F'|' -v w="$surface" '
      { gsub(/^[ \t]+|[ \t]+$/, "", $1); gsub(/^[ \t]+|[ \t]+$/, "", $4)
        if ($4 == w) { print $1; exit } }'
  fi
}

sp_maybe_start_heartbeat() {
  [ "${STITCHPAD_HEARTBEAT_AUTOSTART:-1}" = "0" ] && return 0
  case "$cmd" in
    init|instructions|prompt-context|doctor|health|status|roster|who|lanes|sessions|read|heartbeat|hook|bind-session|whoami|leave|stop|daemon|watch|migration-check|reset|keeper|compact|restore-roster|scope|authority|color|operator|help|-h|--help) return 0 ;;
  esac
  sp_init_paths >/dev/null 2>&1 || return 0
  local who
  who="$(sp_autostart_name 2>/dev/null || true)"
  [ -n "$who" ] || return 0
  sp_user_exists "$who" || return 0
  STITCHPAD_HEARTBEAT_AUTOSTART=0 STITCHPAD_NAME="$who" \
    "$BIN_DIR/stitchpad" heartbeat start "$who" >/dev/null 2>&1 || true
}

sp_maybe_start_heartbeat

# P5: a deleted or corrupt pad git makes read commands print EMPTY results and exit 0 —
# indistinguishable from "nobody joined". That cost a full cycle and a near-misdiagnosis
# of a DESTROYED pad as a quiet one. Called explicitly from each READ command rather than
# from sp_init_paths: the shared-init version (4efb159) also refused journal/recovery
# paths that legitimately run on empty or not-yet-initialised git dirs, breaking a pillar
# suite plus websec, heal-roster and authority-redesign. Blast radius is part of the design.
sp_assert_pad_git_usable() {
  # Resolve paths if the caller has not yet — otherwise PAD_GIT is unset here and the
  # guard silently no-ops, which is the very "looks fine, does nothing" shape we are
  # eliminating.
  if [ -z "${PAD_GIT:-}" ]; then
    sp_init_paths_readonly >/dev/null 2>&1 || true
  fi
  if [ -z "${PAD_GIT:-}" ] && [ -n "${PAD_DIR:-}" ]; then
    if [ -d "$PAD_DIR/pasture-git" ]; then PAD_GIT="$PAD_DIR/pasture-git"
    else PAD_GIT="$PAD_DIR/stitchpad-git"; fi
  fi
  [ -n "${PAD_GIT:-}" ] || return 0
  # DESTROYED vs BARE — these are different states and deserve different answers.
  #   BARE:      a stitchpad.md that was never initialised (no .state, no git). Read-only
  #              commands must stay harmless here (test-health-readonly asserts they
  #              neither crash nor create .state/git). Nothing was lost; say nothing.
  #   DESTROYED: the pad was operated on (.state exists) but its git history is GONE.
  #              THAT is the incident that cost a full cycle — roster printed zero rows
  #              and exited 0, and a destroyed pad read as an idle fleet. Refuse loudly.
  if [ ! -d "$PAD_GIT" ] && [ ! -d "${PAD_STATE:-$PAD_DIR/.state}" ]; then
    return 0
  fi
  if [ ! -d "$PAD_GIT" ]; then
    echo "stitchpad: pad git is missing — this pad is broken, not empty" >&2
    echo "  expected history at: $PAD_GIT" >&2
    echo "  an empty result here means the PAD is gone, not that nobody joined" >&2
    echo "  recover:  cd $(dirname "${PAD_DIR:-.}") && stitchpad init --name <name>" >&2
    return 1
  fi
  # An empty or unreadable git dir cannot answer a READ command — roster/whoami/doctor
  # would print nothing and exit 0, which is the bug. Refuse here.
  # NOTE: this helper is called ONLY from read commands. journal_begin and the recovery
  # paths still accept an empty git dir via the "unborn" sentinel — that distinction is
  # exactly why this guard is not in sp_init_paths (see 4efb159, which broke a pillar).
  if ! git --git-dir="$PAD_GIT" rev-parse --git-dir >/dev/null 2>&1; then
    echo "stitchpad: pad git is corrupt — cannot read history at $PAD_GIT" >&2
    echo "  the repository is present but unreadable (corrupt HEAD or config)" >&2
    echo "  recover:  restore from backup, or re-init with 'stitchpad init --name <name>'" >&2
    return 1
  fi
  return 0
}

case "$cmd" in
  instructions)
    # Runtime-neutral prompt source. Adapters call this rather than vendoring
    # their own copies. Optional positional mode is useful to tests and hosts.
    [ -n "${1:-}" ] && export STITCHPAD_PONYTAIL_MODE="$1"
    sp_ponytail_instructions
    ;;

  prompt-context)
    # Prefix stdin with the canonical rules exactly once. This is intentionally
    # pad-independent so session-start, handoff, MCP, and daemon adapters share it.
    [ -n "${1:-}" ] && export STITCHPAD_PONYTAIL_MODE="$1"
    sp_prompt_with_ponytail
    ;;

  init)
    # F-INIT: `init` used to IGNORE a positional path argument entirely and always
    # create the pad in $PWD/.stitchpad — reporting success while the caller's
    # requested directory got nothing.
    _init_root="$PWD"
    _init_scratch=0; _init_force=0
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --name) name="$2"; shift 2 ;;
        --scratch) _init_scratch=1; shift ;;
        --force) _init_force=1; shift ;;
        -*)
          echo "stitchpad: init: unknown option '$1'" >&2
          exit 2 ;;
        *)
          case "$1" in
            */.stitchpad)  _init_root="$(dirname "$1")" ;;
            */*)           _init_root="$1" ;;
            *)
              if [ -d "$1" ]; then _init_root="$1"; else name="$1"; fi ;;
          esac
          shift ;;
      esac
    done
    # P18: pad created inside a git WORKTREE of another repo must not register
    # as a channel. Detection: a worktree has `.git` as a FILE (not a directory).
    # A genuine project checkout has `.git/` (a directory). A worktree pad
    # requires --scratch (explicit) or --force (operator override). Only a real
    # project checkout or --scratch/--force gets past this gate.
    _init_is_worktree=0
    if [ -f "$_init_root/.git" ]; then
      _init_is_worktree=1
    elif git -C "$_init_root" rev-parse --git-dir >/dev/null 2>&1; then
      # .git is a dir but it might still be a linked worktree (some git versions)
      _gd="$(git -C "$_init_root" rev-parse --git-common-dir 2>/dev/null || echo "")"
      [ -n "$_gd" ] && [ -d "$_gd/worktrees" ] && _init_is_worktree=1
    fi
    if [ "$_init_is_worktree" -eq 1 ] && [ "$_init_scratch" -eq 0 ] && [ "$_init_force" -eq 0 ]; then
      echo "stitchpad: $_init_root is inside a git worktree — scratch pads do NOT become channels" >&2
      echo "stitchpad: use --scratch for an ephemeral pad, or --force to override and create a channel" >&2
      exit 1
    fi
    # In a worktree, default to scratch unless --force (operator decides)
    if [ "$_init_is_worktree" -eq 1 ] && [ "$_init_force" -eq 0 ]; then
      _init_scratch=1
    fi
    mkdir -p "$_init_root" 2>/dev/null || {
      echo "stitchpad: init: cannot create '$_init_root'" >&2; exit 1; }
    _init_root="$(cd -P "$_init_root" 2>/dev/null && pwd)" || {
      echo "stitchpad: init: unusable directory" >&2; exit 1; }
    [ -n "${name:-}" ] || name="$(basename "$_init_root")"
    dir="$_init_root/.stitchpad"; mkdir -p "$dir/.state"
    md="$dir/stitchpad.md"
    if [ -f "$md" ]; then echo "stitchpad already exists: $md"; exit 0; fi
    cat > "$md" <<EOF
# 🧵 #$name — agent stitchpad

> A model-agnostic channel that's just this markdown file. Any agent (pi, codex,
> cline, claude, …) joins by adding a line to the roster block below — or by
> connecting the stitchpad MCP server. Address someone by starting a line with
> @their-name. The watcher wakes them.

\`\`\`roster
# name | adapter | wake(push|pull) | target
\`\`\`

## Tasks

\`\`\`task TASK-1
# key:value per-ticket block. Status: backlog|todo|in_progress|in_review|done|canceled
# Priority: none|low|medium|high|urgent. Assignee is a bare roster name.
title: example task
created: 06-17 00:00
status: todo
priority: none
assignee:
labels:
---
Example description body. Multi-line is fine.
\`\`\`

---
EOF
    # isolated git for the pad
    # fx4 F2: git absent from PATH makes init report false success.
    # Fail loudly before touching any files.
    command -v git >/dev/null 2>&1 || { echo "stitchpad: git not found on PATH — stichpad requires git for durable pad history" >&2; exit 1; }
    # FALSE SUCCESS (found by @pro2's false-success-gate under a read-only stitchpad-git):
    # these git calls were unchecked, so init wrote the markdown, silently failed to
    # create any history, and still printed "✓ stitchpad created". A pad with no
    # isolated git is NOT a pad — sp_find_pad will not recognise it and every later
    # command answers "no pasture found". Fail here, loudly, instead of handing back
    # a pad-shaped directory that cannot work.
    _init_git_fail() {
      echo "stitchpad: cannot create pad history in $dir/stitchpad-git — $1" >&2
      echo "stitchpad: pad NOT created (removing partial files)" >&2
      rm -f "$md" 2>/dev/null || true
      exit 1
    }
    git --git-dir="$dir/stitchpad-git" --work-tree="$dir" init -q \
      || _init_git_fail "git init failed (permissions?)"
    git --git-dir="$dir/stitchpad-git" --work-tree="$dir" config user.name "stitchpad" \
      || _init_git_fail "git config failed"
    git --git-dir="$dir/stitchpad-git" --work-tree="$dir" config user.email "stitchpad@agents.local" \
      || _init_git_fail "git config failed"
    # pad content that is versioned alongside the conversation: the task board
    # (tasks.md) and archived transcripts (archive/). Everything else is runtime.
    printf '*\n!stitchpad.md\n!tasks.md\n!archive/\n!archive/**\n' > "$dir/stitchpad-git/info/exclude"
    git --git-dir="$dir/stitchpad-git" --work-tree="$dir" add stitchpad.md \
      || _init_git_fail "git add failed"
    git --git-dir="$dir/stitchpad-git" --work-tree="$dir" commit -q -m "stitchpad created" \
      || _init_git_fail "initial commit failed"
    # Post-condition: the pad must now be discoverable and have real history.
    git --git-dir="$dir/stitchpad-git" rev-parse HEAD >/dev/null 2>&1 \
      || _init_git_fail "no HEAD after initial commit"
    # The entire pad is runtime state with its own isolated Git history. Ignore
    # it from the outer repo so `git stash -u` / `git clean` cannot temporarily
    # remove stitchpad.md while agents and the bridge are still writing.
    if [ -f "$_init_root/.gitignore" ]; then
      grep -Fqx '.stitchpad/' "$_init_root/.gitignore" 2>/dev/null || printf '\n# stitchpad runtime (isolated history)\n.stitchpad/\n' >> "$_init_root/.gitignore"
    fi
    PAD_DIR="$dir"; sp_ensure_outer_git_ignore; unset PAD_DIR
    # P18: scratch pads carry a sentinel so pad discovery (bridge, pasture,
    # `stitchpad pads`) can exclude them. An agent scratch tree is NOT a channel.
    if [ "$_init_scratch" -eq 1 ]; then
      touch "$dir/.scratch"
      echo "✓ scratch pad #$name created at $md (NOT a channel — excluded from pad listings)"
    else
      echo "✓ stitchpad #$name created at $md"
    fi
    # Self-sufficient from creation: start this pad's wake watcher now so it's live
    # the moment it exists (pinned to this pad regardless of cwd). join also ensures
    # it; this just means a fresh pad is ready before the first agent even joins.
    # FALSE SUCCESS (found by @pro2's false-success-gate under a read-only pad git):
    # ensure_watcher returns 0 for "nothing to do" as well as "started" — it is not a
    # post-condition. Claiming "✓ wake watcher started" off that return printed a
    # success for a watcher that was never running. Verify liveness before claiming,
    # and say plainly when there is no watcher rather than inventing one.
    STITCHPAD_PAD_DIR="$dir" ensure_watcher 2>/dev/null || true
    if STITCHPAD_PAD_DIR="$dir" sp_watcher_alive 2>/dev/null; then
      echo "✓ wake watcher started for #$name"
    else
      echo "stitchpad: no wake watcher running for #$name (start one with 'stitchpad watch')" >&2
    fi
    ;;

  pads)
    # P18: list discoverable pads. By default shows only full channels
    # (non-scratch pads).  --scratch lists ephemeral pads only.
    # --prune deletes scratch pads after listing them.
    # P26: --forget <name> unregisters an orphaned channel from the relay.
    #   stitchpad pads            list channel pads
    #   stitchpad pads --scratch  list ephemeral/scratch pads
    #   stitchpad pads --prune    remove scratch pads
    #   stitchpad pads --all      list every pad
    #   stitchpad pads --forget <name>  remove orphan channel from relay
    _pads_scratch=0; _pads_prune=0; _pads_all=0; _pads_forget=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --scratch) _pads_scratch=1; shift ;;
        --prune)   _pads_prune=1; shift ;;
        --all)     _pads_all=1; shift ;;
        --forget)  _pads_forget="$2"; shift 2 ;;
        *) echo "stitchpad: pads: unknown option '$1'" >&2; exit 2 ;;
      esac
    done
    # P26: --forget calls the relay DELETE endpoint
    if [ -n "$_pads_forget" ]; then
      _forget_name="$_pads_forget"
      _forget_relay="${STITCHPAD_RELAY:-}"
      _forget_token="${STITCHPAD_TOKEN:-}"
      if [ -z "$_forget_relay" ] || [ -z "$_forget_token" ]; then
        echo "stitchpad: pads --forget needs STITCHPAD_RELAY + STITCHPAD_TOKEN in the environment" >&2
        exit 1
      fi
      if curl -fsS -X DELETE -H "authorization: Bearer $_forget_token" \
        "$_forget_relay/pads?pad=$_forget_name" >/dev/null 2>&1; then
        echo "✓ forgot #$_forget_name — channel removed from relay"
      else
        echo "stitchpad: could not unregister #$_forget_name from relay (check STITCHPAD_RELAY + token)" >&2
        exit 1
      fi
      exit 0
    fi
    # --prune implies --scratch: only scratch pads are prunable
    [ "$_pads_prune" -eq 1 ] && _pads_scratch=1
    _pads_roots="${STITCHPAD_SCAN_ROOTS:-$HOME}"
    _pads_found=0
    for _r in $_pads_roots; do
      [ -d "$_r" ] || continue
      while IFS= read -r _pd; do
        [ -d "$_pd" ] || continue
        [ -f "$_pd/stitchpad.md" ] || { [ -f "$_pd/pasture.md" ] || continue; }
        _pn="$(basename "$(dirname "$_pd")")"
        _is_scratch=0; [ -f "$_pd/.scratch" ] && _is_scratch=1
        # Filter by mode
        if [ "$_pads_all" -eq 0 ]; then
          if [ "$_pads_scratch" -eq 1 ] && [ "$_is_scratch" -eq 0 ]; then continue; fi
          if [ "$_pads_scratch" -eq 0 ] && [ "$_is_scratch" -eq 1 ]; then continue; fi
        fi
        if [ "$_pads_prune" -eq 1 ]; then
          if [ "$_is_scratch" -eq 1 ]; then
            printf 'PRUNE scratch: %-30s %s\n' "#$_pn" "$(dirname "$_pd")"
            rm -rf "$_pd" 2>/dev/null && _pads_found=$((_pads_found + 1))
          fi
          continue
        fi
        _pads_found=$((_pads_found + 1))
        if [ "$_is_scratch" -eq 1 ]; then
          printf '%-5s %-30s %s\n' '[scr]' "#$_pn" "$(dirname "$_pd")"
        else
          printf '%-5s %-30s %s\n' '[ch]'  "#$_pn" "$(dirname "$_pd")"
        fi
      # DEPTH (k3 F12). This was a bare `-maxdepth 4`, so a pad any deeper than
      # four levels under the search root was invisible — including, on a real
      # layout, the pad the operator was standing in. A missing pad renders
      # identically to "no pads", which is the same silhouette as P5's destroyed
      # pad, so the listing built for P18/P26 was incomplete by construction and
      # said nothing about it.
      # Depth is raised and made overridable. The cost of going deeper is walking
      # big trees, so the known-heavy directories are PRUNED rather than the depth
      # being kept artificially short: pruning .git/node_modules/target keeps this
      # fast on exactly the repos that made a shallow limit tempting.
      done < <(find "$_r" -maxdepth "${STITCHPAD_PADS_MAXDEPTH:-8}" \
                 \( -name .git -o -name node_modules -o -name target \
                    -o -name Library -o -name .Trash -o -name .cache \) -prune -o \
                 -type d \( -name .stitchpad -o -name .pasture \) -print 2>/dev/null \
               | grep -v '/\.stitchpad/\.stitchpad' | sort -u)
    done
    if [ "$_pads_prune" -eq 1 ]; then
      echo "✓ pruned $_pads_found scratch pad(s)"
    elif [ "$_pads_found" -eq 0 ]; then
      echo "(no pads found)"
    fi
    ;;

  restore-roster)
    # Internal bridge recovery primitive. Restore a saved roster under the same
    # mutation lock as say/join and re-check after locking, so two repairers can
    # never prepend duplicate headers or overwrite a concurrent message.
    sp_init_paths || exit 1
    backup="${1:?usage: stitchpad restore-roster <roster-backup-file>}"
    [ -f "$backup" ] || { echo "stitchpad: roster backup not found: $backup" >&2; exit 1; }
    grep -q '^```roster[[:space:]]*$' "$backup" 2>/dev/null \
      || { echo "stitchpad: invalid roster backup" >&2; exit 1; }
    sp_lock || exit 1
    if [ -f "$PAD_MD" ] && grep -q '^```roster[[:space:]]*$' "$PAD_MD" 2>/dev/null; then
      sp_unlock
      echo "stitchpad: roster already present"
      exit 0
    fi
    body="$(mktemp)"; tmp="$(sp_stage "$PAD_MD")"
    [ -f "$PAD_MD" ] && cat "$PAD_MD" > "$body"
    {
      printf -- '# 🧵 #%s — agent stitchpad\n\n' "$(basename "$(dirname "$PAD_DIR")")"
      cat "$backup"
      printf '\n\n---\n\n'
      cat "$body"
    } > "$tmp"
    sp_write_inplace "$tmp" "$PAD_MD"
    rm -f "$body"
    if ! sp_commit_or_fail "repair: restore missing roster header"; then
      sp_unlock
      echo "stitchpad: restore-roster commit failed — roster may not be durable; message NOT posted" >&2
      exit 1
    fi
    sp_unlock
    echo "✓ roster restored from $backup"
    ;;

  reconcile)
    # V1-backfill: scan pad-git commit authors and register any not yet in
    # the roster as cli|pull|-.  Idempotent — running it twice adds nothing
    # on the second pass.  Heals agents like @km2 and @fx3 that shipped
    # commits before the V1 auto-register gate was installed.
    # Git authors may carry display-name suffixes (e.g. "fx3 (deepseek-v4-flash)")
    # — extract the first word as the roster key when a full-name match fails.
    #   stitchpad reconcile [--dry-run]
    sp_init_paths || exit 1
    _rec_dry=0; [ "${1:-}" = "--dry-run" ] && _rec_dry=1
    if [ ! -d "$PAD_GIT" ] || ! sgit rev-parse --git-dir >/dev/null 2>&1; then
      echo "stitchpad: no pad git history — nothing to reconcile" >&2
      exit 0
    fi
    _rec_authors="$(sgit log --format='%an' 2>/dev/null | grep -vx 'stitchpad' | sort -u || true)"
    [ -n "$_rec_authors" ] || { echo "stitchpad: no non-bootstrap git authors found — nothing to reconcile" >&2; exit 0; }
    _rec_added=""
    while IFS= read -r _ra; do
      [ -z "$_ra" ] && continue
      # Try full name match first, then first-word extraction for display-name
      # authors like "fx3 (deepseek-v4-flash)".
      _rec_key="$_ra"
      if ! sp_user_exists "$_rec_key" 2>/dev/null; then
        _rec_key="${_ra%% *}"  # first space-delimited word
      fi
      [ -n "$_rec_key" ] && ! sp_user_exists "$_rec_key" 2>/dev/null || continue
      case "$_rec_key" in *[!abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-]*) continue ;; esac
      _rec_added="${_rec_added:+$_rec_added }$_rec_key"
    done <<< "$_rec_authors"
    if [ -z "$_rec_added" ]; then
      echo "stitchpad: all git authors already in roster — nothing to reconcile"
      exit 0
    fi
    if [ "$_rec_dry" -eq 1 ]; then
      echo "stitchpad: would reconcile: $_rec_added"
      exit 0
    fi
    sp_lock || exit 1
    _rec_registered=""
    for _rn in $_rec_added; do
      if sp_user_exists "$_rn" 2>/dev/null; then continue; fi
      _rec_tmp="$(sp_stage "$PAD_MD")"
      awk -v line="$_rn | cli | pull | -" '
        /^```roster/ { inblk=1; print; next }
        inblk && /^```/ { print line; inblk=0; print; next }
        { print }
      ' "$PAD_MD" > "$_rec_tmp" && sp_write_inplace "$_rec_tmp" "$PAD_MD"
      _rec_registered="${_rec_registered:+$_rec_registered }$_rn"
    done
    if [ -n "$_rec_registered" ]; then
      if sp_commit "reconcile: + $_rec_registered"; then
        echo "✓ reconciled: $_rec_registered"
      else
        echo "stitchpad: reconcile commit failed — roster may be dirty" >&2
        sp_unlock; exit 1
      fi
    fi
    sp_unlock
    ;;

  heal-roster)
    # Recover the roster from pad git history when the fence is missing or
    # empty. Walk HEAD history in reverse chronological order, find the first
    # commit whose stitchpad.md blob contains a valid ```roster``` fence WITH
    # at least one member, extract it, and prepend it to the pad under the
    # mutation lock. Refuse LOUDLY if no historic roster exists (never guess).
    # Post-condition: after this command exits 0, the pad has a valid roster
    # fence with members and the commit is durable.
    sp_init_paths || exit 1
    if [ -f "$PAD_MD" ] && grep -q '^```roster[[:space:]]*$' "$PAD_MD" 2>/dev/null; then
      _count="$(sp_roster_members_count "$PAD_MD")"
      if [ "$_count" -gt 0 ]; then
        # deepseek F6: a populated roster is not necessarily a HEALTHY one. A
        # repeated name is never legitimate — join refuses one — so it arrived by
        # hand edit, bridge write or merge, and it makes every consumer disagree
        # about the seat: sp_wake_mode_for read one row, the watcher dispatched
        # another. This command is the natural home for the repair, and until now
        # it answered "nothing to heal" on exactly the roster that needed it.
        _dupes="$(sp_roster_dupes)"
        if [ -n "$_dupes" ]; then
          sp_lock || exit 1
          _tmp="$(sp_stage "$PAD_MD")"
          # Keep ONE row per name: the push row when the name has one (the mode
          # with delivery consequences), else the first. Order of first
          # appearance is preserved so the board does not reshuffle.
          python3 - "$PAD_MD" > "$_tmp" <<'PY' || { rm -f "$_tmp"; sp_unlock; echo "stitchpad: heal-roster could not rewrite the roster — nothing changed" >&2; exit 1; }
import re, sys
lines = open(sys.argv[1], encoding='utf-8').read().split('\n')
out, inblk, rows, order = [], False, {}, []
def key(l):
    return re.split(r'\s*\|\s*', l.strip())[0].lower()
def wake_of(l):
    f = re.split(r'\s*\|\s*', l.strip())
    if len(f) >= 5 and f[2] not in ('push', 'pull'):
        return f[3]
    return f[2] if len(f) >= 3 else 'pull'
for l in lines:
    if not inblk and re.match(r'^```roster\s*$', l):
        inblk = True; out.append(l); continue
    if inblk and re.match(r'^```\s*$', l):
        for k in order:
            out.append(rows[k])
        out.append(l); inblk = False; continue
    if inblk:
        s = l.strip()
        if s == '' or s.startswith('#') or '|' not in s:
            out.append(l); continue
        k = key(l)
        if k not in rows:
            rows[k] = l; order.append(k)
        elif wake_of(l) == 'push' and wake_of(rows[k]) != 'push':
            rows[k] = l           # the push row wins
        continue
    out.append(l)
sys.stdout.write('\n'.join(out))
PY
          _wr=0; sp_write_inplace "$_tmp" "$PAD_MD" || _wr=$?
          if [ "$_wr" -ne 0 ]; then
            sp_unlock
            echo "stitchpad: heal-roster could not write the repaired roster (rc=$_wr) — nothing changed" >&2
            exit 1
          fi
          _pre_dup="$(sp_commit_count)"
          sp_commit_or_fail "repair: heal-roster collapsed duplicate roster rows ($(printf '%s' "$_dupes" | tr '\n' ' '))" || {
            sp_unlock
            echo "stitchpad: heal-roster dedupe NOT recorded — the commit did not land" >&2
            exit 1; }
          sp_unlock
          _left="$(sp_roster_dupes)"
          if [ -n "$_left" ]; then
            echo "stitchpad: heal-roster ran but these names still have duplicate rows: $(printf '%s' "$_left" | tr '\n' ' ')" >&2
            exit 1
          fi
          echo "✓ roster repaired: collapsed duplicate rows for $(printf '%s' "$_dupes" | tr '\n' ' ')(kept the push row where one existed)"
          exit 0
        fi
        echo "stitchpad: roster already present with $_count members — nothing to heal" >&2
        exit 0
      fi
    fi
    [ -d "$PAD_GIT" ] || { echo "stitchpad: no pad git history — cannot heal roster" >&2; exit 1; }
    # Walk pad git history in reverse chronological order. For each commit,
    # extract stitchpad.md and check for a populated roster fence. The FIRST
    # hit (newest) is the best candidate — the most recent known-good roster.
    _heal_candidate=""
    _heal_roster_text=""
    _heal_members=0
    while IFS= read -r _hc; do
      [ -n "$_hc" ] || continue
      _blob_text="$(git --git-dir="$PAD_GIT" show "$_hc:stitchpad.md" 2>/dev/null || true)"
      [ -n "$_blob_text" ] || continue
      if ! printf '%s' "$_blob_text" | grep -q '^```roster[[:space:]]*$'; then
        continue
      fi
      _member_count="$(printf '%s' "$_blob_text" | awk '
        /^```roster/ { inblk=1; next }
        /^```/ && inblk { inblk=0 }
        inblk && $0 !~ /^[[:space:]]*#/ && $0 !~ /^[[:space:]]*$/ {
          n=split($0,f,/[[:space:]]*\|[[:space:]]*/); if(n>=2) c++
        }
        END { print c+0 }
      ')"
      if [ "$_member_count" -gt 0 ]; then
        _heal_candidate="$_hc"
        _heal_members="$_member_count"
        _heal_roster_text="$(printf '%s' "$_blob_text" | awk '
          /^```roster/ { inblk=1; print; next }
          /^```/ && inblk { print; inblk=0; exit }
          inblk { print }
        ')"
        break
      fi
    done < <(git --git-dir="$PAD_GIT" log --format='%H' -- stitchpad.md 2>/dev/null || true)
    [ -n "$_heal_roster_text" ] || {
      echo "stitchpad: no historic roster with members found in pad git — cannot heal; re-init or restore-roster from a backup" >&2
      exit 1
    }
    sp_lock || exit 1
    # Revalidate under lock (concurrent heal could have won)
    if [ -f "$PAD_MD" ] && grep -q '^```roster[[:space:]]*$' "$PAD_MD" 2>/dev/null; then
      _count2="$(sp_roster_members_count "$PAD_MD")"
      if [ "$_count2" -gt 0 ]; then
        sp_unlock
        echo "stitchpad: roster already present with $_count2 members (concurrent heal won)"
        exit 0
      fi
    fi
    _body="$(mktemp)"; _tmp="$(sp_stage "$PAD_MD")"
    [ -f "$PAD_MD" ] && cat "$PAD_MD" > "$_body"
    {
      printf -- '# 🧵 #%s — agent stitchpad\n\n' "$(basename "$(dirname "$PAD_DIR")")"
      printf -- '%s\n\n' "$_heal_roster_text"
      printf -- '---\n\n'
      cat "$_body"
    } > "$_tmp"
    sp_write_inplace "$_tmp" "$PAD_MD"
    rm -f "$_body"
    _pre_commit="$(sp_commit_count)"
    sp_commit "repair: heal-roster recovered $_heal_members member(s) from $_heal_candidate" || {
      sp_unlock
      echo "stitchpad: heal-roster commit failed — pad may be dirty" >&2
      exit 1
    }
    sp_verify_commit_landed "$_pre_commit" || {
      sp_unlock
      echo "stitchpad: heal-roster commit did not land — refusing to report success" >&2
      exit 1
    }
    sp_unlock
    echo "✓ roster healed from commit ${_heal_candidate:0:7} ($_heal_members member(s))"
    ;;

  directive)
    # `stitchpad directive "<text>"` — set the orchestrator's standing request.
    # `stitchpad directive` — print it. Every spawn at every depth inherits this
    # text VERBATIM, which is what keeps a depth-3 sub-agent answering to the
    # operator rather than to its parent's summary of the operator.
    sp_init_paths || exit 1
    if [ $# -ge 1 ]; then
      sp_directive_set "$*" || exit 1
      echo "✓ orchestrator directive set — every spawned sub-agent will inherit it verbatim"
    else
      _d="$(sp_directive)"
      if [ -n "$_d" ]; then printf '%s\n' "$_d"
      else echo "stitchpad: no orchestrator directive set (stitchpad directive \"<text>\")" >&2; exit 1; fi
    fi
    ;;

  supervise)
    # stitchpad supervise <name> [--max N]   |   stitchpad supervise --all [--max N]
    #
    # Closes the loop a one-shot dispatch leaves open. For each supervised seat:
    #   artifact produced        -> DONE, contract and strikes cleared
    #   artifact missing/empty   -> post a CONTINUATION mention and record a strike
    #   strikes exhausted        -> FAILED, said out loud on the pad, no more wakes
    #
    # The continuation deliberately says "continue, do not start over": a re-woken
    # agent that restarts rewrites its stub every round and the loop never
    # converges. Delivery goes through the ordinary mention path — the one proven
    # to reach a push seat — never through `wake`, which would print here and burn
    # the seat's cursor without delivering (P43).
    sp_init_paths || exit 1
    _sv_max=3; _sv_all=0; _sv_name=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --all) _sv_all=1; shift ;;
        --max) _sv_max="${2:-3}"; shift 2 ;;
        -*) echo "stitchpad: unknown option '$1' for supervise" >&2; exit 2 ;;
        *) [ -z "$_sv_name" ] && _sv_name="$1"; shift ;;
      esac
    done
    case "$_sv_max" in ''|*[!0-9]*) echo "stitchpad: --max must be a non-negative integer" >&2; exit 2 ;; esac
    _sv_me="$(sp_me 2>/dev/null || true)"; [ -n "$_sv_me" ] || _sv_me="${STITCHPAD_NAME:-supervisor}"

    _sv_targets=""
    if [ "$_sv_all" -eq 1 ]; then
      for _f in "$PAD_STATE"/artifact-expect.*; do
        [ -f "$_f" ] || continue
        _n="${_f##*/artifact-expect.}"; _sv_targets="$_sv_targets$_n
"
      done
    else
      [ -n "$_sv_name" ] || { echo "stitchpad: usage: stitchpad supervise <name> [--max N]  |  stitchpad supervise --all" >&2; exit 2; }
      _sv_targets="$_sv_name
"
    fi
    [ -n "$_sv_targets" ] || { echo "no seats under contract"; exit 0; }

    _sv_rc=0
    printf '%s' "$_sv_targets" | while IFS= read -r _seat; do
      [ -n "$_seat" ] || continue
      if [ ! -f "$PAD_STATE/artifact-expect.$_seat" ]; then
        echo "@$_seat: no artifact contract — nothing to supervise"
        continue
      fi
      if sp_artifact_verify "$_seat" 2>/dev/null; then
        echo "✓ @$_seat DONE — $(sp_artifact_expected "$_seat" | tr '\n' ' ')"
        sp_supervise_clear "$_seat"
        sp_artifact_clear "$_seat"
        continue
      fi
      _n="$(sp_supervise_strikes "$_seat")"
      if [ "$_n" -ge "$_sv_max" ]; then
        echo "✗ @$_seat FAILED — $_n continuations, artifact still not produced" >&2
        STITCHPAD_NAME="$_sv_me" "$BIN_DIR/stitchpad" say \
          "@$_seat is FAILED after $_n continuations — still nothing at: $(sp_artifact_expected "$_seat" | tr '\n' ' ')" \
          >/dev/null 2>&1 || true
        continue
      fi
      _n="$(sp_supervise_strike_add "$_seat")"
      STITCHPAD_NAME="$_sv_me" "$BIN_DIR/stitchpad" say "@$_seat your turn ended but your artifact is still missing or empty:
$(sp_artifact_expected "$_seat" | sed 's/^/  · /')

CONTINUE from where you stopped — do NOT start over and do NOT rewrite the file
from scratch. Append what you have completed so far, then keep going. If you
genuinely cannot produce it, say so on the pad and say WHY; silence is scored
FAILED. (continuation $_n of $_sv_max)" >/dev/null 2>&1 \
        || { echo "stitchpad: could not post continuation for @$_seat" >&2; }
      echo "→ @$_seat continued ($_n/$_sv_max) — artifact still missing"
    done
    exit "$_sv_rc"
    ;;

  spawn)
    # stitchpad spawn <child> --brief <text> --artifact <path> [--artifact <path>]...
    #                         [--model <m>] [--role <r>] [--adapter <a>]
    # stitchpad spawn --tree
    #
    # Delegation with a contract. An agent that needs help creates a sub-agent
    # itself instead of stalling until a human notices — but it cannot create one
    # that is unscoreable or unattributable. Every refusal below names the fix,
    # because a refusal an agent cannot act on is just a different kind of stall.
    #
    # DISPATCH REUSES `say`. That is deliberate and load-bearing: the mention →
    # watcher → fire_adapter path is the one PROVEN to deliver. `stitchpad wake`
    # on a push seat renders, advances seen.<name>, and delivers NOTHING — this
    # command must never grow a second, private dispatch path with its own bugs.
    # NOTE: the dispatcher above already did `cmd="$1"; shift`, so $1 is the
    # child name here. Do not shift again — that silently ate the name and made
    # every flag parse as a stray positional (caught by this command's own gate).
    sp_init_paths || exit 1
    if [ "${1:-}" = "--tree" ]; then sp_spawn_tree; exit 0; fi
    _child="${1:-}"; shift || true
    [ -n "$_child" ] || { echo "stitchpad: usage: stitchpad spawn <name> --brief <text> --artifact <path> [--model <m>]" >&2; exit 1; }
    case "$_child" in *[!abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-]*)
      echo "stitchpad: bad name '$_child' (allowed: a-z 0-9 _ -)" >&2; exit 1;; esac

    _brief=""; _model=""; _role=""; _adapter="ocean"; _arts=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --brief)    _brief="${2:-}"; shift 2 ;;
        --artifact) [ -n "${2:-}" ] || { echo "stitchpad: --artifact needs a path" >&2; exit 1; }
                    _arts="$_arts$2
"; shift 2 ;;
        --model)    _model="${2:-}"; shift 2 ;;
        --role)     _role="${2:-}";  shift 2 ;;
        --adapter)  _adapter="${2:-ocean}"; shift 2 ;;
        *) echo "stitchpad: unknown option '$1' for spawn" >&2; exit 1 ;;
      esac
    done

    # The spawning agent must have an identity. An anonymous spawn produces a seat
    # whose silence can never be attributed to anyone.
    _parent="$(sp_me 2>/dev/null || true)"
    [ -n "$_parent" ] || _parent="${STITCHPAD_NAME:-}"
    [ -n "$_parent" ] || { echo "stitchpad: spawn refused — you have no identity on this pad, so nothing could be held accountable for @$_child. Join first (stitchpad join <you>), or export STITCHPAD_NAME." >&2; exit 1; }

    [ -n "$_brief" ] || { echo "stitchpad: spawn refused — --brief is required. A sub-agent woken without a task reads the pad, finds nothing addressed to it, and idles." >&2; exit 1; }

    # THE ARTIFACT CONTRACT IS MANDATORY. This is the whole point: the most
    # expensive defect of this build was a seat that produced nothing being
    # indistinguishable from a seat that was working. A spawn with no declared
    # artifact recreates that defect one level down.
    [ -n "$_arts" ] || { echo "stitchpad: spawn refused — --artifact is required. Name the file @$_child must produce; without it a silent seat and a working seat look identical on the board." >&2; exit 1; }

    if sp_user_exists "$_child"; then
      echo "stitchpad: spawn refused — @$_child is already in the roster. Pick another name, or address the existing seat with: stitchpad say \"@$_child ...\"" >&2; exit 1
    fi

    # Bounded delegation. An agent that can spawn agents can spawn a fork bomb,
    # and this fleet runs on the operator's laptop.
    if sp_spawn_is_ancestor "$_child" "$_parent"; then
      echo "stitchpad: spawn refused — @$_child is an ancestor of @$_parent; that would make a delegation cycle." >&2; exit 1
    fi
    _depth="$(sp_spawn_depth "$_parent")"
    if [ "$((_depth + 1))" -gt "$STITCHPAD_SPAWN_MAX_DEPTH" ]; then
      echo "stitchpad: spawn refused — @$_parent is at depth $_depth; spawning would exceed STITCHPAD_SPAWN_MAX_DEPTH=$STITCHPAD_SPAWN_MAX_DEPTH. Do the work here, or ask your parent @$(sp_spawn_parent "$_parent") to widen the tree instead of deepening it." >&2; exit 1
    fi
    _kids="$(sp_spawn_children "$_parent" | grep -c . || true)"
    if [ "$_kids" -ge "$STITCHPAD_SPAWN_MAX_CHILDREN" ]; then
      echo "stitchpad: spawn refused — @$_parent already has $_kids sub-agents (limit $STITCHPAD_SPAWN_MAX_CHILDREN). Wait for one to deliver its artifact, then spawn again." >&2; exit 1
    fi

    # Roster row via the real join arm — never a private roster writer.
    if [ -n "$_model" ]; then _adapter="$_adapter"; fi
    _joinargs="$_child $_adapter push -"
    if ! STITCHPAD_NAME="$_child" "$BIN_DIR/stitchpad" join $_joinargs ${_role:+--role "$_role"} >/dev/null 2>&1; then
      echo "stitchpad: spawn failed — could not add @$_child to the roster" >&2; exit 1
    fi
    [ -n "$_model" ] && printf '%s' "$_model" > "$PAD_STATE/model.$_child" 2>/dev/null || true

    # Contract + lineage BEFORE the wake, so the board is honest from the instant
    # the sub-agent exists. Declaring after dispatch leaves a window where the
    # seat is running with no expectation recorded against it.
    _oldifs="$IFS"; IFS='
'
    set -f; sp_artifact_declare "$_child" $_arts || { IFS="$_oldifs"; set +f; echo "stitchpad: spawn failed — artifact contract not recorded" >&2; exit 1; }
    set +f; IFS="$_oldifs"
    sp_spawn_record "$_child" "$_parent" "$_brief" || { echo "stitchpad: spawn failed — lineage not recorded" >&2; exit 1; }

    # The brief. The orchestrator's directive goes FIRST and verbatim, because a
    # sub-agent must be able to tell what the operator asked for apart from what
    # its parent inferred.
    _msg="@$_child you were spawned by @$_parent (depth $((_depth + 1)))."
    _dir="$(sp_directive)"
    [ -n "$_dir" ] && _msg="$_msg

STANDING ORDER FROM THE ORCHESTRATOR — this outranks your parent's brief; if the two conflict, follow this and say so on the pad:
$_dir"
    _msg="$_msg

YOUR TASK (from @$_parent):
$_brief

ARTIFACT CONTRACT — you are scored on these paths existing when your turn ends:
$(printf '%s' "$_arts" | sed 's/^/  · /')
If you cannot produce one, say so on the pad and say WHY. A silent turn is scored FAILED.
You may spawn your own sub-agents (stitchpad spawn <name> --brief ... --artifact ...) up to depth $STITCHPAD_SPAWN_MAX_DEPTH. Report back with: stitchpad say \"@$_parent ...\""

    if ! STITCHPAD_NAME="$_parent" "$BIN_DIR/stitchpad" say "$_msg" >/dev/null; then
      echo "stitchpad: spawn — @$_child is in the roster under contract, but the brief did not post. Re-send it with: stitchpad say \"@$_child ...\"" >&2; exit 1
    fi
    echo "✓ spawned @$_child (parent @$_parent, depth $((_depth + 1)), adapter $_adapter${_model:+, model $_model})"
    printf '  contract: %s' "$(printf '%s' "$_arts" | tr '\n' ' ')"; echo
    echo "  brief posted to the pad — the watcher delivers it; check with: stitchpad lanes"
    ;;

  join)
    sp_init_paths || exit 1
    # Parse optional flags: --role <role> [--level junior|senior|lead|principal]
    _role=""; _level=""
    _args=()
    while [ $# -gt 0 ]; do
      case "$1" in
        --role) _role="${2:-}"; shift 2 ;;
        --level) _level="${2:-}"; shift 2 ;;
        --) shift; _args+=("$@"); break ;;
        --*) echo "stitchpad: unknown join flag $1" >&2; exit 1 ;;
        *) _args+=("$1"); shift ;;
      esac
    done
    set -- "${_args[@]:+${_args[@]}}"
    who="${1:?usage: stitchpad join <name> <adapter> [wake] [target] [--role <role>] [--level <level>]}"
    adapter="${2:?adapter required (e.g. pi, claude, codex, mcp)}"
    # F3: Name validation — same allowlist as rename. Unicode/homoglyph names
    # are rejected because they bypass the tolower duplicate guard and create
    # ghost roster rows.
    # The class is ENUMERATED, not a range. `[!a-zA-Z0-9_-]` is collation-
    # dependent: under LANG=en_US.UTF-8 (what agents actually run with) bash
    # folds accented letters INTO the a-z range, so "davé" matched [a-zA-Z] and
    # sailed through — the allowlist only bit under LC_ALL=C. Proven:
    #   LC_ALL=en_US.UTF-8 bash -c 'case "davé" in *[!a-zA-Z0-9_-]*) ...'  -> no match
    #   LC_ALL=C           bash -c '...same...'                            -> match
    # That is how @dave, @davé and @dáve ended up as three roster rows the
    # operator cannot tell apart. Enumeration has no collation semantics.
    case "$who" in *[!abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-]*) echo "stitchpad: bad name '$who' (allowed: a-z 0-9 _ -)" >&2; exit 1;; esac
    # LENGTH CAP (k3 F19). join validated the CHARACTER SET and never the length,
    # so a 241-character handle was accepted here and then had to be worked around
    # everywhere downstream: per-agent state files are "<prefix>.<name>" and a
    # filesystem caps one path component at 255 bytes, so a long handle pushed
    # those names past the limit. E-17 already had to hash the identity just to
    # keep the read cursor writable. Cap it at the PRODUCER — the one place that
    # can actually refuse — instead of adding another downstream workaround.
    sp_assert_name_length "$who" || exit 1
    # F3: Case-ambiguous duplicate: sp_user_exists uses tolower, so 'Dave'
    # matches 'dave' — re-joining the same seat is idempotent (exit 0).
    # ORDER MATTERS. The duplicate-name check used to run FIRST and exit 0, which
    # meant a join as an ALREADY-PRESENT name never reached the terminal claim —
    # so "one terminal = one pad" could be bypassed simply by using an existing
    # name, and (once rejoin started emitting context) pad context would be handed
    # to a terminal that never held the claim. Claim the terminal FIRST, then treat
    # a duplicate as an idempotent rejoin.
    wake="${3:-pull}"; target="${4:--}"
    # P35/P37: joining from a MANAGED TERMINAL must leave you with an identity.
    # sp_me resolves a pane back to a roster row by matching this terminal id
    # against the target column — so a join with target "-" resolved to nothing,
    # and `join` returned 0 while `whoami` stayed EMPTY and `say` refused with
    # "no identity". Verified by hand inside a live herdr pane (HERDR_PANE_ID=w4:p3)
    # before this fix: init 0, join 0, whoami [], say REFUSED.
    # Only fills an UNSET target, and only when a managed surface actually
    # resolves — the CLI path (HERDR_* unset) is untouched and still uses
    # STITCHPAD_NAME, exactly as its own error message documents.
    if [ "$target" = "-" ] && [ -n "${HERDR_PANE_ID:-}" ]; then
      _join_surface="$(sp_this_surface 2>/dev/null || true)"
      [ -n "$_join_surface" ] && target="$_join_surface"
    fi
    # ONE TERMINAL = ONE PAD: claim the target terminal before touching the
    # roster; a terminal live in another pad refuses the join outright.
    _owner_pid="${STITCHPAD_HEARTBEAT_PARENT_PID:-$PPID}"
    # ONE TERMINAL = ONE PAD applies to seats that OCCUPY a terminal. A push seat
    # does not: it is driven by the daemon, and its "target" is an Ocean session,
    # not a surface. Falling back to claiming the CALLER's surface for a targetless
    # push seat was wrong in general — it meant an operator sitting in their own
    # joined terminal could not enrol a push seat at all ("terminal X is live as
    # @you"), and it is what blocked sub-agent spawning outright. Pull seats are
    # unchanged: they still claim, and still refuse a terminal held by another pad.
    if [ "$target" != "-" ]; then sp_term_lock_claim "$target" "$who" "$_owner_pid" || exit 1
    elif [ "$wake" != "push" ]; then
      _jsurf="$(sp_this_surface)"; [ -n "$_jsurf" ] && { sp_term_lock_claim "$_jsurf" "$who" "$_owner_pid" || exit 1; }
    fi
    if sp_user_exists "$who"; then
      # Idempotent rejoin — but only for a terminal that just proved its claim
      # above. Idempotent means the same OBSERVABLE result, not just the same exit
      # code: emit the ponytail context so a restarted agent can actually rebuild.
      echo "stitchpad: @$who already in roster (or a case variant exists — names are case-insensitive)" >&2
      printf '%s\n' "$who already in roster" | sp_prompt_with_ponytail
      exit 0
    fi
    sp_lock || exit 1
    if sp_user_exists "$who"; then
      sp_unlock
      printf '%s\n' "$who already in roster" | sp_prompt_with_ponytail
      exit 0
    fi
    # Insert before the closing fence of the roster block (atomic under lock).
    tmp="$(sp_stage "$PAD_MD")"
    awk -v line="$who | $adapter | $wake | $target" '
      /^```roster/ { inblk=1; print; next }
      inblk && /^```/ { print line; inblk=0; print; next }
      { print }
    ' "$PAD_MD" > "$tmp" && sp_write_inplace "$tmp" "$PAD_MD"
    sp_system "@$who joined the stitchpad ($adapter)"
    if ! sp_commit "roster: + $who ($adapter/$wake)"; then
      sp_unlock
      echo "stitchpad: join failed — roster commit did not complete; worktree may be dirty, @$who may not be in the roster" >&2
      exit 1
    fi
    # P19: the lane is taken — narrate it. sp_narrate appends `### @name ... · HH:MM`
    # and NEVER commits (a self-committing narration doubled commit counts and
    # broke heal-roster). Placed AFTER the commit above so we never narrate a
    # lane that did not durably land.
    STITCHPAD_NAME="$who" sp_narrate "took a lane in the roster as @$who ($adapter)" 2>/dev/null || true
    # Persist role/level for bridge profiles push + roster cards.
    [ -n "$_role" ] && printf '%s' "$_role" > "$PAD_STATE/role.$who"
    [ -n "$_level" ] && printf '%s' "$_level" > "$PAD_STATE/level.$who"
    sp_unlock
    # Ocean Stop hooks resolve identity from the durable session binding, not
    # ambient STITCHPAD_NAME. A push join already carries the session id, so bind
    # it here instead of requiring a separate, easy-to-forget command.
    if [ "$adapter" = "ocean" ] && [ "$wake" = "push" ] && [ "$target" != "-" ]; then
      STITCHPAD_PAD_DIR="$PAD_DIR" "$BIN_DIR/stitchpad" bind-session "$target" "$who" >/dev/null \
        || { echo "stitchpad: failed to bind Ocean session $target to @$who" >&2; exit 1; }
    fi
    # P35: say which identity path was actually established. "joined" alone
    # overstated it — you could be in the roster and still be nobody.
    if [ -n "${_join_surface:-}" ] && [ "$target" = "${_join_surface:-}" ]; then
      echo "✓ $who joined (adapter=$adapter wake=$wake) — identity bound to this terminal"
    elif [ -n "${STITCHPAD_NAME:-}" ] || [ -n "$(sp_me 2>/dev/null)" ]; then
      echo "✓ $who joined (adapter=$adapter wake=$wake)"
    else
      echo "✓ $who joined (adapter=$adapter wake=$wake) — roster only; this shell has NO identity yet (export STITCHPAD_NAME=$who, or join from a managed terminal)"
    fi
    # PERSONA INJECTION: role-based join takes precedence; fall back to name-based pack.
    _pack=""
    if [ -n "$_role" ] && [ -f "$STITCHPAD_HOME/personas/library/$_role.md" ]; then
      _pack="$STITCHPAD_HOME/personas/library/$_role.md"
    elif [ -f "$STITCHPAD_HOME/personas/$who.md" ]; then
      _pack="$STITCHPAD_HOME/personas/$who.md"
    fi
    if [ -f "$_pack" ]; then
      echo
      echo "── your stitchpad role (assume this persona) ──"
      cat "$_pack"
      echo "── skills above are a GLOSSARY: load one with /skill:<name> only when a task needs it ──"
    fi
    # House rule for EVERY member: closeouts are silent (prevents wake ping-pong).
    echo "── house rule: to acknowledge/wind down, start the line with \".\" (e.g. \".ack ok\") — never @-reply a goodbye; an @-mention wakes that agent. ──"
    # KEEP-ALIVE + AUTO-WATCHER: joining a pad starts a per-agent heartbeat
    # ticker. Watchers consume .state/alive.<name>; Stop hooks only supplement it.
    if [ "${STITCHPAD_HEARTBEAT_AUTOSTART:-1}" != "0" ]; then
      if STITCHPAD_NAME="$who" STITCHPAD_HEARTBEAT_PARENT_PID="${STITCHPAD_HEARTBEAT_PARENT_PID:-$PPID}" \
        "$BIN_DIR/stitchpad" heartbeat start "$who" >/dev/null 2>&1; then
        echo "── heartbeat started for @$who ──"
      fi
    fi
    # Keep the complete canonical block at an output boundary so MCP can prove
    # this trusted CLI join is already composed without accepting interior text.
    echo
    sp_ponytail_instructions
    # The heartbeat ticker ensures the watcher immediately and on every tick.
    # Do not race it with a second join-time ensure against the same PID lock.
    true
    ;;

  set-wake)
    # Update an EXISTING roster row's wake mode + target (and optionally adapter).
    # join exits early when the name is already present, so re-joins could never
    # move an agent from pull|- to push|<pane>; this closes that gap.
    #   stitchpad set-wake <name> <push|pull> <target> [adapter]
    sp_init_paths || exit 1
    who="${1:?usage: stitchpad set-wake <name> <push|pull> <target> [adapter]}"
    wake="${2:?wake mode required (push|pull)}"
    target="${3:--}"
    adapter="${4:-}"
    sp_user_exists "$who" || { echo "stitchpad: @$who not in roster" >&2; exit 1; }
    # TASK-9 / F9-3: refuse set-wake when the name has case-aliased duplicates
    _dup="$(sp_roster_case_duplicate "$who" || true)"
    if [ -n "$_dup" ]; then
      echo "stitchpad: case-aliased duplicate name '@$who' in roster — refused; disambiguate before set-wake" >&2
      exit 1
    fi
    sp_stop_delivery_worker "$who"
    if sp_delivery_ocean_unresolved_after_stop "$who"; then
      echo "stitchpad: refusing to retarget @$who — Ocean acceptance/cancellation outcome is unresolved" >&2
      exit 1
    fi
    # ONE TERMINAL = ONE PAD: refuse pointing a wake at a terminal that is live
    # in a different pad (this also stops the bridge auto-heal from stealing).
    if [ "$target" != "-" ]; then sp_term_lock_claim "$target" "$who" "${STITCHPAD_HEARTBEAT_PARENT_PID:-$PPID}" || exit 1; fi
    sp_lock || exit 1
    tmp="$(sp_stage "$PAD_MD")"
    awk -v who="$who" -v wake="$wake" -v target="$target" -v adapter="$adapter" '
      /^```roster/ { inblk=1; print; next }
      inblk && /^```/ { inblk=0; print; next }
      inblk && $0 !~ /^[[:space:]]*#/ {
        line=$0; sub(/^[[:space:]]+/, "", line)
        n=split(line, f, /[[:space:]]*\|[[:space:]]*/)
        if (n >= 2 && f[1] == who) {
          a = (adapter != "") ? adapter : f[2]
          print who " | " a " | " wake " | " target
          next
        }
      }
      { print }
    ' "$PAD_MD" > "$tmp" && sp_write_inplace "$tmp" "$PAD_MD"
    sp_commit_or_fail "roster: ~ $who wake=$wake target=$target" || {
      sp_unlock
      echo "stitchpad: set-wake NOT recorded — wake mode did not land in pad history" >&2
      exit 1; }
    sp_unlock
    rm -f "$PAD_STATE/delivery.$who.pending" "$PAD_STATE/delivery.$who.successor" \
      "$PAD_STATE"/delivery."$who".turn.* "$PAD_STATE"/delivery."$who".ack.* \
      "$PAD_STATE"/delivery."$who".submit.* 2>/dev/null || true
    # `set-wake` is also the repair path for an existing seat. Resolve the
    # effective adapter after rewriting the roster, then keep Ocean's Stop-hook
    # identity binding in sync with the push target.
    _effective_adapter="$(sp_roster | awk -F'|' -v who="$who" '$1==who {print $2; exit}')"
    if [ "$_effective_adapter" = "ocean" ] && [ "$wake" = "push" ] && [ "$target" != "-" ]; then
      STITCHPAD_PAD_DIR="$PAD_DIR" "$BIN_DIR/stitchpad" bind-session "$target" "$who" >/dev/null \
        || { echo "stitchpad: failed to bind Ocean session $target to @$who" >&2; exit 1; }
    fi
    echo "✓ $who wake=$wake target=$target${adapter:+ adapter=$adapter}"
    ;;

  rename)
    # Rename a roster member everywhere the local pad knows them: roster row,
    # wake cursors, heartbeat, session bindings, sticky autonames, terminal
    # locks, runtime/model meta — AND pad history: every @old (message headers,
    # mentions, presence lines) becomes @new, so the md, TUI, and surface all
    # show one continuous identity. Word-boundary safe (@thoth ≠ @thothx),
    # line structure preserved so ordinals and wake cursors stay valid.
    #   stitchpad rename <old> <new>
    sp_init_paths || exit 1
    old="${1:?usage: stitchpad rename <old> <new>}"
    new="${2:?usage: stitchpad rename <old> <new>}"
    case "$new" in *[!abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-]*) echo "stitchpad: bad name '$new' (allowed: a-z 0-9 _ -)" >&2; exit 1;; esac
    sp_assert_name_length "$new" || exit 1
    sp_user_exists "$old" || { echo "stitchpad: @$old not in roster" >&2; exit 1; }
    sp_user_exists "$new" && { echo "stitchpad: @$new already in roster" >&2; exit 1; }
    # Every simple name-keyed state file this arm knows how to carry across.
    # Declared ONCE and used twice — the pre-flight refusal below and the move
    # loop further down — so the two can never disagree about what is handled.
    _rename_prefixes="seen seen.relay count alive role level runtime forcewake dnd
      delivered_no_reply ocean-session seat-model resolved-model model
      keeper-strike keeper-obs keeper-last supervise-strikes
      artifact-expect authority scope scope-cleared scope-violation
      operator-grant pending"
    # PRE-FLIGHT. The old list stopped at delivered_no_reply, so .state/ocean-session.<old>
    # survived a rename: seat-keeper iterates ocean-session.* and logged
    # "SEAT NOT ON ROSTER" forever for a name that no longer existed, while the
    # renamed seat had no binding file and was never considered — the
    # anti-starvation watchdog silently stopped covering the one seat it was
    # watching. An allow-list rots; the point of this check is that the NEXT
    # omission is loud instead.
    # It runs BEFORE any mutation on purpose. Checking after the roster rewrite
    # would refuse with the pad file already renamed and the commit not taken —
    # trading a silent state leak for a working pad that disagrees with its own
    # history, which is strictly worse.
    _unknown_state=""
    for _f in "$PAD_STATE"/*."$old"; do
      [ -e "$_f" ] || continue
      _bn="$(basename "$_f")"; _pfx="${_bn%".$old"}"; _known=0
      for _k in $_rename_prefixes; do [ "$_pfx" = "$_k" ] && { _known=1; break; }; done
      [ "$_known" -eq 1 ] || _unknown_state="${_unknown_state:+$_unknown_state }$_bn"
    done
    if [ -n "$_unknown_state" ]; then
      echo "stitchpad: refusing to rename @$old — unrecognised state file(s): $_unknown_state" >&2
      echo "  rename does not know how to carry these to @$new, and leaving them behind is how" >&2
      echo "  a renamed push seat goes invisible to seat-keeper. Add the prefix to" >&2
      echo "  _rename_prefixes in the rename arm of $0." >&2
      exit 1
    fi
    sp_stop_delivery_worker "$old"
    if sp_delivery_ocean_unresolved_after_stop "$old"; then
      echo "stitchpad: refusing to rename @$old — Ocean acceptance/cancellation outcome is unresolved" >&2
      exit 1
    fi
    # retire the old ticker BEFORE moving state (its exit trap deletes alive.<old>);
    # remember whether it was live so we don't fake liveness for a dead agent.
    _hb_live=0
    _hlck="$PAD_STATE/heartbeat.$old.lock"
    _hgen="$(cat "$_hlck/generation" 2>/dev/null || true)"
    _hpid="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["pid"])' "$_hlck/owner" 2>/dev/null || true)"
    [ -n "$_hgen" ] && sp_ticker_owner_matches "$_hlck" "$_hgen" "$_hpid" "$old" && _hb_live=1
    "$BIN_DIR/stitchpad" heartbeat --stop "$old" >/dev/null 2>&1 || true
    sp_lock || exit 1
    tmp="$(sp_stage "$PAD_MD")"
    awk -v old="$old" -v new="$new" '
      /^```roster/ { inblk=1; print; next }
      inblk && /^```/ { inblk=0; print; next }
      inblk && $0 !~ /^[[:space:]]*#/ {
        line=$0; sub(/^[[:space:]]+/, "", line)
        n=split(line, f, /[[:space:]]*\|[[:space:]]*/)
        if (n >= 2 && f[1] == old) { out=new; for (i=2; i<=n; i++) out=out " | " f[i]; print out; next }
      }
      { print }
    ' "$PAD_MD" > "$tmp" && sp_write_inplace "$tmp" "$PAD_MD"
    # history rewrite: @old → @new everywhere in the pad (headers, mentions,
    # presence lines). In-place text swap — line count is untouched, so
    # message ordinals and every agent's wake cursor stay valid.
    # NB: plain `perl -i` writes a new file and renames it, which swaps the
    # pad's inode and makes every tail-based watcher replay the whole history.
    # Stage to a temp and copy back through the original inode instead.
    tmp="$(sp_stage "$PAD_MD")"
    perl -pe 's/\@\Q'"$old"'\E(?![A-Za-z0-9_-])/\@'"$new"'/g' "$PAD_MD" > "$tmp" \
      && sp_write_inplace "$tmp" "$PAD_MD"
    # per-agent state files keyed by name
    # This list used to stop at delivered_no_reply, and the omission was not
    # cosmetic: .state/ocean-session.<old> stayed put, so seat-keeper — which
    # iterates ocean-session.* — kept logging "SEAT NOT ON ROSTER" for a name
    # that no longer exists while the renamed seat, having no binding file, was
    # never considered at all. The anti-starvation watchdog silently stopped
    # covering the seat, which is the exact failure it exists to prevent. Model
    # pins and keeper counters were stranded the same way.
    for _pfx in $_rename_prefixes; do
      [ -f "$PAD_STATE/$_pfx.$old" ] && mv "$PAD_STATE/$_pfx.$old" "$PAD_STATE/$_pfx.$new" 2>/dev/null
    done
    # The worker is stopped above, so all remaining delivery artifacts are
    # durable history/current state and can follow the continuous identity.
    for _f in "$PAD_STATE"/delivery."$old".*; do
      [ -e "$_f" ] || continue
      _suffix="${_f#"$PAD_STATE/delivery.$old."}"
      mv "$_f" "$PAD_STATE/delivery.$new.$_suffix" 2>/dev/null || {
        sp_unlock
        echo "stitchpad: could not move delivery state while renaming @$old" >&2
        exit 1
      }
    done
    # session bindings + sticky autonames hold the NAME as file content
    for _f in "$PAD_STATE"/sessions/* "$PAD_STATE"/autoname.*; do
      [ -f "$_f" ] || continue
      [ "$(tr -d '[:space:]' < "$_f" 2>/dev/null)" = "$old" ] && printf '%s' "$new" > "$_f"
    done
    # terminal-identity locks held by (this pad, old name)
    for _f in "$SP_TERMDIR"/*; do
      [ -f "$_f" ] || continue
      IFS='|' read -r _lp _ln _lt < "$_f"
      [ "$_lp" = "$PAD_DIR" ] && [ "$_ln" = "$old" ] && printf '%s|%s|%s' "$PAD_DIR" "$new" "$_lt" > "$_f"
    done
    # POST-CONDITION: prove the claim before printing it.
    # An allow-list of prefixes is guaranteed to rot — it already did, silently,
    # and the only symptom was a watchdog that stopped watching. So rather than
    # trust the list, look for what it was supposed to eliminate: any remaining
    # simple name-keyed file for the OLD name. Compound keys are deliberately not
    # matched here — heartbeat.<name>.lock is a directory the ticker restart owns,
    # and delivery.<name>.<suffix> is moved by its own loop above.
    # This does not mv anything on its own: a new state file added later must be
    # added to the list ABOVE. It just makes the omission loud instead of silent.
    _stale_state=""
    for _f in "$PAD_STATE"/*."$old"; do
      [ -e "$_f" ] || continue
      _stale_state="${_stale_state:+$_stale_state }$(basename "$_f")"
    done
    if [ -n "$_stale_state" ]; then
      sp_unlock
      echo "stitchpad: rename INCOMPLETE — these state files still key on @$old: $_stale_state" >&2
      echo "  the roster row moved but this state did not; a push seat renamed in this condition" >&2
      echo "  goes invisible to seat-keeper. Add the prefix to the rename list in this arm." >&2
      exit 1
    fi
    sp_system "@$old is now @$new"
    # S3: rename rewrites roster bytes, per-agent state, delivery artifacts,
    # session bindings and terminal locks on disk. An unrecorded rename leaves
    # the pad's history disagreeing with its own filesystem.
    sp_commit_or_fail "roster: ~ $old renamed to $new" || {
      sp_unlock
      echo "stitchpad: rename NOT recorded — @$old → @$new did not land in pad history" >&2
      exit 1; }
    sp_unlock
    if [ "$_hb_live" -eq 1 ]; then
      STITCHPAD_NAME="$new" STITCHPAD_HEARTBEAT_PARENT_PID=0 \
        "$BIN_DIR/stitchpad" heartbeat start "$new" >/dev/null 2>&1 || true
    fi
    echo "✓ @$old → @$new (roster, cursors, heartbeat, bindings, locks)"
    echo "note: a live agent session/MCP started as @$old keeps its in-memory identity until restarted — hook-side identity follows the renamed binding immediately."
    ;;

  operator)
    # Operator credential management (authority model redesign, C2/C2b).
    # The credential is a random 256-bit key OUTSIDE every pad
    # ($HOME/.stitchpad/operator.key, 0600). Operator-gated commands require
    # the caller to present it via STITCHPAD_OPERATOR_TOKEN — out-of-band
    # possession, never an env boolean or roster inference.
    op_cmd="${1:-status}"
    case "$op_cmd" in
      keygen)
        sp_operator_keygen "${2:-}" || exit 1
        echo "✓ operator key created at $HOME/.stitchpad/operator.key (0600)"
        echo "  export STITCHPAD_OPERATOR_TOKEN=$(cat "$HOME/.stitchpad/operator.key")"
        ;;
      env)
        sp_operator_key_present || { echo "stitchpad: no operator key — run 'stitchpad operator keygen'" >&2; exit 1; }
        echo "export STITCHPAD_OPERATOR_TOKEN=$(cat "$HOME/.stitchpad/operator.key")"
        ;;
      grant)
        sp_init_paths || exit 1
        g_seat="${2:?usage: stitchpad operator grant <seat> <operation> [--ttl seconds]}"
        g_op="${3:?usage: stitchpad operator grant <seat> <operation> [--ttl seconds]}"
        g_ttl=86400
        [ "${4:-}" = "--ttl" ] && g_ttl="${5:-86400}"
        sp_operator_grant_create "$g_seat" "$g_op" "$g_ttl" || exit 1
        echo "✓ sealed one-shot grant: @$g_seat may $g_op (ttl ${g_ttl}s, bound to this pad)"
        ;;
      revoke)
        sp_init_paths || exit 1
        g_seat="${2:?usage: stitchpad operator revoke <seat> <operation>}"
        g_op="${3:?usage: stitchpad operator revoke <seat> <operation>}"
        rm -f "$PAD_STATE/operator-grant.$g_seat.$g_op" && echo "✓ grant revoked: @$g_seat $g_op"
        ;;
      status)
        if sp_operator_key_present; then
          echo "operator key: present ($HOME/.stitchpad/operator.key)"
          if sp_operator_ok; then echo "credential: PRESENTED (token matches)"; else echo "credential: not presented (export STITCHPAD_OPERATOR_TOKEN — see 'stitchpad operator env')"; fi
        else
          echo "operator key: MISSING — run 'stitchpad operator keygen'"
        fi
        ;;
      *)
        echo "usage: stitchpad operator <keygen [--force]|env|grant <seat> <op> [--ttl s]|revoke <seat> <op>|status>" >&2
        exit 1
        ;;
    esac
    ;;

  reset)
    # Repair a wedged seat — or the whole pad. Kills zombie heartbeat tickers,
    # scrubs state left behind by renamed/evicted names, drops stale terminal
    # locks, and restarts heartbeats for roster seats with a live target. A
    # normal repair preserves seen cursors, session bindings, DND, and recovery
    # markers: infrastructure repair must not replay already-delivered history.
    # Exact redelivery is an explicit, single-seat pull/hook operation that
    # queues one positive open-mention ordinal for the bound stop hook. It never
    # rewinds seen.* and never treats ordinal 0 as "replay everything". Push
    # seats remain owned by their durable delivery supervisor.
    #   stitchpad reset            sweep the whole pad
    #   stitchpad reset <name>     reset one seat
    #   stitchpad reset <name> --redeliver <positive-ordinal>
    sp_init_paths || exit 1

    _reset_kill_ticker() {   # signal only a live process with exact durable ownership proof
      local who="$1"
      sp_ticker_stop_owned "$who" || return 1
    }
    _reset_scrub_ghost() {   # remove every trace of a name no longer in the roster
      local who="$1" _pfx _f
      for _pfx in seen seen.relay count role level runtime forcewake dnd delivered_no_reply; do
        rm -f "$PAD_STATE/$_pfx.$who" 2>/dev/null
      done
      for _f in "$PAD_STATE"/sessions/* "$PAD_STATE"/autoname.*; do
        [ -f "$_f" ] || continue
        [ "$(tr -d '[:space:]' < "$_f" 2>/dev/null)" = "$who" ] && rm -f "$_f"
      done
      rm -f "$PAD_STATE"/delivery."$who".* 2>/dev/null || true
      rm -rf "$PAD_STATE"/delivery."$who".*.lock.d "$PAD_STATE"/delivery."$who".cancel.* 2>/dev/null || true
    }
    _reset_seat() {          # roster member: fresh ticker, durable state intact
      local who="$1" target seen="0"
      sp_stop_delivery_worker "$who"
      if sp_delivery_ocean_unresolved_after_stop "$who"; then
        echo "stitchpad: refusing to reset @$who — Ocean acceptance/cancellation outcome is unresolved" >&2
        return 1
      fi
      _reset_kill_ticker "$who" || return 1
      [ -f "$PAD_STATE/seen.$who" ] && seen="$(cat "$PAD_STATE/seen.$who" 2>/dev/null || echo 0)"
      target="$(sp_user_field "$who" target)"
      if [ -n "$target" ] && [ "$target" != "-" ]; then
        if ! STITCHPAD_NAME="$who" STITCHPAD_HEARTBEAT_PARENT_PID=0 \
          "$BIN_DIR/stitchpad" heartbeat start "$who" >/dev/null 2>&1; then
          echo "stitchpad: could not start a verified replacement ticker for @$who" >&2
          return 1
        fi
        echo "  · @$who: cursor preserved at ${seen:-0}, heartbeat restarted (target $target)"
      else
        echo "  · @$who: cursor preserved at ${seen:-0} (pull seat, no ticker)"
      fi
    }

    _reset_validate_redelivery() {
      local who="$1" ordinal="$2" wake_mode binding="" identity engagement open sender last_reply reply_target
      case "$ordinal" in
        ''|0|0[0-9]*|*[!0-9]*)
          echo "stitchpad: --redeliver requires a positive mention ordinal (never 0)" >&2
          return 1
          ;;
      esac
      [ "${#ordinal}" -le 9 ] || {
        echo "stitchpad: --redeliver ordinal is out of range" >&2
        return 1
      }
      wake_mode="$(sp_user_field "$who" wake)"
      if [ "$wake_mode" != "pull" ]; then
        echo "stitchpad: --redeliver is only supported for pull/hook seats; @$who uses ${wake_mode:-unknown} delivery supervision" >&2
        return 1
      fi
      # F6: resolve the NEWEST binding for the seat (rotation leaves the stale
      # sid's file in place; first-match directory order would target it).
      binding="$(sp_session_registry_sid_for_name "$who")"
      if [ -z "$binding" ]; then
        echo "stitchpad: --redeliver requires a canonical sessions/<id> binding for @$who" >&2
        return 1
      fi
      if [ -f "$PAD_STATE/pending.$who" ] || [ -f "$PAD_STATE/pending.$who.reset" ]; then
        echo "stitchpad: @$who already has unresolved recovery state; refusing to overwrite it" >&2
        return 1
      fi
      # raw scan (old forward contract): ordinal IS the first mention > ordinal-1
      # even when a later addressed reply closed it — lets us distinguish
      # "answered" (open==ordinal and a same-sender reply closed it) from
      # "not open" (ordinal is not a mention to @$who at all).
      engagement="$(sp_engagement "$who" "$((ordinal - 1))" raw)"
      read -r open sender last_reply reply_target <<<"$engagement"
      if [ "${open:-0}" != "$ordinal" ]; then
        echo "stitchpad: mention ordinal $ordinal is not currently open for @$who" >&2
        return 1
      fi
      if [ "${last_reply:-0}" -gt "$ordinal" ] 2>/dev/null \
        && [ -n "${sender:-}" ] && [ "${reply_target:-}" = "$sender" ]; then
        echo "stitchpad: mention ordinal $ordinal is already answered by @$who" >&2
        return 1
      fi
      identity="$(sp_open_mention_identity "$who" "$ordinal" 2>/dev/null || true)"
      if [ -z "$identity" ]; then
        echo "stitchpad: could not bind mention ordinal $ordinal to an exact message for @$who" >&2
        return 1
      fi
      RESET_REDELIVERY_ID="$identity"
    }

    _reset_queue_redelivery() {
      local who="$1" ordinal="$2" marker pending marker_tmp pending_tmp barrier i=0
      marker="$PAD_STATE/pending.$who.reset"
      pending="$PAD_STATE/pending.$who"
      # Deterministic test seam for the validate/mutate race. No production
      # behavior changes unless the explicit test-only path is supplied.
      barrier="${STITCHPAD_RESET_TEST_BEFORE_QUEUE_BARRIER:-}"
      if [ -n "$barrier" ]; then
        printf '%s' ready > "$barrier.ready"
        while [ ! -f "$barrier.release" ] && [ "$i" -lt 500 ]; do sleep 0.01; i=$((i+1)); done
        [ -f "$barrier.release" ] || {
          echo "stitchpad: reset test barrier timed out" >&2
          return 1
        }
      fi
      sp_lock || return 1
      # say/join/set-wake share this lock. Revalidate immediately before the
      # atomic queue so a reply or rebinding during ticker repair cannot wedge a
      # stale pending ordinal.
      if ! _reset_validate_redelivery "$who" "$ordinal"; then
        sp_unlock
        echo "stitchpad: redelivery state changed during reset; nothing queued" >&2
        return 1
      fi
      marker_tmp="$marker.tmp.$$"
      pending_tmp="$pending.tmp.$$"
      if ! printf '%s|%s' "$ordinal" "$RESET_REDELIVERY_ID" > "$marker_tmp" \
        || ! mv "$marker_tmp" "$marker" \
        || ! printf '%s' "$ordinal" > "$pending_tmp" \
        || ! mv "$pending_tmp" "$pending"; then
        rm -f "$marker_tmp" "$pending_tmp" "$marker" 2>/dev/null || true
        sp_unlock
        echo "stitchpad: could not persist exact redelivery for @$who" >&2
        return 1
      fi
      sp_unlock
      echo "  · @$who: queued exact redelivery ordinal $ordinal (seen cursor unchanged)"
    }

    who=""; redeliver=""; recovery_counters=0
    reset_failures=0
    while [ $# -gt 0 ]; do
      case "$1" in
        --recovery-counters)
          recovery_counters=1; shift
          ;;
        --redeliver)
          [ $# -ge 2 ] || { echo "usage: stitchpad reset [name] [--redeliver N] [--recovery-counters]" >&2; exit 1; }
          redeliver="$2"; shift 2
          ;;
        --*) echo "stitchpad: unknown reset option: $1" >&2; exit 1 ;;
        *)
          [ -z "$who" ] || { echo "usage: stitchpad reset [name] [--redeliver N] [--recovery-counters]" >&2; exit 1; }
          who="$1"; shift
          ;;
      esac
    done
    [ -z "$redeliver" ] || [ -n "$who" ] \
      || { echo "stitchpad: --redeliver requires exactly one roster name" >&2; exit 1; }
    if [ -n "$redeliver" ]; then
      case "$redeliver" in
        0|0[0-9]*|*[!0-9]*) echo "stitchpad: --redeliver requires a positive mention ordinal (never 0)" >&2; exit 1;;
      esac
    fi
    # F3: a reset of a seat (or the whole pad) is a cross-seat destructive
    # mutation — it signals the target's delivery worker, cancels its
    # in-flight Ocean turn, and --redeliver injects a forced replay into
    # another seat's queue. Gate it: the caller must BE the target seat
    # (self-repair, the stop-hook recovery flow) or carry TASK-5 operator
    # authority — either a non-roster caller (the human operator, the N3
    # pattern) or a deploy-level seat holding a one-shot operator grant for
    # reset-others. Every gated cross-seat reset and EVERY redeliver
    # injection is recorded in the append-only audit trail
    # .state/reset-audit.jsonl; a failed audit write refuses the operation
    # (fail-closed — an unaudited injection must never land).
    _reset_audit() {  # $1=op $2=target $3=ordinal-or-empty → rc 0 on durable append
      local _op="$1" _target="$2" _ord="${3:-}" _actor="${STITCHPAD_NAME:-operator}"
      [ -n "$PAD_STATE" ] && [ -d "$PAD_STATE" ] && [ ! -L "$PAD_STATE" ] || return 1
      python3 - "$PAD_STATE/reset-audit.jsonl" "$_op" "$_target" "$_ord" "$_actor" 2>/dev/null <<'PY'
import json, os, sys, datetime
path, op, target, ordinal, actor = sys.argv[1:6]
if os.path.islink(path):
    sys.exit(1)
rec = {"t": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
       "actor": actor, "op": op, "target": target}
if ordinal:
    rec["ordinal"] = int(ordinal)
line = json.dumps(rec, separators=(",", ":"))
try:
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_NOFOLLOW, 0o600)
except OSError:
    sys.exit(1)
try:
    os.write(fd, (line + "\n").encode("utf-8"))
finally:
    os.close(fd)
PY
    }
    _reset_caller="${STITCHPAD_NAME:-}"
    _reset_roster_names="$(sp_roster 2>/dev/null | cut -d'|' -f1 | tr '\n' ' ')"
    _reset_cross_seat=0
    if [ -n "$who" ]; then
      [ "$_reset_caller" != "$who" ] && _reset_cross_seat=1
    else
      # whole-pad sweep mutates every roster seat's delivery state
      [ -n "$_reset_roster_names" ] && _reset_cross_seat=1
    fi
    if [ "$_reset_cross_seat" -eq 1 ] && [ -n "$_reset_caller" ]; then
      case " $_reset_roster_names " in
        *" $_reset_caller "*)
          # A roster member acting on OTHER seats needs TASK-5 deploy
          # authority plus a one-shot operator grant for reset-others.
          if ! sp_authority_check_deploy "$_reset_caller" reset-others; then
            _reset_audit reset-denied "${who:-*}" "" 2>/dev/null || true
            echo "stitchpad: AUTHORITY VIOLATION — @$_reset_caller may not reset ${who:+@$who}${who:-the pad} (cross-seat reset needs an operator grant for reset-others)" >&2
            exit 1
          fi
          sp_authority_consume_grant "$_reset_caller" reset-others
          ;;
        *)
          # Non-roster caller: possibly the human operator — but a seat can
          # edit itself OUT of the roster (C2b), so non-roster-ness proves
          # nothing. Require the operator credential.
          if ! sp_operator_ok; then
            _reset_audit reset-denied "${who:-*}" "" 2>/dev/null || true
            echo "stitchpad: AUTHORITY VIOLATION — cross-seat reset requires the operator credential (a non-roster name is not proof: the roster is seat-editable)" >&2
            echo "  Run 'stitchpad operator keygen' once, then export STITCHPAD_OPERATOR_TOKEN." >&2
            exit 1
          fi
          ;;
      esac
    fi
    # N3+H4: --recovery-counters is an operator-only surface (TASK-5 authority)
    # to clear poisoned or exhausted recovery attempt counters. A seat may
    # never clear its own counters — that would defeat the bound. The caller's
    # identity must not be a roster member, exactly like the authority grant
    # path. H4: the previous gate trusted STITCHPAD_NAME only (env-asserted) —
    # any seat exporting STITCHPAD_NAME=<non-roster> bypassed it. The
    # --i-am-operator flag (H4's interim mechanism) has since been SUPERSEDED
    # by the C2 redesign: operator-ness is now proven by the operator
    # credential (sp_operator_ok), and the roster-member denial stands.
    if [ "$recovery_counters" -eq 1 ]; then
      _rc_grantor="${STITCHPAD_NAME:-}"
      _rc_roster_names="$(sp_roster 2>/dev/null | cut -d'|' -f1 | tr '\n' ' ')"
      # H4: deny roster members
      case " $_rc_roster_names " in
        *" $_rc_grantor "*)
          echo "stitchpad: AUTHORITY VIOLATION — a seat (@$_rc_grantor) may not clear recovery counters" >&2
          echo "  Only the human operator may reset recovery state." >&2
          exit 1
          ;;
      esac
      # C2: operator-ness is PROVEN by the credential, never asserted by env
      # or inferred from the (seat-editable) roster.
      if ! sp_operator_ok; then
        echo "stitchpad: --recovery-counters requires the operator credential." >&2
        echo "  Run 'stitchpad operator keygen' once, then export STITCHPAD_OPERATOR_TOKEN (see 'stitchpad operator env')." >&2
        exit 1
      fi
      if [ -n "$who" ]; then
        sp_recovery_reset_all "$PAD_STATE" "$who"
        echo "✓ recovery counters cleared for @$who"
      else
        sp_recovery_reset_all "$PAD_STATE"
        echo "✓ all recovery counters cleared"
      fi
      # F7: --recovery-counters is a counters-ONLY operation. Falling through
      # into the seat/pad sweep would let a counter clear silently restart
      # tickers and cancel in-flight turns — a destructive side effect the
      # operator never asked for.
      exit 0
    fi
    if [ -n "$who" ]; then
      sp_user_exists "$who" || { echo "stitchpad: @$who not in roster" >&2; exit 1; }
      [ -z "$redeliver" ] || _reset_validate_redelivery "$who" "$redeliver" || exit 1
      if [ -n "$redeliver" ]; then
        # F3: every replay injection is audited BEFORE it lands (fail-closed).
        _reset_audit redeliver "$who" "$redeliver" \
          || { echo "stitchpad: redeliver audit trail write failed — refusing to inject (fail-closed)" >&2; exit 1; }
      fi
      echo "reset @$who:"
      _reset_seat "$who" || exit 1
      [ -z "$redeliver" ] || _reset_queue_redelivery "$who" "$redeliver" || exit 1
      # F3: audit the completed reset (cross-seat only; self-repair is noise).
      if [ "$_reset_cross_seat" -eq 1 ]; then
        _reset_audit reset "$who" "" \
          || echo "stitchpad: WARNING — reset audit trail write failed for @$who" >&2
      fi
    else
      echo "reset pad ($PAD_DIR):"
      names="$(sp_roster | cut -d'|' -f1 | awk '{gsub(/^[ \t]+|[ \t]+$/,"");print}')"
      # 1) ghosts: heartbeat/alive state for names not in the roster
      for f in "$PAD_STATE"/alive.* "$PAD_STATE"/heartbeat.*.lock "$PAD_STATE"/delivery.*; do
        [ -e "$f" ] || continue
        g="$(basename "$f")"
        case "$g" in
          delivery.*) g="${g#delivery.}"; g="${g%%.*}" ;;
          *) g="${g#alive.}"; g="${g#heartbeat.}"; g="${g%.lock}" ;;
        esac
        printf '%s\n' "$names" | grep -qx "$g" && continue
        echo "  ghost @$g:"
        sp_stop_delivery_worker "$g"
        if sp_delivery_ocean_unresolved_after_stop "$g"; then
          echo "stitchpad: refusing to scrub ghost @$g — Ocean outcome is unresolved" >&2
          reset_failures=$((reset_failures + 1))
        elif _reset_kill_ticker "$g"; then
          # REAL lifecycle projection: evicting a ghost cancels whatever request
          # its session still had in flight. Record BEFORE the scrub removes the
          # sessions/<sid> binding (a ghost with no binding stays explicitly
          # empty). Busy pad → skipped refresh; the scrub still proceeds.
          STITCHPAD_SESSION="$(sp_session_registry_sid_for_name "$g")" STITCHPAD_NAME="$g" \
            sp_session_registry_lifecycle_commit cancel || true
          _reset_scrub_ghost "$g"
        else
          reset_failures=$((reset_failures + 1))
        fi
      done
      # 1.5) session/autoname bindings pointing at names not in the roster
      for f in "$PAD_STATE"/sessions/* "$PAD_STATE"/autoname.*; do
        [ -f "$f" ] || continue
        g="$(tr -d '[:space:]' < "$f" 2>/dev/null)"
        [ -n "$g" ] || continue
        printf '%s\n' "$names" | grep -qx "$g" && continue
        rm -f "$f" && echo "  · dropped orphaned binding $(basename "$f") (@$g)"
      done
      # 2) terminal locks held by this pad for names not in the roster
      for f in "$SP_TERMDIR"/*; do
        [ -f "$f" ] || continue
        IFS='|' read -r _lp _ln _lt < "$f"
        [ "$_lp" = "$PAD_DIR" ] || continue
        printf '%s\n' "$names" | grep -qx "$_ln" && continue
        rm -f "$f" && echo "  · dropped stale lock $(basename "$f") (@$_ln)"
      done
      # 3) every roster seat gets a fresh ticker with its cursor preserved
      for n in $names; do
        _reset_seat "$n" || reset_failures=$((reset_failures + 1))
      done
      # 4) watcher
      ensure_watcher
      echo "  · watcher ensured"
    fi
    if [ "$reset_failures" -gt 0 ]; then
      echo "stitchpad: reset left $reset_failures unverified live ticker record(s) untouched" >&2
      exit 1
    fi
    # F3: audit a completed whole-pad sweep (cross-seat by definition).
    if [ -z "$who" ] && [ "${_reset_cross_seat:-0}" -eq 1 ]; then
      _reset_audit reset "*" "" \
        || echo "stitchpad: WARNING — reset audit trail write failed for the pad sweep" >&2
    fi
    echo "✓ reset done"
    ;;

  keeper)
    # Documented CLI: `stitchpad keeper [--config <repos-file>] <repo> ...`.
    # The keeper itself is conf-driven (SEAT_KEEPER_CONF, default
    # ~/.pasture/keeper.conf) because production invokes it bare through launchd
    # every two minutes — that bare path MUST keep working, so with no arguments
    # this still execs straight through and the keeper resolves its own conf.
    # With arguments, the positional repos are materialised into a temp conf so
    # the published CLI keeps its contract without the keeper growing a second
    # source of truth for which pads it watches.
    if [ $# -eq 0 ]; then exec "$BIN_DIR/seat-keeper.sh"; fi
    _kp_conf=""; _kp_repos=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --config) [ $# -ge 2 ] || { echo "usage: stitchpad keeper [--config <repos-file>] <repo> ..." >&2; exit 2; }
                  _kp_conf="$2"; shift 2 ;;
        --)       shift; while [ $# -gt 0 ]; do _kp_repos="$_kp_repos$1
"; shift; done ;;
        -*)       echo "stitchpad keeper: unknown option: $1" >&2; exit 2 ;;
        *)        _kp_repos="$_kp_repos$1
"; shift ;;
      esac
    done
    if [ -n "$_kp_repos" ]; then
      _kp_tmp="$(mktemp)" || exit 1
      [ -n "$_kp_conf" ] && [ -f "$_kp_conf" ] && cat "$_kp_conf" >> "$_kp_tmp"
      printf '%s' "$_kp_repos" >> "$_kp_tmp"
      SEAT_KEEPER_CONF="$_kp_tmp" "$BIN_DIR/seat-keeper.sh"; _kp_rc=$?
      rm -f "$_kp_tmp"
      exit "$_kp_rc"
    fi
    [ -n "$_kp_conf" ] || { echo "usage: stitchpad keeper [--config <repos-file>] <repo> ..." >&2; exit 2; }
    exec env SEAT_KEEPER_CONF="$_kp_conf" "$BIN_DIR/seat-keeper.sh"
    ;;

  compact)
    # Move the old transcript into .state/archive.sqlite and replace it with a
    # ROLLING summary block. What survives in the pad: header+roster, the new
    # cumulative summary, every OPEN ```task block, and the newest N messages
    # verbatim. What moves to sqlite: the full pre-compact pad snapshot
    # (generation-keyed — old `read --range A-B` cites replay exactly via
    # `--gen G`) plus one row per archived message for `stitchpad search`.
    # Cursor contract: message ordinals shrink, so seen.* wake cursors reset
    # (a still-unanswered mention in the kept tail may re-fire once — correct,
    # it IS unanswered) and readref.* jumps to the new HEAD so `read --new`
    # doesn't dump the rewrite as a 400-line diff.
    #   stitchpad compact [--keep N] [--summary-file F] [--no-llm]
    sp_init_paths || exit 1
    keep=150; sumfile=""; nollm=0
    while [ $# -gt 0 ]; do case "$1" in
      --keep) keep="${2:-150}"; shift 2 ;;
      --summary-file) sumfile="${2:-}"; shift 2 ;;
      --no-llm) nollm=1; shift ;;
      *) shift ;;
    esac; done
    db="$PAD_STATE/archive.sqlite"
    /usr/bin/sqlite3 "$db" "CREATE TABLE IF NOT EXISTS snapshots(gen INTEGER PRIMARY KEY, archived_at TEXT NOT NULL, msg_count INTEGER NOT NULL, full_text TEXT NOT NULL);
      CREATE TABLE IF NOT EXISTS messages(id INTEGER PRIMARY KEY AUTOINCREMENT, gen INTEGER NOT NULL, author TEXT, at_label TEXT, body TEXT);"
    sp_lock || exit 1
    head_end="$(awk '/^```roster/{r=1} r&&/^```$/&&!/^```roster/{print NR; exit}' "$PAD_MD")"
    [ -n "$head_end" ] || { sp_unlock; echo "stitchpad: no roster block — refusing to compact" >&2; exit 1; }
    msg_lines="$(awk -v h="$head_end" 'NR>h && /^## @/{print NR}' "$PAD_MD")"
    msg_count="$(printf '%s\n' "$msg_lines" | grep -c . || true)"
    if [ "$msg_count" -le "$keep" ]; then sp_unlock; echo "stitchpad: only $msg_count messages (keep=$keep) — nothing to compact"; exit 0; fi
    cut_line="$(printf '%s\n' "$msg_lines" | tail -n "$keep" | head -1)"
    arch_count=$(( msg_count - keep ))
    gen=$(( $(/usr/bin/sqlite3 "$db" "SELECT COALESCE(MAX(gen),0) FROM snapshots;") + 1 ))
    now_label="$(date '+%m-%d %H:%M')"
    # archive: full snapshot + parsed message rows (python: quoting-safe inserts)
    python3 - "$db" "$gen" "$PAD_MD" "$head_end" "$cut_line" <<'PY'
import sqlite3, sys, re, datetime
db, gen, pad, head_end, cut = sys.argv[1], int(sys.argv[2]), sys.argv[3], int(sys.argv[4]), int(sys.argv[5])
text = open(pad, encoding="utf-8", errors="replace").read()
lines = text.split("\n")
span = lines[head_end:cut-1]
con = sqlite3.connect(db)
con.execute("INSERT INTO snapshots(gen, archived_at, msg_count, full_text) VALUES(?,?,?,?)",
            (gen, datetime.datetime.now().isoformat(timespec="seconds"), 0, text))
msgs = []; author = None; label = ""; buf = []
for ln in span:
    m = re.match(r"^## @(\S+)\s*·?\s*(.*)$", ln)
    if m:
        if author is not None: msgs.append((gen, author, label, "\n".join(buf).strip()))
        author, label, buf = m.group(1), m.group(2), []
    elif author is not None:
        buf.append(ln)
if author is not None: msgs.append((gen, author, label, "\n".join(buf).strip()))
con.executemany("INSERT INTO messages(gen, author, at_label, body) VALUES(?,?,?,?)", msgs)
con.execute("UPDATE snapshots SET msg_count=? WHERE gen=?", (len(msgs), gen))
con.commit()
PY
    [ $? -eq 0 ] || { sp_unlock; echo "stitchpad: archive write failed — pad untouched" >&2; exit 1; }
    prev_sum="$(awk '/^<!-- compact:/{f=1;next} /^<!-- \/compact -->/{f=0;next} f' "$PAD_MD")"
    span_file="$(mktemp)"; sed -n "$((head_end+1)),$((cut_line-1))p" "$PAD_MD" > "$span_file"
    # open ```task blocks from the archived span ride through the compaction
    carried="$(mktemp)"
    awk '
      /^```task /   { ib=1; st="todo"; ex=0; blk=$0 "\n"; next }
      ib && /^```$/ { blk=blk "```\n"; ib=0; if (st!="done" && st!="canceled" && !ex) printf "%s\n", blk; next }
      ib            { if ($1=="status:") st=$2; if ($0 ~ /^title: example task$/) ex=1; blk=blk $0 "\n" }
    ' "$span_file" > "$carried"
    sum=""
    if [ -n "$sumfile" ] && [ -f "$sumfile" ]; then sum="$(cat "$sumfile")"
    elif [ "$nollm" -eq 0 ] && command -v claude >/dev/null 2>&1; then
      sum="$( { printf 'PREVIOUS SUMMARY (may be empty):\n%s\n\nARCHIVED TRANSCRIPT:\n' "$prev_sum"; tail -n 3000 "$span_file"; } \
        | claude -p "You are compacting a multi-agent coding pad. Merge the PREVIOUS SUMMARY with the ARCHIVED TRANSCRIPT into ONE cumulative summary, under 250 words: decisions made, work completed per agent, current state, open threads. Plain prose/bullets, no preamble. Respond with ONLY the summary." --model haiku 2>/dev/null | head -c 4000 )"
    fi
    if [ -z "$sum" ]; then
      _auth="$(awk '/^## @/{a=$2; sub(/^@/,"",a); print a}' "$span_file" | sort | uniq -c | sort -rn | head -6 | awk '{printf "%s×%s ", $2, $1}')"
      sum="(no LLM summary) archived $arch_count messages through $now_label — top authors: ${_auth:-n/a}"
    fi
    # ds F13: snapshot the pad and every cursor BEFORE the first destructive
    # byte, so the failure path can make its own message true. A compact that
    # cannot be undone must not start.
    _rw="$(sp_rewrite_begin)" || {
      sp_unlock; rm -f "$span_file" "$carried"
      echo "stitchpad: cannot snapshot the pad before compacting — refusing, nothing changed" >&2
      exit 1; }
    tmp="$(sp_stage "$PAD_MD")"
    {
      sed -n "1,${head_end}p" "$PAD_MD"
      printf '\n<!-- compact:gen=%s -->\n' "$gen"
      printf '> 🗜 **compacted** · gen %s · %s messages archived through %s · old line-cites: `stitchpad read --range A-B --gen %s` · full-history search: `stitchpad search <query>`\n\n' "$gen" "$arch_count" "$now_label" "$gen"
      printf '%s\n' "$sum"
      printf '<!-- /compact -->\n'
      if [ -s "$carried" ]; then printf '\n*open tasks carried through compaction:*\n\n'; cat "$carried"; fi
      printf '\n'
      sed -n "${cut_line},\$p" "$PAD_MD"
    } > "$tmp"
    _wr=0; sp_write_inplace "$tmp" "$PAD_MD" || _wr=$?
    if [ "$_wr" -ne 0 ]; then
      sp_rewrite_rollback "$_rw" >/dev/null 2>&1 || true
      sp_unlock; rm -f "$span_file" "$carried"
      echo "stitchpad: compact could not rewrite the pad (write rc=$_wr) — nothing changed" >&2
      exit 1
    fi
    rm -f "$PAD_STATE"/seen.* 2>/dev/null
    # S1: the commit return was ignored, and the readref stamping below then
    # anchored EVERY agent's cursor to `rev-parse HEAD` — which, on a failed
    # commit, is the PRE-compact commit. False success compounded into cursor
    # corruption. Verify the commit landed BEFORE touching any cursor.
    # ds F13: and when it did not land, put the pad and the cursors BACK. The
    # old message claimed both were untouched while the pad had already been
    # rewritten on disk and every seen.* deleted — so the next successful `say`
    # committed the failed compact and made it permanent.
    sp_commit_or_fail "compact: gen $gen — $arch_count msgs → archive (keep $keep)" || {
      _rwrc=0; sp_rewrite_rollback "$_rw" || _rwrc=$?
      sp_unlock
      if [ "$_rwrc" -eq 0 ]; then
        echo "stitchpad: compact NOT recorded — the pad and every cursor were restored to their pre-compact state" >&2
      else
        echo "stitchpad: compact NOT recorded, and the rollback was INCOMPLETE (rc=$_rwrc) — see the line above; the pre-compact pad is preserved in .stitchpad/.state" >&2
      fi
      exit 1; }
    sp_rewrite_commit "$_rw"
    _h="$(sgit rev-parse HEAD 2>/dev/null || true)"
    if [ -n "$_h" ]; then for _f in "$PAD_STATE"/readref.*; do [ -f "$_f" ] && printf '%s' "$_h" > "$_f"; done; fi
    sp_unlock
    rm -f "$span_file" "$carried"
    echo "✓ compact gen $gen: $arch_count messages → archive.sqlite, kept $keep + open tasks + rolling summary"
    ;;

  archive)
    # Plain-markdown transcript archive — the zero-dependency sibling of
    # `compact`. compact needs sqlite3 (and wants an LLM for its summary) and
    # hides history inside .state/archive.sqlite. archive just MOVES the old
    # messages to .stitchpad/archive/<date>-conversation.md, a file any agent
    # can open, and leaves a pointer line in the pad telling them to read it.
    # The roster, the header and every ```task block stay in the pad.
    #   stitchpad archive [--keep N] [--dry-run]
    sp_init_paths || exit 1
    keep=60; dry=0
    while [ $# -gt 0 ]; do case "$1" in
      --keep) keep="${2:-60}"; shift 2 ;;
      --dry-run) dry=1; shift ;;
      *) shift ;;
    esac; done
    case "$keep" in ''|*[!0-9]*) echo "stitchpad: --keep wants a number" >&2; exit 1 ;; esac
    sp_lock || exit 1
    # Refuse on a pad with no roster block — that pad is damaged, not archivable.
    awk '/^```roster/{r=1} r&&/^```$/&&!/^```roster/{print NR; exit}' "$PAD_MD" | grep -q . \
      || { sp_unlock; echo "stitchpad: no roster block — refusing to archive" >&2; exit 1; }
    first_msg="$(awk '/^## @/{print NR; exit}' "$PAD_MD")"
    [ -n "$first_msg" ] || { sp_unlock; echo "stitchpad: no messages — nothing to archive"; exit 0; }
    msg_lines="$(awk '/^## @/{print NR}' "$PAD_MD")"
    msg_count="$(printf '%s\n' "$msg_lines" | grep -c . || true)"
    if [ "$msg_count" -le "$keep" ]; then
      sp_unlock; echo "stitchpad: only $msg_count messages (keep=$keep) — nothing to archive"; exit 0
    fi
    cut_line="$(printf '%s\n' "$msg_lines" | tail -n "$keep" | head -1)"
    arch_count=$(( msg_count - keep ))
    if [ "$dry" -eq 1 ]; then
      sp_unlock; echo "would archive $arch_count of $msg_count messages (keep $keep)"; exit 0
    fi
    day="$(date '+%Y-%m-%d')"
    mkdir -p "$PAD_ARCHIVE_DIR"
    arch_file="$PAD_ARCHIVE_DIR/$day-conversation.md"
    arch_rel="archive/$day-conversation.md"
    span="$(mktemp)"; sed -n "${first_msg},$((cut_line-1))p" "$PAD_MD" > "$span"
    # Split the archived span: ```task / ```roster blocks are CARRIED BACK into
    # the pad (a ticket board must not disappear into an archive), everything
    # else is the transcript that moves out. Stale archive pointers from earlier
    # runs are dropped — the fresh pointer below supersedes them.
    carried="$(mktemp)"; body="$(mktemp)"
    awk -v carry="$carried" '
      /^```(task|roster)/ { inblk=1; print > carry; next }
      inblk && /^```$/    { inblk=0; print "```" > carry; print "" > carry; next }
      inblk               { print > carry; next }
      /^<!-- archived:/                                { next }
      /^> 📦 \*\*Archived:/                             { next }
      /^\*carried through archiving:\*$/               { next }
      { print }
    ' "$span" > "$body"
    # ds F13: snapshot the pad, every cursor AND the transcript file before the
    # first destructive byte. The transcript is an APPEND, so without this a
    # failed archive left a duplicate block in it that the retry appended again.
    _rw="$(sp_rewrite_begin "$arch_file")" || {
      sp_unlock; rm -f "$span" "$carried" "$body"
      echo "stitchpad: cannot snapshot the pad before archiving — refusing, nothing changed" >&2
      exit 1; }
    if [ ! -f "$arch_file" ]; then
      {
        printf '# 🗄 archived conversation — %s\n\n' "$day"
        printf '> Older messages moved out of `%s` by `stitchpad archive`, oldest first.\n' "$(basename "$PAD_MD")"
        printf '> If the pad looks like it is missing context, it is in here.\n'
        printf '> The roster and every task card stayed in the pad.\n\n'
      } > "$arch_file"
    fi
    {
      printf -- '---\n\n*archived %s · %s message(s)*\n\n' "$(date '+%Y-%m-%d %H:%M')" "$arch_count"
      cat "$body"
      printf '\n'
    } >> "$arch_file"
    tmp="$(sp_stage "$PAD_MD")"
    {
      # preamble = everything before the first message, minus any previous
      # pointer AND any previous carried-blocks label (repeated archives must
      # not stack "*carried through archiving:*" lines — a fresh one is added
      # below whenever this run carries blocks)
      sed -n "1,$((first_msg-1))p" "$PAD_MD" \
        | awk '/^<!-- archived:/{next} /^> 📦 \*\*Archived:/{next} /^\*carried through archiving:\*$/{next} {print}'
      if [ -s "$carried" ]; then printf '\n*carried through archiving:*\n\n'; cat "$carried"; fi
      printf '\n<!-- archived:%s -->\n' "$day"
      printf '> 📦 **Archived:** %s older message(s) moved to `%s` (%s). Agents: READ THAT FILE before assuming context is missing — it is the earlier part of this same conversation.\n\n' \
        "$arch_count" "$arch_rel" "$(date '+%Y-%m-%d %H:%M')"
      sed -n "${cut_line},\$p" "$PAD_MD"
    } > "$tmp"
    sp_write_inplace "$tmp" "$PAD_MD" || {
      sp_rewrite_rollback "$_rw" >/dev/null 2>&1 || true
      sp_unlock; rm -f "$span" "$carried" "$body"; exit 1; }
    # Message ordinals shrink, so wake cursors must reset — same contract as
    # compact. A still-unanswered mention in the kept tail may re-fire once,
    # which is correct: it IS unanswered.
    rm -f "$PAD_STATE"/seen.* 2>/dev/null
    # S2: same compound defect as compact — unchecked commit, then cursors
    # stamped onto a possibly-stale HEAD. Verify before stamping.
    # ds F13: "cursors untouched" was false — they were already deleted, along
    # with a rewritten pad and an appended transcript file. Restore all three.
    sp_commit_or_fail "archive: $arch_count msgs → $arch_rel (keep $keep)" "$(basename "$PAD_MD")" archive || {
      _rwrc=0; sp_rewrite_rollback "$_rw" || _rwrc=$?
      sp_unlock
      if [ "$_rwrc" -eq 0 ]; then
        echo "stitchpad: archive NOT recorded — the pad, the transcript file and every cursor were restored to their pre-archive state" >&2
      else
        echo "stitchpad: archive NOT recorded, and the rollback was INCOMPLETE (rc=$_rwrc) — see the line above; the pre-archive pad is preserved in .stitchpad/.state" >&2
      fi
      exit 1; }
    sp_rewrite_commit "$_rw"
    _h="$(sgit rev-parse HEAD 2>/dev/null || true)"
    if [ -n "$_h" ]; then for _f in "$PAD_STATE"/readref.*; do [ -f "$_f" ] && printf '%s' "$_h" > "$_f"; done; fi
    sp_unlock
    rm -f "$span" "$carried" "$body"
    echo "✓ archived $arch_count messages → $arch_file (kept $keep + roster + task blocks)"
    ;;

  summarize)
    # LLM thread summary, READ-ONLY — sibling of compact's summarizer but the
    # pad is untouched: no archive, no cursor resets, no commit. The TUI's
    # /summarize (and any agent that wants a quick catch-up) calls this.
    #   stitchpad summarize [-n N]   (default: newest 200 messages)
    sp_init_paths || exit 1
    n=200
    while [ $# -gt 0 ]; do case "$1" in
      -n) n="${2:-200}"; shift 2 ;;
      *) shift ;;
    esac; done
    command -v claude >/dev/null 2>&1 || { echo "stitchpad: summarize needs the claude CLI on PATH" >&2; exit 1; }
    _thread="$("$BIN_DIR/stitchpad" read -n "$n" 2>/dev/null)"
    [ -n "$_thread" ] || { echo "stitchpad: nothing to summarize" >&2; exit 1; }
    _sum="$(printf '%s\n' "$_thread" \
      | claude -p "Summarize this multi-agent coding pad thread for someone catching up, under 200 words: decisions made, work completed per agent, current state, open threads/questions. Plain prose or tight bullets, no preamble. Respond with ONLY the summary." --model haiku 2>/dev/null | head -c 8000)"
    [ -n "$_sum" ] || { echo "stitchpad: LLM summary came back empty" >&2; exit 1; }
    printf '%s\n' "$_sum"
    ;;

  scope)
    # TASK-5: scope manifest management.
    #   stitchpad scope set <seat> <path-glob>...   add paths to a seat's manifest
    #   stitchpad scope show [seat]                 show manifest (or all seats)
    #   stitchpad scope check <path>                check current seat's scope
    #   stitchpad scope clear <seat>                clear a seat's scope manifest
    #   stitchpad scope violations [seat]           show sticky violation records
    #   stitchpad scope clear-violation <seat>      clear a sticky violation
    sp_init_paths || exit 1
    case "${1:-}" in
      set)
        who="${2:?usage: scope set <seat> <glob>...}"
        shift 2
        [ $# -ge 1 ] || { echo "usage: scope set <seat> <glob>..." >&2; exit 1; }
        manifest="$PAD_STATE/scope.$who"
        for glob in "$@"; do
          # TASK-5: a seat may not add operator-grant paths to its own manifest.
          if [ "$who" = "$(sp_me 2>/dev/null || true)" ]; then
            sp_authority_guard_grant_write "$who" "$glob" || exit 1
          fi
          grep -qxF "$glob" "$manifest" 2>/dev/null || printf '%s\n' "$glob" >> "$manifest"
        done
        echo "✓ scope manifest for @$who: $(wc -l < "$manifest" 2>/dev/null || echo 0) entries"
        ;;
      show)
        who="${2:-}"
        if [ -n "$who" ]; then
          manifest="$PAD_STATE/scope.$who"
          [ -f "$manifest" ] && { echo "@$who:"; cat "$manifest"; } || echo "@$who: (no manifest — unrestricted)"
        else
          found=0
          for m in "$PAD_STATE"/scope.*; do
            [ -f "$m" ] || continue
            found=1
            seat="${m##*.scope.}"
            echo "@$seat:"
            cat "$m"
            echo ""
          done
          [ "$found" -eq 0 ] && echo "(no scope manifests — all seats unrestricted)"
        fi
        ;;
      check)
        path="${2:?usage: scope check <path>}"
        seat="$(_sp_scope_seat)"
        if sp_scope_allows "$seat" "$path"; then
          echo "✓ @$seat may write: $path"
        else
          sp_scope_record_violation "$seat" "$path" "$PAD_STATE/scope.$seat"
          echo "✗ SCOPE VIOLATION: @$seat may NOT write: $path" >&2
          echo "  Violation recorded sticky in $PAD_STATE/scope-violation.$seat" >&2
          exit 1
        fi
        ;;
      clear)
        who="${2:?usage: scope clear <seat>}"
        rm -f "$PAD_STATE/scope.$who"
        echo "✓ scope manifest cleared for @$who"
        ;;
      violations)
        who="${2:-}"
        if [ -n "$who" ]; then
          viol="$PAD_STATE/scope-violation.$who"
          [ -f "$viol" ] && { echo "@$who:"; cat "$viol"; } || echo "@$who: (no violations)"
        else
          found=0
          for v in "$PAD_STATE"/scope-violation.*; do
            [ -f "$v" ] || continue
            found=1
            seat="${v##*.scope-violation.}"
            echo "@$seat:"
            cat "$v"
            echo ""
          done
          [ "$found" -eq 0 ] && echo "(no scope violations)"
        fi
        ;;
      clear-violation)
        who="${2:?usage: scope clear-violation <seat>}"
        rm -f "$PAD_STATE/scope-violation.$who" "$PAD_STATE/scope-cleared.$who"
        : > "$PAD_STATE/scope-cleared.$who"
        echo "✓ scope violation cleared for @$who"
        ;;
      *)
        echo "usage: stitchpad scope <set|show|check|clear|violations|clear-violation> ..." >&2
        exit 1
        ;;
    esac
    ;;

  authority)
    # TASK-5: deployment authority management.
    #   stitchpad authority set <seat> <read|write|deploy>
    #   stitchpad authority show [seat]
    #   stitchpad authority grant <seat> <operation>   create operator grant (human only)
    #   stitchpad authority check <seat> <operation>   check deploy authority
    sp_init_paths || exit 1
    case "${1:-}" in
      set)
        who="${2:?usage: authority set <seat> <read|write|deploy>}"
        level="${3:?usage: authority set <seat> <read|write|deploy>}"
        case "$level" in
          read|write|deploy) ;;
          *) echo "invalid authority level: $level (use read|write|deploy)" >&2; exit 1 ;;
        esac
        # C2: authority elevation is an operator-only surface — a seat must
        # not elevate itself. Requires the operator credential.
        if ! sp_operator_ok; then
          echo "stitchpad: AUTHORITY VIOLATION — 'authority set' requires the operator credential" >&2
          echo "  Run 'stitchpad operator keygen' once, then export STITCHPAD_OPERATOR_TOKEN." >&2
          exit 1
        fi
        printf '%s' "$level" > "$PAD_STATE/authority.$who"
        # A-2 (fx1): seal the level write so a hand-written authority.<seat>
        # is detected as forgery on read (sp_authority_level verifies the
        # sidecar whenever an operator key exists).
        _sp_authority_level_seal "$who" "$level" > "$PAD_STATE/authority.$who.seal"
        echo "✓ authority for @$who: $level"
        ;;
      show)
        who="${2:-}"
        if [ -n "$who" ]; then
          sp_authority_level "$who"
        else
          found=0
          for a in "$PAD_STATE"/authority.*; do
            [ -f "$a" ] || continue
            case "$a" in *.seal) continue ;; esac   # skip A-2 seal sidecars
            found=1
            seat="${a##*.authority.}"
            echo "@$seat: $(cat "$a")"
          done
          [ "$found" -eq 0 ] && echo "(no authority files — all seats default to write)"
        fi
        ;;
      grant)
        who="${2:?usage: authority grant <seat> <operation>}"
        op="${3:?usage: authority grant <seat> <operation>}"
        # TASK-5: a seat may NEVER create an operator grant (roster deny kept
        # as best-effort) — and C2/C2b: non-roster-ness is not proof either,
        # because the roster is seat-editable. The grant is minted ONLY with
        # the operator credential and sealed (sp-auth-v1 HMAC bound to this
        # pad + seat + operation + expiry) so a hand-written or copied grant
        # verifies nowhere.
        _grantor="${STITCHPAD_NAME:-}"
        _roster_names="$(sp_roster 2>/dev/null | cut -d'|' -f1 | tr '\n' ' ')"
        case " $_roster_names " in
          *" $_grantor "*)
            echo "stitchpad: AUTHORITY VIOLATION — a seat (@$_grantor) may not create operator grants" >&2
            echo "  Only the human operator may grant deployment authority." >&2
            exit 1
            ;;
        esac
        sp_operator_grant_create "$who" "$op" 86400 || exit 1
        echo "✓ operator grant created: @$who may perform: $op (one-time, sealed, bound to this pad)"
        ;;
      check)
        who="${2:?usage: authority check <seat> <operation>}"
        op="${3:?usage: authority check <seat> <operation>}"
        if sp_authority_check_deploy "$who" "$op"; then
          echo "✓ @$who is authorized for: $op"   # fx1 A-1: $seat is unbound here
        else
          exit 1
        fi
        ;;
      consume)
        who="${2:?usage: authority consume <seat> <operation>}"
        op="${3:?usage: authority consume <seat> <operation>}"
        sp_authority_consume_grant "$who" "$op"
        echo "✓ operator grant consumed for @$who: $op"
        ;;
      *)
        echo "usage: stitchpad authority <set|show|grant|check|consume> ..." >&2
        exit 1
        ;;
    esac
    ;;

  shift-change)
    # Fresh-context handoff, compact-smooth. An agent writes its own next-session
    # invocation as its LAST act; we store it durably in the pad's sqlite; the
    # bridge waits for the seat's pane to go IDLE (never mid-turn), injects the
    # runtime's clear command (/clear claude, /new codex), then pastes the
    # handoff into the fresh chat. Exactly-once: pending → delivering → delivered.
    #   stitchpad shift-change --save <name> --file <path>    agent saves its handoff
    #   stitchpad shift-change --claim <id>                   bridge: pending→delivering, prints body path
    #   stitchpad shift-change --mark <id> <status>           bridge: delivered / pending (retry)
    #   stitchpad shift-change --list                         pending/delivering rows
    sp_init_paths || exit 1
    db="$PAD_STATE/archive.sqlite"
    /usr/bin/sqlite3 "$db" "CREATE TABLE IF NOT EXISTS handoffs(id INTEGER PRIMARY KEY AUTOINCREMENT, agent TEXT NOT NULL, at TEXT NOT NULL, body TEXT NOT NULL, status TEXT NOT NULL DEFAULT 'pending', delivered_at TEXT);"
    case "${1:-}" in
      --save)
        who="${2:?usage: shift-change --save <name> --file <path>}"
        [ "${3:-}" = "--file" ] && [ -f "${4:-}" ] || { echo "stitchpad: need --file <path>" >&2; exit 1; }
        _handoff="$(mktemp)"
        sp_prompt_with_ponytail < "$4" > "$_handoff"
        [ "$(wc -c < "$_handoff")" -le 32768 ] || { rm -f "$_handoff"; echo "stitchpad: handoff too large after shared instructions (32KB cap)" >&2; exit 1; }
        # E4: uniqueness guard at the DB level instead of check-then-act.
        # A partial UNIQUE index on (agent) WHERE status='pending' makes two
        # concurrent --save calls for the same agent race at the SQLite layer,
        # not in shell: only one INSERT can win; the loser gets a real
        # IntegrityError, which we translate into the same truthful no-op
        # report TASK-4 promised. busy_timeout absorbs writer contention
        # instead of surfacing "database is locked".
        _save_result="$(python3 - "$db" "$who" "$_handoff" <<'PY'
import sqlite3, sys, datetime
db, who, f = sys.argv[1:4]
con = sqlite3.connect(db, timeout=10)
con.execute("PRAGMA busy_timeout=10000")
con.execute("CREATE UNIQUE INDEX IF NOT EXISTS idx_handoffs_pending_agent ON handoffs(agent) WHERE status='pending'")
try:
    con.execute("BEGIN IMMEDIATE")
    con.execute("INSERT INTO handoffs(agent, at, body) VALUES(?,?,?)",
                (who, datetime.datetime.now().isoformat(timespec="seconds"),
                 open(f, encoding="utf-8", errors="replace").read()))
    con.commit()
    print("inserted")
except sqlite3.IntegrityError:
    con.rollback()
    print("duplicate")
PY
)"
        rm -f "$_handoff"
        if [ "$_save_result" = "duplicate" ]; then
          echo "✓ shift-change already pending for @$who (no-op)"
        elif [ "$_save_result" = "inserted" ]; then
          # REAL lifecycle projection: the seat is rotating to a fresh session
          # identity. Record the rotate against its current durable binding
          # (forces a NEW request id for whatever comes next) and refresh the
          # pad header. Busy pad → skipped refresh, handoff still queued.
          STITCHPAD_SESSION="$(sp_session_registry_sid_for_name "$who")" STITCHPAD_NAME="$who" \
            sp_session_registry_lifecycle_commit rotate || true
          echo "✓ shift-change queued for @$who — finish your turn now; the bridge clears the session once idle and delivers this into the fresh chat"
        else
          echo "stitchpad: could not persist shift-change handoff for @$who" >&2
          exit 1
        fi
        ;;
      --claim)
        hid="${2:?usage: shift-change --claim <id>}"
        # F4: atomic compare-and-set — only transition pending→delivering.
        # The previous WHERE matched status IN ('pending','delivering'), so the
        # first claim's own pending→delivering flip left the row matching for
        # every subsequent claimant (18/24 concurrent claims won in fx3's probe).
        # Now only 'pending' matches: the first claim flips it to 'delivering'
        # and every later caller sees changes()=0 and is refused.
        _n="$(/usr/bin/sqlite3 "$db" "UPDATE handoffs SET status='delivering', at='$(date '+%Y-%m-%dT%H:%M:%S')' WHERE id=${hid//[!0-9]/} AND status='pending'; SELECT changes();")"
        [ "${_n:-0}" -ge 1 ] || { echo "stitchpad: handoff $hid not claimable" >&2; exit 1; }
        _bf="$PAD_STATE/shift.$hid.txt"
        /usr/bin/sqlite3 "$db" "SELECT body FROM handoffs WHERE id=${hid//[!0-9]/};" > "$_bf"
        printf '%s\n' "$_bf"
        ;;
      --mark)
        hid="${2:?}"; st="${3:?delivered|pending}"
        case "$st" in delivered|pending) ;; *) echo "bad status" >&2; exit 1;; esac
        _da=""; [ "$st" = "delivered" ] && _da=", delivered_at='$(date '+%Y-%m-%dT%H:%M:%S')'"
        /usr/bin/sqlite3 "$db" "UPDATE handoffs SET status='$st'$_da WHERE id=${hid//[!0-9]/};"
        rm -f "$PAD_STATE/shift.${hid//[!0-9]/}.txt" 2>/dev/null
        ;;
      --list|*)
        /usr/bin/sqlite3 -separator '|' "$db" "SELECT id, agent, status, at FROM handoffs WHERE status IN ('pending','delivering') ORDER BY id;"
        ;;
    esac
    ;;

  search)
    # Full-history search: live pad (line-numbered grep) + archived messages.
    #   stitchpad search <query> [-n N]
    sp_init_paths || exit 1
    q="${1:?usage: stitchpad search <query> [-n N]}"; shift || true
    n=20; [ "${1:-}" = "-n" ] && n="${2:-20}"
    # C13 (rc1): $n lands at a CLEAN sqlite statement boundary (LIMIT $n;) in
    # the archive query — unvalidated, `search x -n '1;DROP TABLE messages;--'`
    # executed and dropped the archive messages table (irrecoverable: the
    # sqlite is not in pad git). The live-section head also takes $n. Numeric
    # only, before either section runs.
    case "$n" in *[!0-9]*|'')
      echo "stitchpad: search -n must be a positive integer" >&2; exit 1 ;;
    esac
    echo "— live pad —"
    # C13-GAP (fx1, on km1 1c330ef): the QUERY was interpolated raw into both
    # sinks — grep read it as a PATTERN (regex metacharacters; a lone trailing
    # backslash errored the whole live section) and LIKE read % and _ as
    # wildcards (a '%' query enumerated the ENTIRE archive; '_' false-matched).
    # Live side: fixed-string match — the query is data, never a pattern.
    grep -inF -- "$q" "$PAD_MD" | head -n "$n" || true
    db="$PAD_STATE/archive.sqlite"
    if [ -f "$db" ]; then
      echo "— archive —"
      # Archive side: escape LIKE wildcards with an explicit ESCAPE clause.
      # Order matters: backslash first (it is the escape char), then % and _,
      # then single-quote doubling (SQL literal). '\%' matches a literal
      # percent; '\\' matches one literal backslash; quotes stay doubled.
      qq="$(printf '%s' "$q" | sed -e 's/\\/\\\\/g' -e 's/%/\\%/g' -e 's/_/\\_/g' -e "s/'/''/g")"
      /usr/bin/sqlite3 -separator ' | ' "$db" \
        "SELECT 'gen'||gen, at_label, '@'||author, substr(replace(body, char(10), ' '),1,160) FROM messages WHERE body LIKE '%$qq%' ESCAPE '\' OR author LIKE '%$qq%' ESCAPE '\' ORDER BY id DESC LIMIT $n;"
    fi
    ;;

  clear)
    # Wipe the conversation but KEEP the roster (and everyone's captured targets).
    # Rewrites stitchpad.md to just the header + roster block. One commit.
    #   stitchpad clear
    sp_init_paths || exit 1
    sp_lock || exit 1
    # FLASH2 F1: a legacy pad stores task cards inline in stitchpad.md after the
    # roster block. The cut below drops everything past the roster closing fence,
    # which would silently delete the entire task board. Refuse until migrated.
    # Migrated pads (tasks.md has real cards) are safe: the cut only trims the
    # conversation transcript + stale inline copies that tasks.md already owns.
    _clear_has_inline_tasks=0
    if awk '/^```task[[:space:]]/ { found=1; exit } END { exit !found }' "$PAD_MD"; then
      if [ ! -f "$PAD_TASKS" ] || ! awk '/^```task[[:space:]]/ { found=1; exit } END { exit !found }' "$PAD_TASKS"; then
        _clear_has_inline_tasks=1
      fi
    fi
    if [ "$_clear_has_inline_tasks" -eq 1 ]; then
      sp_unlock
      echo "stitchpad: REFUSED — task cards live inline in stitchpad.md and clear would delete them."
      echo "  Run 'stitchpad task migrate' first to move cards to tasks.md, then clear."
      exit 1
    fi
    # Keep everything through the roster block's closing fence, drop the rest,
    # add a fresh separator. Reset wake cursors so old mentions don't re-fire.
    tmp="$(sp_stage "$PAD_MD")"
    awk '
      { print }
      /^```roster/ { inblk=1; next }
      inblk && /^```$/ { print ""; print "---"; exit }
    ' "$PAD_MD" > "$tmp" && sp_write_inplace "$tmp" "$PAD_MD"
    rm -f "$PAD_STATE"/cursor.* 2>/dev/null
    if ! sp_commit "pad cleared (roster kept)"; then
      sp_unlock
      echo "stitchpad: clear failed — pad commit did not complete; worktree may be dirty" >&2
      exit 1
    fi
    sp_unlock
    echo "✓ pad cleared (roster + targets kept)"
    ;;

  leave)
    # Remove a participant from the roster + post an italic presence line.
    #   stitchpad leave <name>
    sp_init_paths || exit 1
    who="${1:-$(sp_me)}"
    [ -z "$who" ] && { echo "usage: stitchpad leave <name>" >&2; exit 1; }
    sp_stop_delivery_worker "$who"
    if sp_delivery_ocean_unresolved_after_stop "$who"; then
      echo "stitchpad: refusing to remove @$who — Ocean acceptance/cancellation outcome is unresolved" >&2
      exit 1
    fi
    # F4: Surface open tasks assigned to the departing member BEFORE locking.
    # A task handed to a departed member is invisible to everyone and stranded.
    _leave_open_tasks="$(sp_tasks --mine "$who" --status todo 2>/dev/null || true)"
    _leave_open_count="$(echo "$_leave_open_tasks" | grep -c '^TASK-' 2>/dev/null || true)"
    _leave_open_count="${_leave_open_count:-0}"
    if [ "$_leave_open_count" -gt 0 ]; then
      echo "stitchpad: @$who has $_leave_open_count open task(s) — reassign before or after leave:" >&2
      echo "$_leave_open_tasks" | while IFS= read -r _lt; do
        [ -n "$_lt" ] && echo "    $_lt" >&2
      done
      echo "  Reassign with: stitchpad task edit <TASK-N> --to <new-name>" >&2
    fi
    sp_lock || exit 1
    # Journal the registry/markers/header/pad window BEFORE any mutation — the
    # roster edit, presence line, terminal record, and roster commit below are
    # one interlocked unit. The journal must capture the pre-leave pad bytes:
    # beginning after the roster edit would make rollback restore the already
    # mutated pad, leaving an uncommitted roster removal behind on failure.
    _leave_sid="$(sp_session_registry_sid_for_name "$who")"
    _leave_journal="$(sp_session_registry_journal_begin "$_leave_sid")" || {
      sp_unlock
      echo "stitchpad: could not journal pre-leave state — refusing to remove @$who" >&2
      exit 1
    }
    tmp="$(sp_stage "$PAD_MD")"
    awk -v who="$who" '
      /^```roster/ { inblk=1; print; next }
      inblk && /^```/ { inblk=0; print; next }
      inblk && tolower($1)==tolower(who) { next }   # drop this roster line
      { print }
    ' "$PAD_MD" > "$tmp" && sp_write_inplace "$tmp" "$PAD_MD" || {
      sp_session_registry_journal_rollback "$_leave_journal" "$_leave_sid"
      sp_unlock
      echo "stitchpad: roster edit failed for @$who — rolled back pad state; @$who still in roster" >&2
      exit 1
    }
    sp_system "@$who left the stitchpad"
    # REAL lifecycle projection: leaving ends the seat's session. We already
    # hold the pad mutation lock — record the terminal event against the seat's
    # durable session binding (missing binding stays explicitly empty) and
    # refresh the pad header so the roster commit below carries both.
    # The journal covers the whole window: a failed terminal record or a failed
    # roster commit is compensated exactly — never a committed roster edit
    # without its registry state, never registry state or pad edits for a
    # commit that failed.
    if ! STITCHPAD_SESSION="$_leave_sid" STITCHPAD_NAME="$who" \
      sp_session_registry_lifecycle_locked terminal; then
      sp_session_registry_journal_rollback "$_leave_journal" "$_leave_sid"
      sp_unlock
      echo "stitchpad: terminal event for @$who failed — rolled back; roster unchanged" >&2
      exit 1
    fi
    if ! sp_commit "roster: - $who"; then
      sp_session_registry_journal_rollback "$_leave_journal" "$_leave_sid"
      sp_unlock
      echo "stitchpad: roster commit failed — rolled back pad, registry, and header state for @$who" >&2
      exit 1
    fi
    sp_session_registry_journal_commit "$_leave_journal"
    # also release any file claims and wake state this agent held
    rm -f "$PAD_STATE/seen.$who" "$PAD_STATE/forcewake.$who" 2>/dev/null
    rm -f "$PAD_STATE"/delivery."$who".* 2>/dev/null || true
    rm -rf "$PAD_STATE"/delivery."$who".*.lock.d "$PAD_STATE"/delivery."$who".cancel.* 2>/dev/null || true
    for _ld in "$PAD_STATE"/claims/*.d; do
      [ -d "$_ld" ] && read -r _h _ < "$_ld/holder" 2>/dev/null && [ "$_h" = "$who" ] && rm -rf "$_ld"
    done
    sp_unlock
    echo "✓ $who left"
    # KEEP-ALIVE: stop this agent's heartbeat ticker so the watcher can self-stop
    # once all remaining agents go stale.
    STITCHPAD_NAME="$who" "$BIN_DIR/stitchpad" heartbeat --stop "$who" >/dev/null 2>&1 || true
    # release this agent's terminal claims so the terminal can join another pad
    sp_term_lock_release "$who" 2>/dev/null || true
    # AUTO-WATCHER: stop watcher if roster is empty (no members = no heartbeats).
    _remaining="$(sp_roster | awk 'NF { n++ } END { print n + 0 }')"
    if [ "${_remaining:-0}" -le 0 ]; then
      sp_stop_watchers_for_pad 2>/dev/null \
        && echo "── last member left — wake watcher stopped ──"
    fi
    ;;

  bind-session)
    # Bind a session id to a name (called by the MCP `join` tool). This is what
    # lets the separate hook process resolve the same identity the MCP holds.
    #   stitchpad bind-session <session_id> <name>
    sp_init_paths || exit 1
    sid="${1:?usage: stitchpad bind-session <session_id|-> <name>}"
    nm="${2:?name required}"
    if [ "$sid" = "-" ]; then
      echo "✓ no session id — set STITCHPAD_NAME=$nm or run inside a Herdr pane to pin identity" >&2
    else
      # E4: serialize the check-then-act (read _prev, decide, write) under the
      # pad lock. Two concurrent binders racing on the same sid could both pass
      # the collision guard and both `printf >` the binding file — an
      # interleaved write produces torn garbage (e.g. "bobce") that is not a
      # valid roster name. The lock makes the whole decide+write sequence one
      # atomic critical section; the write itself is also mktemp+rename so a
      # reader never observes a partial file even mid-write.
      sp_lock || { echo "stitchpad: pad busy (lock timeout) — could not bind session" >&2; exit 1; }
      # Collision guard: if this session id is ALREADY bound to a DIFFERENT name,
      # blindly clobbering is the identity-bleed bug (one session id rebound to
      # whoever posted last → CLI posts mis-stamped). Refuse unless --force, so a
      # crossed binding is loud, not silent. Same name = idempotent, always ok.
      _prev="$(cat "$PAD_STATE/sessions/$sid" 2>/dev/null || true)"
      if [ -n "$_prev" ] && [ "$_prev" != "$nm" ] && [ "${STITCHPAD_FORCE_BIND:-0}" != "1" ]; then
        sp_unlock
        echo "✗ session $sid is already bound to @$_prev (not @$nm)." >&2
        echo "  Two runtimes may be sharing one session id, or this is a stale cross-bind." >&2
        echo "  If you really mean to rebind, re-run with STITCHPAD_FORCE_BIND=1." >&2
        exit 1
      fi
      # TASK-4: idempotent reassignment — same sid → same name is a no-op
      # with a truthful report, never a double-apply.
      if [ "$_prev" = "$nm" ]; then
        sp_unlock
        echo "✓ session $sid already bound to @$nm (no-op)"
      else
        # E4: atomic write — mktemp in the same dir (same filesystem, so
        # rename is atomic) then rename over the target. A reader either
        # sees the old content or the new content in full, never a torn mix.
        _bind_tmp="$PAD_STATE/sessions/.$sid.tmp.$$"
        if printf '%s' "$nm" > "$_bind_tmp" 2>/dev/null && mv -f "$_bind_tmp" "$PAD_STATE/sessions/$sid" 2>/dev/null; then
          sp_unlock
          echo "✓ bound session $sid → @$nm"
        else
          rm -f "$_bind_tmp" 2>/dev/null || true
          sp_unlock
          echo "✗ could not persist session binding for $sid" >&2
          exit 1
        fi
      fi
      # REAL lifecycle projection: a first-time binding is a dispatch; binding
      # a session that already ENDED is a resume (the marker helper clears the
      # stale end marker). Rebinding an already-active session records NOTHING
      # — the persisted request identity must stay stable across idempotent
      # re-joins, never re-minted. Busy pad → skipped refresh, never a failure.
      _bind_event=""
      if [ -e "$PAD_STATE/session-end.$sid" ]; then
        _bind_event="resume"
      elif [ ! -e "$PAD_STATE/session-start.$sid" ]; then
        _bind_event="dispatch"
      fi
      if [ -n "$_bind_event" ]; then
        STITCHPAD_SESSION="$sid" STITCHPAD_NAME="$nm" \
          sp_session_registry_lifecycle_commit "$_bind_event" || true
      fi
    fi
    # Auto-detect the model from the agent's own env (runs in-process, so each
    # harness's vars are visible). Only writes if we find one — never guesses.
    _model="${STITCHPAD_MODEL:-${ANTHROPIC_MODEL:-${CODEX_MODEL:-${OPENAI_MODEL:-${PI_MODEL:-}}}}}"
    if [ -n "$_model" ]; then
      printf '%s' "$_model" > "$PAD_STATE/model.$nm"
      echo "✓ model for @$nm: $_model"
      # TASK-1: the env readback is RESOLVED telemetry, persisted separately
      # from the operator's requested pin. A drift (e.g. env reports
      # claude-fable-5 while seat-model pins gpt-5.6-sol) surfaces loudly and
      # drops an active mismatch marker; binding itself never refuses.
      sp_model_pin_record_resolved "$PAD_STATE" "$nm" "$_model" "" "bind-session-env" "$sid" || true
      sp_model_pin_check "$PAD_STATE" "$nm" || true
    fi
    # Push-target capture is owned by MCP/pi Herdr join and SessionStart repair.
    # Honor the same explicit autostart opt-out as join; tests and maintenance
    # can bind identity without silently creating a ticker/watcher generation.
    # The heartbeat is best-effort HERE: this arm's exit status is the BINDING's
    # status. The old `start && echo` tail made a heartbeat failure the arm's
    # exit code, so callers (set-wake, join) printed "failed to bind" after a
    # bind that LANDED — a false-failure report, observed live re-pointing @glm.
    if [ "${STITCHPAD_HEARTBEAT_AUTOSTART:-1}" != "0" ]; then
      if STITCHPAD_NAME="$nm" STITCHPAD_HEARTBEAT_PARENT_PID="${STITCHPAD_HEARTBEAT_PARENT_PID:-$PPID}" \
        "$BIN_DIR/stitchpad" heartbeat start "$nm" >/dev/null 2>&1; then
        echo "✓ heartbeat for @$nm"
      else
        echo "stitchpad: heartbeat did not start for @$nm — the session binding itself landed" >&2
      fi
    fi
    ;;

  whoami)
    sp_assert_pad_git_usable || exit 1
    # Print the handle bound to this session (the MCP `join` tool calls this to
    # detect a prior binding). Resolution: sessions/<$STITCHPAD_SESSION>, else
    # the pad-level default. No binding → no output, exit 1. Read-only.
    sp_init_paths || exit 1
    _wn=""
    if [ -n "${STITCHPAD_SESSION:-}" ]; then
      _wn="$(cat "$PAD_STATE/sessions/$STITCHPAD_SESSION" 2>/dev/null || true)"
    else
      _wn="$(cat "$PAD_STATE/whoami" 2>/dev/null || true)"
    fi
    # P37: fall back to the FULL resolver. whoami consulted only the session
    # binding (or the pad default), so inside a managed herdr pane — where
    # sp_me resolves the identity from the terminal surface via the roster —
    # `whoami` printed NOTHING while `say` posted happily as that same agent.
    # Verified in a live pane (HERDR_PANE_ID=w4:p3): surface term_6583ffdbadffef,
    # roster row matched, sp_me could resolve it, whoami said [].
    # "Who am I" must answer with the identity the tool will actually use.
    [ -n "$_wn" ] || _wn="$(sp_me 2>/dev/null || true)"
    [ -n "$_wn" ] || exit 1
    printf '%s\n' "$_wn"
    ;;

  say)
    sp_init_paths || exit 1
    # Sender is your pinned STITCHPAD_NAME — never an argument — so a terminal can
    # only ever post as itself. Everything after `say` is the message.
    #   stitchpad say [--image <path>] <text...>
    from="$(sp_me)"
    [ -z "$from" ] && { echo "stitchpad: no identity — call the MCP join tool first (or set STITCHPAD_NAME for CLI/testing)" >&2; exit 1; }
    # TASK-7: record say outcome (best-effort; never affects the post).
    _tel_start="$(date +%s)"
    _say_record() {  # $1=outcome
      sp_telemetry_record say seat="$from" outcome="${1:-posted}" \
        dur_ms=$(( $(sp_telemetry_now_ms) - _tel_start * 1000 )) 2>/dev/null || true
    }
    # ONE TERMINAL = ONE PAD: if this terminal holds a live identity lock for a
    # DIFFERENT pad, refuse to post here — the resolver (cwd walk-up, stale MCP
    # server, wrong env) picked the wrong pad. Kills cross-pad ghost posts.
    # sp_this_surface resolves herdr terminal ids, then the pane-id fallback,
    # then session-env ids — so non-herdr agent shells are still guarded.
    _ssurf="$(sp_this_surface)"
    if [ -n "$_ssurf" ]; then
      _holder="$(sp_term_lock_check "$_ssurf" "$from")" || {
        # sp_term_lock_check refuses when the pad OR the name differs, but this
        # message only ever talked about the pad — so a NAME mismatch printed the
        # same path twice ("bound to X ... not X") and named a cause that was not
        # the cause. Report the axis that actually differs.
        _hpad="${_holder%%|*}"; _hname="$(printf '%s' "$_holder" | cut -d'|' -f2)"
        if [ "$_hpad" = "$PAD_DIR" ]; then
          echo "stitchpad: REFUSED — this terminal is claimed by @$_hname, but you are @${from:-<no identity>}. Same pad ($PAD_DIR); the IDENTITY differs. Run 'stitchpad leave' to release it, or set STITCHPAD_NAME=$_hname." >&2
        else
          echo "stitchpad: REFUSED — this terminal is bound to $_hpad (as @$_hname), not $PAD_DIR. cd there or 'stitchpad leave' first." >&2
        fi
        exit 1; }
    else
      # MP-2 fail-closed: identity env is fully process-controlled, so a
      # ghost-poster clears it to disable the surface guard above. With no
      # resolvable identity, consult the reverse name index instead: a LIVE
      # identity-backed claim for @$from in a DIFFERENT pad is positive
      # cross-pad evidence — refuse. No entry / stale / dead-owner = no
      # evidence = permissive (never locks out the operator or fixtures).
      _holder="$(sp_term_byname_check "$from")" || {
        echo "stitchpad: REFUSED — @$from is live-bound to ${_holder}, not $PAD_DIR (no terminal identity resolvable — env cleared?). cd there or 'stitchpad leave' first." >&2; exit 1; }
    fi
    image_path=""; reply_to=""
    while :; do case "${1:-}" in
      --image)
        image_path="${2:-}"
        [ -n "$image_path" ] || { echo "usage: stitchpad say [--re <#m-id>] [--image <path>] <text...>" >&2; exit 1; }
        shift 2 ;;
      --re)
        reply_to="${2:-}"
        [ -n "$reply_to" ] || { echo "usage: stitchpad say [--re <#m-id>] [--image <path>] <text...>" >&2; exit 1; }
        reply_to="#${reply_to#\#}"   # normalize: accept "m-abc" or "#m-abc"
        shift 2 ;;
      *) break ;;
    esac; done
    text="$*"
    [ -z "$text" ] && [ -z "$image_path" ] && { echo "usage: stitchpad say [--image <path>] <text...>  (you are @$from)" >&2; exit 1; }

    if [ -n "$image_path" ]; then
      [ -f "$image_path" ] || { echo "stitchpad: image not found: $image_path" >&2; exit 1; }
      case "$(file -b --mime-type "$image_path" 2>/dev/null || true)" in
        image/png|image/jpeg|image/gif|image/webp) ;;
        *)
          echo "stitchpad: unsupported image type (allowed: png, jpeg, gif, webp)" >&2
          exit 1
          ;;
      esac
      size="$(stat -f %z "$image_path" 2>/dev/null || stat -c %s "$image_path" 2>/dev/null || echo 0)"
      max_size=$((10 * 1024 * 1024))
      [ "$size" -le "$max_size" ] || { echo "stitchpad: image too large: $size bytes (max $max_size)" >&2; exit 1; }
      relay="${STITCHPAD_RELAY:-}"
      token="${STITCHPAD_TOKEN:-}"
      [ -n "$relay" ] && [ -n "$token" ] || { echo "stitchpad: --image requires STITCHPAD_RELAY and STITCHPAD_TOKEN" >&2; exit 1; }
      pad_name="$(basename "$(dirname "$PAD_DIR")")"
      upload_url="${relay%/}/upload-image?pad=$pad_name"
      resp="$(curl -fsS -H "authorization: Bearer $token" -F "image=@$image_path" "$upload_url")" || {
        echo "stitchpad: image upload failed" >&2
        exit 1
      }
      image_url="$(printf '%s' "$resp" | jq -r '.url // empty' 2>/dev/null || true)"
      [ -n "$image_url" ] || { echo "stitchpad: image upload response missing url" >&2; exit 1; }
      alt="$(basename "$image_path" | tr -d '[]()' | tr '\n\r' '  ' | sed -E 's/[[:space:]]+/ /g; s/^ //; s/ $//')"
      [ -n "$alt" ] || alt="image"
      image_md="![$alt]($image_url)"
      if [ -n "$text" ]; then
        text="$(printf '%s\n\n%s' "$text" "$image_md")"
      else
        text="$image_md"
      fi
    fi

    # Hold the mutation lock while reading the roster and appending. A missing
    # or headerless file must fail closed: appending would recreate a pad with no
    # members, silently strip @all, and make every mention unwakeable.
    # Capture an epoch snapshot for the date divider (before the lock, so we
    # record the wall-clock time the operation was authored). Failures are
    # non-fatal — the message still posts.
    sp_date_divider_snapshot || true
    sp_lock || exit 1
    if [ ! -f "$PAD_MD" ] || ! grep -q '^```roster[[:space:]]*$' "$PAD_MD" 2>/dev/null; then
      sp_unlock
      echo "stitchpad: pad roster is missing — refusing to post; run 'stitchpad heal-roster' to recover the roster from pad history" >&2
      exit 1
    fi
    # Also refuse an EMPTY roster (fence present but no members): the pad
    # must self-heal from history rather than wedging.
    _say_roster_count="$(sp_roster_members_count "$PAD_MD")"
    if [ "$_say_roster_count" -eq 0 ]; then
      sp_unlock
      # deepseek F7: this always said "run heal-roster", which on a FRESH pad
      # cannot work — there is no historic roster with members to recover, so
      # heal-roster exits 1 with "cannot heal" and the operator's very first
      # command has sent them to a dead end. Empty-because-nobody-joined and
      # empty-because-lost are different faults with different fixes; the
      # commit count tells them apart (a fresh pad has only its bootstrap).
      if [ "$(sp_commit_count)" -le 1 ]; then
        echo "stitchpad: pad roster is EMPTY — nobody has joined yet. Take a seat first:" >&2
        echo "    stitchpad join <your-name> <cli|claude|codex|ocean|pi>" >&2
        echo "  (heal-roster cannot help here: a fresh pad has no history to recover from.)" >&2
      else
        echo "stitchpad: pad roster is EMPTY — refusing to post; run 'stitchpad heal-roster' to recover the roster from pad history" >&2
      fi
      exit 1
    fi

    # @all expansion: "@all" → every roster member, minus the sender, minus any
    # "-@name" exclusions in the message. So "@all -@ernie -@Jill hey" wakes
    # everyone except ernie and Jill. The -@name tokens are stripped from the
    # posted text. Expands to explicit @mentions so the normal wake gate just works.
    # "@flock" is the lore alias — same gang-prompt, pasture voice.
    if printf '%s' "$text" | grep -qiE '(^|[[:space:]])@(all|flock)([^a-zA-Z0-9_-]|$)'; then
      # collect excluded names from -@name tokens
      excl=" $from "   # never wake yourself
      for tok in $text; do
        case "$tok" in -@*) excl="$excl ${tok#-@} ";; esac
      done
      # build the @mention list of everyone not excluded
      mentions=""
      while IFS='|' read -r rn _; do
        [ -n "$rn" ] || continue
        case "$excl" in *" $rn "*) continue;; esac
        # skip operators/humans — they aren't woken
        rt="$(cat "$PAD_STATE/runtime.$rn" 2>/dev/null || true)"
        [ "$rt" = "operator" ] || [ "$rt" = "human" ] && continue
        mentions="$mentions @$rn"
      done < <(sp_roster)
      # strip the -@name exclusion tokens and the literal @all/@flock, prepend the expanded list
      cleaned="$(printf '%s' "$text" | sed -E 's/(^|[[:space:]])-@[a-zA-Z0-9_-]+//g; s/(^|[[:space:]])@(all|flock)([^a-zA-Z0-9_-]|$)/\3/Ig')"
      text="$(printf '%s' "${mentions# } $(printf '%s' "$cleaned" | sed -E 's/^[[:space:]]+//')")"
    fi
    # Derive the message timestamp from the captured epoch (same as the
    # date divider) so the divider, message HH:MM, and commit timestamp all
    # originate from the same wall-clock snapshot.
    # From the live branch: a `--re` pointing at nothing renders as a broken
    # thread on every surface. Checked BEFORE the journal opens, so the failure
    # path has nothing to roll back.
    if [ -n "$reply_to" ] && ! grep -q "· $reply_to" "$PAD_MD" 2>/dev/null; then
      sp_unlock
      _say_record failed
      echo "stitchpad: reply target $reply_to not found in this pad" >&2
      exit 1
    fi
    ts="$(sp_date_divider_hhmm || date '+%I:%M %p')"
    # Journal the exact pre-operation bytes of the pad, the session registry,
    # and every lifecycle marker BEFORE any mutation. The registry and markers
    # live outside the pad git, so a failed commit cannot be unwound by git —
    # the journal is the compensation record. Refusing to journal fails closed
    # before the pad is touched: no committed pad without registry state, no
    # registry state for an uncommitted pad.
    _say_sid="$(sp_session_registry_sid)"
    _say_journal="$(sp_session_registry_journal_begin "$_say_sid")" || {
      sp_unlock
      _say_record failed
      echo "stitchpad: could not journal pre-say state — refusing to post" >&2
      exit 1
    }
    # Insert date divider for the first message on a new canonical date.
    # Under the lock so exactly one divider is written per date. Divider state
    # (last-divider-epoch) is inside the journal window: any later failure
    # restores it too, so a retry sees exactly the pre-say world.
    sp_date_divider_insert || true
    # Header grammar v2 (live branch): "## @name · TIME · #m-ID [· re:#m-PARENT]".
    # The id is the durable anchor reactions, threads and `amend` all hang off;
    # readers that only want author/time ignore the extra " · " fields. The
    # timestamp still comes from the captured epoch, so divider, header and
    # commit stay on one wall clock.
    mid="$(sp_msg_id)"
    hdr="@$from · $ts · #$mid"
    [ -n "$reply_to" ] && hdr="$hdr · re:$reply_to"
    printf '\n## %s\n\n%s\n' "$hdr" "$text" >> "$PAD_MD"
    # Align the git commit timestamp with the same captured epoch ("@<epoch>"
    # is git's strict epoch form). Scoped to this one sp_commit call — bash
    # restores prefixed assignments after the function returns, so no ambient
    # GIT_*_DATE leaks into later commands.
    _captured_epoch="$(sp_date_divider_epoch)"
    # Record this operation in the append-only session registry BEFORE the
    # commit so durable state cannot lag behind a successful sp_commit. All
    # timestamps derive from the same captured epoch — no second date +%s.
    # FAIL CLOSED: a failed registry write (or header render) rolls the pad,
    # markers, and divider state back to the journaled pre-say bytes and aborts
    # the post — a committed pad can never be left without its registry entry.
    if ! sp_session_registry_lifecycle_locked activity "$_captured_epoch"; then
      sp_session_registry_journal_rollback "$_say_journal" "$_say_sid"
      sp_unlock
      _say_record failed
      echo "stitchpad: session registry write failed — rolled back; message NOT posted" >&2
      exit 1
    fi
    _say_subject="$from: $(printf '%s' "$text" | tr '\n' ' ' | cut -c1-60)"
    _say_commit_rc=0
    if [ -n "$_captured_epoch" ]; then
      GIT_COMMITTER_DATE="@$_captured_epoch" GIT_AUTHOR_DATE="@$_captured_epoch" \
        sp_commit "$_say_subject" || _say_commit_rc=$?
    else
      sp_commit "$_say_subject" || _say_commit_rc=$?
    fi
    # FAIL CLOSED the other way: a failed pad commit rolls the registry entry,
    # markers, header, and pad bytes back to the journaled pre-say state, so a
    # retry emits exactly once — never registry/header state for a message that
    # never committed.
    if [ "$_say_commit_rc" -ne 0 ]; then
      sp_session_registry_journal_rollback "$_say_journal" "$_say_sid"
      sp_unlock
      _say_record failed
      echo "stitchpad: pad commit failed — rolled back registry, header, and pad; message NOT posted" >&2
      exit 1
    fi
    sp_session_registry_journal_commit "$_say_journal"
    # Posting IS the reply — clear both dropped-turn markers (the pending re-block
    # bound AND the delivered_no_reply visibility flag) so a reply resolves them and
    # they can't cause a spurious re-block or stale doctor state later.
    rm -f "$PAD_STATE/pending.$from" "$PAD_STATE/delivered_no_reply.$from" 2>/dev/null
    sp_unlock
    _say_record posted
    echo "✓ posted as @$from (#$mid)"
    # A mention aimed at a name that is not on the roster wakes NOBODY, and used
    # to say nothing about it: `say "@carlo ..."` when the seat is @carlos
    # printed a tick and the message sat there forever. Warn (never refuse —
    # prose legitimately contains @-shaped text) and suggest the nearest roster
    # name, because a typo is the overwhelmingly likely cause.
    # ONLY when a human is watching. This warning goes to stderr, and suites
    # (and adapters, and the relay bridge) capture and parse stderr — emitting it
    # unconditionally turned six green suites red, including two that could no
    # longer parse their own output. Same convention `task list` already uses:
    # human rendering on a terminal, byte-stable machine output otherwise.
    if [ -t 2 ]; then
    _say_roster="$(sp_roster 2>/dev/null | cut -d'|' -f1 | tr -d ' ' | tr 'A-Z' 'a-z')"
    printf '%s' "$text" | grep -oE '(^|[[:space:]])@[A-Za-z0-9_-]+' | tr -d ' @' | tr 'A-Z' 'a-z' | sort -u \
    | while IFS= read -r _mn; do
        [ -n "$_mn" ] || continue
        [ "$_mn" = "all" ] && continue
        printf '%s\n' "$_say_roster" | grep -qx "$_mn" && continue
        _near="$(printf '%s\n' "$_say_roster" | awk -v n="$_mn" '
          { a=$0; if (length(a)==0) next
            if (index(a,substr(n,1,3))==1 || index(n,substr(a,1,3))==1) { print a; exit } }')"
        if [ -n "$_near" ]; then
          echo "  ⚠ @$_mn is not on the roster — nobody was woken. Did you mean @$_near?" >&2
        else
          echo "  ⚠ @$_mn is not on the roster — nobody was woken. (stitchpad roster)" >&2
        fi
      done
    fi
    ;;

  amend)
    # Edit-in-place by message id: replace the BODY of one of YOUR messages
    # (header, id, and thread linkage untouched). This is what makes live
    # cards possible — a posted ui timeline amends as its run progresses, and
    # every surface just re-parses. Append-only spirit survives: each amend is
    # one git commit, so history holds every version.
    #   stitchpad amend <#m-id> <text...>
    #   stitchpad amend <#m-id> --file <path>
    sp_init_paths || exit 1
    from="$(sp_me)"
    [ -z "$from" ] && { echo "stitchpad: no identity — join first (or set STITCHPAD_NAME)" >&2; exit 1; }
    target="${1:?usage: stitchpad amend <#m-id> <text...|--file <path>>}"; shift
    target="${target#\#}"
    bodyf="$(mktemp)"
    if [ "${1:-}" = "--file" ]; then
      # -r not -f: process substitution (/dev/fd/N) is a legitimate source
      [ -r "${2:-}" ] || { rm -f "$bodyf"; echo "stitchpad: --file needs a readable path" >&2; exit 1; }
      cat "$2" > "$bodyf"
    else
      [ $# -gt 0 ] || { rm -f "$bodyf"; echo "usage: stitchpad amend <#m-id> <text...|--file <path>>" >&2; exit 1; }
      printf '%s' "$*" > "$bodyf"
    fi
    sp_lock || { rm -f "$bodyf"; exit 1; }
    python3 - "$PAD_MD" "$target" "$from" "$bodyf" <<'PY'
import re, sys
pad, mid, who, bodyf = sys.argv[1:5]
lines = open(pad, encoding="utf-8", errors="replace").read().split("\n")
hit = -1
for i, ln in enumerate(lines):
    if not ln.startswith("## @"):
        continue
    segs = [s.strip() for s in ln[3:].split(" · ")]
    if f"#{mid}" in segs:
        hit = i
        author = segs[0].lstrip("@")
        break
if hit < 0:
    sys.exit(2)          # id not found
if author != who:
    sys.exit(3)          # not your message
end = len(lines)
for j in range(hit + 1, len(lines)):
    if lines[j].startswith("## @") or re.match(r"^\*@\S+ reacted ", lines[j]):
        end = j
        break
body = open(bodyf, encoding="utf-8", errors="replace").read().rstrip("\n")
new = lines[:hit + 1] + ["", body, ""] + lines[end:]
open(pad, "w", encoding="utf-8").write("\n".join(new))
PY
    rc=$?
    rm -f "$bodyf"
    case "$rc" in
      0) # Checked commit: an unchecked sp_commit here printed "✓ amended" rc=0
         # even when the commit failed, leaving the rewritten body in the working
         # pad but not in history — and the NEXT successful write then commits it
         # as if it had always been there.
         if ! sp_commit_or_fail "amend: $from #$target"; then
           sp_unlock
           echo "stitchpad: amend NOT recorded — #$target was rewritten in the working pad but the commit did not land" >&2
           exit 1
         fi
         sp_unlock; echo "✓ amended #$target" ;;
      2) sp_unlock; echo "stitchpad: message #$target not found" >&2; exit 1 ;;
      3) sp_unlock; echo "stitchpad: #$target is not your message — only the author amends" >&2; exit 1 ;;
      *) sp_unlock; echo "stitchpad: amend failed" >&2; exit 1 ;;
    esac
    ;;

  run)
    # Execution timeline: run labeled steps and narrate them as ONE live
    # ui timeline message that amends in place as states flip — the agent's
    # run becomes a living card in the room. Stops on first failure and
    # threads the failing output under the timeline as a real artifact.
    #   stitchpad run [--title <t>] <label>=<cmd> [<label>=<cmd> ...]
    sp_init_paths || exit 1
    from="$(sp_me)"
    [ -z "$from" ] && { echo "stitchpad: no identity — join first (or set STITCHPAD_NAME)" >&2; exit 1; }
    title="execution"
    labels=(); cmds=()
    while [ $# -gt 0 ]; do case "$1" in
      --title) title="${2:-execution}"; shift 2 ;;
      *=*) labels+=("${1%%=*}"); cmds+=("${1#*=}"); shift ;;
      *) echo "usage: stitchpad run [--title <t>] <label>=<cmd> [...]" >&2; exit 1 ;;
    esac; done
    [ "${#labels[@]}" -gt 0 ] || { echo "usage: stitchpad run [--title <t>] <label>=<cmd> [...]" >&2; exit 1; }
    n=${#labels[@]}
    states=(); ats=(); notes=()
    for _ in "${labels[@]}"; do states+=("todo"); ats+=(""); notes+=(""); done

    _tl_body() { # $1 = alt line → prints full message body (alt + fence)
      local ev='[]' i
      for i in $(seq 0 $((n - 1))); do
        ev="$(jq -c --arg l "${labels[$i]}" --arg s "${states[$i]}" --arg a "${ats[$i]}" --arg no "${notes[$i]}" \
          '. + [{label:$l, state:$s} + (if $a != "" then {at:$a} else {} end) + (if $no != "" then {note:$no} else {} end)]' <<< "$ev")"
      done
      printf '%s\n\n```ui timeline\n%s\n```' "$1" \
        "$(jq -nc --arg t "$title" --argjson e "$ev" '{title:$t, events:$e}')"
    }

    _amend_tl() { # $1 = alt line → amend the live timeline message
      local f; f="$(mktemp)"
      _tl_body "$1" > "$f"
      STITCHPAD_NAME="$from" "$BIN_DIR/stitchpad" amend "$mid" --file "$f" >/dev/null
      rm -f "$f"
    }

    states[0]="active"
    out="$(STITCHPAD_NAME="$from" "$BIN_DIR/stitchpad" say "$(_tl_body "⏱ $title — running (${n} steps)")")" || exit 1
    mid="$(printf '%s' "$out" | grep -o 'm-[a-z0-9]*' | head -1)"
    [ -n "$mid" ] || { echo "stitchpad: could not capture timeline message id" >&2; exit 1; }

    failed=""
    total_t0=$SECONDS
    for i in $(seq 0 $((n - 1))); do
      states[$i]="active"
      _amend_tl "⏱ $title — running: ${labels[$i]}"
      t0=$SECONDS
      step_out="$(bash -c "${cmds[$i]}" 2>&1)"
      rc=$?
      ats[$i]="$((SECONDS - t0))s"
      if [ $rc -eq 0 ]; then
        states[$i]="done"
      else
        states[$i]="failed"
        notes[$i]="exit $rc"
        failed="${labels[$i]}"
        _amend_tl "⏱ $title — ✕ failed at ${labels[$i]}"
        # the failing output is the artifact — thread it under the timeline
        tail_out="$(printf '%s' "$step_out" | tail -c 2000)"
        STITCHPAD_NAME="$from" "$BIN_DIR/stitchpad" say --re "$mid" "$(printf '%s failed (exit %s) — output tail:\n\n```\n%s\n```' "${labels[$i]}" "$rc" "$tail_out")" >/dev/null
        break
      fi
      _amend_tl "⏱ $title — ${labels[$i]} done"
    done
    if [ -z "$failed" ]; then
      _amend_tl "⏱ $title — ✓ all $n steps green ($((SECONDS - total_t0))s)"
      echo "✓ run complete: $n steps green (#$mid)"
    else
      echo "✕ run failed at $failed (#$mid)"
      exit 1
    fi
    ;;

  drop)
    # Shared files: copy a doc into the pad's dropbox/ (local truth every
    # agent + the TUI shed tab can read), mirror it to the relay when creds
    # exist (so the PWA can view it via /f/…), and post one pad line. The pad
    # line IS the files feed — every surface derives its files view from it.
    #   stitchpad drop <file> [note...]
    sp_init_paths || exit 1
    from="$(sp_me)"
    [ -z "$from" ] && { echo "stitchpad: no identity — join first (or set STITCHPAD_NAME)" >&2; exit 1; }
    src="${1:?usage: stitchpad drop <file> [note...]}"; shift || true
    note="$*"
    [ -f "$src" ] || { echo "stitchpad: file not found: $src" >&2; exit 1; }
    fsize="$(stat -f %z "$src" 2>/dev/null || stat -c %s "$src" 2>/dev/null || echo 0)"
    [ "$fsize" -le $((15 * 1024 * 1024)) ] || { echo "stitchpad: file too large (15MB cap)" >&2; exit 1; }
    fname="$(basename "$src" | tr -d '[]()' | tr ' ' '_')"
    mkdir -p "$PAD_DIR/dropbox"
    cp "$src" "$PAD_DIR/dropbox/$fname"
    # human-readable size
    if [ "$fsize" -ge 1048576 ]; then hsize="$(( fsize / 1048576 ))MB"
    elif [ "$fsize" -ge 1024 ]; then hsize="$(( fsize / 1024 ))KB"
    else hsize="${fsize}B"; fi
    link=""
    relay="${PASTURE_RELAY:-${STITCHPAD_RELAY:-}}"; token="${PASTURE_TOKEN:-${STITCHPAD_TOKEN:-}}"
    if [ -n "$relay" ] && [ -n "$token" ]; then
      pad_name="$(basename "$(dirname "$PAD_DIR")")"
      resp="$(curl -fsS -H "authorization: Bearer $token" -F "file=@$PAD_DIR/dropbox/$fname" "${relay%/}/upload-file?pad=$pad_name" 2>/dev/null || true)"
      key="$(printf '%s' "$resp" | jq -r '.key // empty' 2>/dev/null || true)"
      [ -n "$key" ] && link=" [view](/f/${key#files/})"
    fi
    line="📎 **$fname** · $hsize → dropbox/$fname$link"
    [ -n "$note" ] && line="$line — $note"
    STITCHPAD_NAME="$from" "$BIN_DIR/stitchpad" say "$line"
    ;;

  react)
    # React to a message: an append-only system line other surfaces aggregate
    # into chips under the target. Never wakes anyone (system lines don't trip
    # mention detection) — a reaction is an ack, not a prompt.
    #   stitchpad react <#m-id> <emoji-or-word>
    sp_init_paths || exit 1
    from="$(sp_me)"
    [ -z "$from" ] && { echo "stitchpad: no identity — join first (or set STITCHPAD_NAME)" >&2; exit 1; }
    target="${1:?usage: stitchpad react <#m-id> <emoji>}"
    emoji="${2:?usage: stitchpad react <#m-id> <emoji>}"
    target="#${target#\#}"
    [ "$(printf '%s' "$emoji" | wc -c)" -le 24 ] || { echo "stitchpad: reaction too long" >&2; exit 1; }
    sp_lock || exit 1
    grep -q "· $target" "$PAD_MD" 2>/dev/null || { sp_unlock; echo "stitchpad: message $target not found" >&2; exit 1; }
    # Toggle-off: reacting again with the same emoji removes the earlier line.
    _rline="$(grep -nF "*@$from reacted $emoji to $target" "$PAD_MD" 2>/dev/null | head -1 | cut -d: -f1)"
    if [ -n "$_rline" ]; then
      sed -i '' "${_rline}d" "$PAD_MD" 2>/dev/null || sed -i "${_rline}d" "$PAD_MD"
      # sp_commit, not sp_commit_or_fail, meant a failed commit still printed ✓
      # and exited 0 — the working pad silently diverging from its own history
      # while the author is told it landed. say/rename/restore-roster all use the
      # checked form; react and amend were the two that did not.
      if ! sp_commit_or_fail "react: $from -$emoji $target"; then
        sp_unlock
        echo "stitchpad: reaction NOT recorded — the pad file changed but the commit did not land" >&2
        exit 1
      fi
      sp_unlock
      echo "✓ un-reacted $emoji"
    else
      sp_system "@$from reacted $emoji to $target"
      if ! sp_commit_or_fail "react: $from $emoji $target"; then
        sp_unlock
        echo "stitchpad: reaction NOT recorded — the pad file changed but the commit did not land" >&2
        exit 1
      fi
      sp_unlock
      echo "✓ reacted $emoji to $target"
    fi
    ;;

  claim)
    # File-write lease: agents share one worktree, so a PreToolUse hook calls this
    # before Edit/Write to stop two agents clobbering the same file.
    #   stitchpad claim <file>     try to lease <file> for the current identity
    #   stitchpad release [file]   release one file (or all my claims if omitted)
    #   stitchpad claims           print the live who-holds-what map
    # Lease = .state/claims/<encoded-path> holding "<name> <epoch>". A claim by ME or
    # an UNHELD/STALE (>600s) file succeeds (exit 0); a fresh claim by someone else
    # fails (exit 1) and auto-queues a pad ping so the holder knows to release.
    sp_init_paths || exit 1
    me="$(sp_me)"
    [ -z "$me" ] && { echo "stitchpad: no identity (set STITCHPAD_NAME or join)" >&2; exit 2; }
    file="${1:?usage: stitchpad claim <file>}"
    # normalize to an absolute path, then encode to a flat filename
    abs="$(cd "$(dirname "$file")" 2>/dev/null && pwd)/$(basename "$file")" || abs="$file"
    enc="$(printf '%s' "$abs" | tr '/' '_' | tr -cd '[:alnum:]_.-')"
    cdir="$PAD_STATE/claims"; mkdir -p "$cdir"
    # The lease is a per-file LOCK DIR (mkdir is atomic on every POSIX fs), with the
    # holder/ts/path written INSIDE after the acquire wins. This closes the TOCTOU
    # that a plain `[ -f ] then > file` had — two agents can't both create the dir.
    # (mark/larry's catch: the earlier read-then-write was racy; this is the fix.)
    # NOTE: still ADVISORY — it only serializes writers that go through `claim`; the
    # PreToolUse hook is the actual enforcement, git is the backstop.
    lockd="$cdir/$enc.d"; meta="$lockd/holder"
    now="$(date +%s)"; stale=600
    # peek current holder (for the refresh / deny / steal decision)
    holder=""; ts=0; _hpath=""
    # holder file has 3 fields "name ts path" — read all 3 so the path doesn't
    # bleed into $ts (which then breaks the arithmetic below under set -u).
    [ -f "$meta" ] && read -r holder ts _hpath < "$meta" 2>/dev/null || true
    if [ "$holder" = "$me" ]; then
      printf '%s %s %s\n' "$me" "$now" "$abs" > "$meta"   # refresh my own lease
      echo "✓ @$me holds $(basename "$abs")"; exit 0
    fi
    age=$(( now - ${ts:-0} ))
    if [ -n "$holder" ] && [ "$age" -lt "$stale" ]; then
      echo "✗ @$holder holds $(basename "$abs") (${age}s ago) — denied" >&2
      STITCHPAD_NAME="$me" "$BIN_DIR/stitchpad" say "@$holder heads up — @$me is waiting on \`$(basename "$abs")\`; ping me when you release it." >/dev/null 2>&1 || true
      exit 1
    fi
    # unheld or stale → ATOMIC acquire via mkdir. If a stale dir exists, clear it first.
    [ -n "$holder" ] && { echo "(stealing stale lease from @$holder, ${age}s idle)" >&2; rm -rf "$lockd"; }
    if mkdir "$lockd" 2>/dev/null; then
      printf '%s %s %s\n' "$me" "$now" "$abs" > "$meta"
      echo "✓ @$me claimed $(basename "$abs")"; exit 0
    else
      # lost the race to a concurrent claimer — re-read and deny
      [ -f "$meta" ] && read -r holder _ < "$meta" 2>/dev/null || holder="another agent"
      echo "✗ @$holder won the race for $(basename "$abs") — denied" >&2
      exit 1
    fi
    ;;

  release)
    sp_init_paths || exit 1
    me="$(sp_me)"; [ -z "$me" ] && exit 0
    cdir="$PAD_STATE/claims"; [ -d "$cdir" ] || exit 0
    if [ -n "${1:-}" ]; then
      abs="$(cd "$(dirname "$1")" 2>/dev/null && pwd)/$(basename "$1")" || abs="$1"
      enc="$(printf '%s' "$abs" | tr '/' '_' | tr -cd '[:alnum:]_.-')"
      lockd="$cdir/$enc.d"
      [ -f "$lockd/holder" ] && read -r h _ < "$lockd/holder" && [ "$h" = "$me" ] && rm -rf "$lockd" && echo "✓ released $(basename "$abs")"
    else
      # release ALL files I hold (called from the Stop hook at turn end)
      for lockd in "$cdir"/*.d; do
        [ -d "$lockd" ] || continue
        read -r h _ < "$lockd/holder" 2>/dev/null || continue
        [ "$h" = "$me" ] && rm -rf "$lockd"
      done
      echo "✓ released all @$me claims"
    fi
    exit 0
    ;;

  claims)
    # Live who-holds-what map (for TUI/PWA telemetry + debugging).
    sp_init_paths || exit 1
    cdir="$PAD_STATE/claims"; [ -d "$cdir" ] || { echo "(no active claims)"; exit 0; }
    now="$(date +%s)"; any=0
    for lockd in "$cdir"/*.d; do
      [ -d "$lockd" ] || continue
      read -r h ts path < "$lockd/holder" 2>/dev/null || continue
      any=1; age=$(( now - ${ts:-0} ))
      printf '  @%-8s %4ss ago  %s\n' "$h" "$age" "${path:-$(basename "$lockd" .d | tr '_' '/')}"
    done
    [ "$any" -eq 0 ] && echo "(no active claims)"
    exit 0
    ;;

  heartbeat)
    # Per-agent terminal keep-alive.
    #   stitchpad heartbeat start [name]   start/refresh bg ticker
    #   stitchpad heartbeat --touch [name] [pid]   one-shot touch (Stop hook backup)
    #   stitchpad heartbeat --stop [name]  stop ticker + remove alive file
    # The ticker writes .state/alive.<name> JSON every N seconds. Consumers treat
    # ONLINE as: alive file mtime <90s AND kill -0 .pid succeeds.
    sp_init_paths || exit 1
    sub="${1:-start}"; shift || true

    heartbeat_write() {
      local who="$1" pid="$2" parent="$3" session="$4" surface="$5" target="$6" generation="${7:-}"
      local alive="$PAD_STATE/alive.$who" tmp="$PAD_STATE/.alive.$who.$$"
      python3 - "$who" "$pid" "$parent" "$session" "$surface" "$target" "$generation" > "$tmp" <<'PY'
import json, sys, time
name, pid, parent, session, surface, target, generation = sys.argv[1:8]
def num(v):
    try:
        return int(v)
    except Exception:
        return 0
print(json.dumps({
    "name": name,
    "ts": int(time.time()),
    "pid": num(pid),
    "parentPid": num(parent),
    "session": session,
    "surface": surface,
    "target": target,
    "generation": generation,
}, separators=(",", ":")))
PY
      mv "$tmp" "$alive"
    }

    heartbeat_existing_pid() {
      local who="$1" alive="$PAD_STATE/alive.$who" pid=""
      [ -f "$alive" ] || return 1
      pid="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("pid",""))' "$alive" 2>/dev/null || true)"
      [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null || return 1
      printf '%s\n' "$pid"
    }

    case "$sub" in
      start)
        who="${1:-$(sp_me)}"
        [ -n "$who" ] || { echo "stitchpad: no identity" >&2; exit 2; }
        export STITCHPAD_NAME="$who"
        interval="${STITCHPAD_HEARTBEAT_INTERVAL:-30}"
        lockd="$PAD_STATE/heartbeat.$who.lock"
        mkdir -p "$PAD_STATE"
        if [ -d "$lockd" ]; then
          generation="$(cat "$lockd/generation" 2>/dev/null || true)"
          if [ -z "$generation" ]; then
            _hb_now="$(date +%s)"
            _hb_mtime="$(stat -f %m "$lockd" 2>/dev/null || stat -c %Y "$lockd" 2>/dev/null || echo "$_hb_now")"
            if [ -z "$(find "$lockd" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null)" ]; then
              if [ $((_hb_now - _hb_mtime)) -lt "${STITCHPAD_HEARTBEAT_START_GRACE:-5}" ]; then
                echo "heartbeat already starting for @$who"
                exit 0
              fi
              rmdir "$lockd" 2>/dev/null || exit 1
            else
              sp_ticker_stop_owned "$who" || exit 1
            fi
          elif sp_generation_is_safe "$generation" \
            && [ ! -e "$lockd/launcher" ] \
            && [ -z "$(find "$lockd" -mindepth 1 -maxdepth 1 ! -name generation -print -quit 2>/dev/null)" ]; then
            _hb_now="$(date +%s)"
            _hb_mtime="$(stat -f %m "$lockd" 2>/dev/null || stat -c %Y "$lockd" 2>/dev/null || echo "$_hb_now")"
            if [ $((_hb_now - _hb_mtime)) -lt "${STITCHPAD_HEARTBEAT_START_GRACE:-5}" ]; then
              echo "heartbeat already starting for @$who"
              exit 0
            fi
            rm -f "$lockd/generation" 2>/dev/null || true
            rmdir "$lockd" 2>/dev/null || exit 1
          fi
        fi
        if [ -d "$lockd" ]; then
          generation="$(cat "$lockd/generation" 2>/dev/null || true)"
          if [ -n "$generation" ] && sp_ticker_manifest_is_valid "$lockd/launcher" "$generation" "$who"; then
            if [ "$(cat "$lockd/cancel" 2>/dev/null || true)" = "$generation" ]; then
              echo "stitchpad: heartbeat @$who is stopping; retry shortly" >&2
              exit 1
            fi
            if [ -f "$lockd/owner" ]; then
              if ! sp_ticker_manifest_is_valid "$lockd/owner" "$generation" "$who"; then
                echo "stitchpad: malformed heartbeat @$who owner left untouched" >&2
                exit 1
              fi
              oldpid="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["pid"])' "$lockd/owner" 2>/dev/null || true)"
              if sp_ticker_owner_matches "$lockd" "$generation" "$oldpid" "$who"; then
                echo "heartbeat already running for @$who (pid $oldpid)"
                exit 0
              fi
              # A valid manifest whose exact identity no longer matches is a
              # dead generation, even if the numeric PID has been reused.
            elif sp_ticker_manifest_is_live "$lockd/launcher" "$generation" "$who"; then
              echo "heartbeat already starting for @$who"
              exit 0
            fi
            retired="$(sp_ticker_retire_generation "$lockd" "$generation")" || exit 1
            sp_ticker_alive_remove_generation "$who" "$generation"
            sp_ticker_retired_cleanup "$retired" || true
          else
            # Preserve unknown live legacy evidence; reclaim only a dead,
            # known-shape predecessor through the same stop helper.
            sp_ticker_stop_owned "$who" || exit 1
          fi
        fi
        if ! mkdir "$lockd" 2>/dev/null; then
          # A concurrent winner owns the canonical name. Re-enter once so its
          # durable launcher/owner decides the result; never delete it here.
          sleep 0.05
          exec "$BIN_DIR/stitchpad" heartbeat start "$who"
        fi
        if [ -n "${STITCHPAD_HEARTBEAT_TEST_AFTER_MKDIR_BARRIER:-}" ]; then
          _hb_mkdir_barrier="$STITCHPAD_HEARTBEAT_TEST_AFTER_MKDIR_BARRIER"
          printf '%s' ready > "$_hb_mkdir_barrier.ready"
          while [ ! -f "$_hb_mkdir_barrier.release" ]; do sleep 0.01; done
        fi
        generation="$(date +%s).$$.${RANDOM:-0}"
        generation_tmp="$PAD_STATE/.heartbeat-generation.$$.$RANDOM"
        printf '%s' "$generation" > "$generation_tmp" \
          && mv "$generation_tmp" "$lockd/generation" || {
            rm -f "$generation_tmp" 2>/dev/null || true
            rmdir "$lockd" 2>/dev/null || true
            exit 1
          }
        if ! sp_ticker_launcher_claim "$lockd" "$generation" "$who"; then
          retired="$(sp_ticker_retire_generation "$lockd" "$generation" 2>/dev/null || true)"
          [ -z "$retired" ] || sp_ticker_retired_cleanup "$retired" 2>/dev/null || true
          echo "stitchpad: could not publish heartbeat launcher for @$who" >&2
          exit 1
        fi
        if [ -n "${STITCHPAD_HEARTBEAT_TEST_AFTER_LAUNCHER_BARRIER:-}" ]; then
          _hb_barrier="$STITCHPAD_HEARTBEAT_TEST_AFTER_LAUNCHER_BARRIER"
          printf '%s' ready > "$_hb_barrier.ready"
          while [ ! -f "$_hb_barrier.release" ]; do
            [ "$(cat "$lockd/cancel" 2>/dev/null || true)" != "$generation" ] || exit 1
            sleep 0.01
          done
        fi
        [ "$(cat "$lockd/cancel" 2>/dev/null || true)" != "$generation" ] || exit 1
        parent="${STITCHPAD_HEARTBEAT_PARENT_PID:-$PPID}"
        session="${STITCHPAD_SESSION:-}"
        # SURFACE PRIORITY: the ROSTER TARGET is authoritative — it says where
        # this agent actually lives. The caller's own pane comes LAST: heartbeat
        # starts frequently run on the agent's BEHALF from someone else's pane
        # (watcher, wake adapter cold-start, operator shell), and capturing the
        # caller's pane stamped agents with foreign terminals, which auto-heal
        # then faithfully wrote into the roster (the codex-wakes-to-the-
        # operator bug).
        surface=""; target=""
        roster_target="$(sp_user_field "$who" target 2>/dev/null || true)"
        if [ -n "$roster_target" ] && [ "$roster_target" != "-" ]; then
          surface="${roster_target##*@@}"
          target="$roster_target"
          [ -z "${STITCHPAD_HEARTBEAT_PARENT_PID:-}" ] && parent=""
        else
          surface="$(sp_this_surface)"
          [ -n "$surface" ] && target="$surface"
        fi
        (
          # Bash 3.2 has no BASHPID. A direct child reports this background
          # shell as its PPID, giving the ticker its real process identity.
          ticker_pid="$(python3 -c 'import os; print(os.getppid())')"
          _hb_sleep_pid=""
          _hb_sleep_start=""
          _hb_sleep_command=""
          heartbeat_child_cleanup() {
            # TERM interrupts the shell's wait but does not terminate its
            # background sleep. Reap only the exact child identity this ticker
            # observed, so stop/reset cannot leave it orphaned under PID 1 or
            # signal a reused/foreign PID.
            if [ -n "$_hb_sleep_pid" ] \
              && sp_process_identity_matches "$_hb_sleep_pid" "$_hb_sleep_start" "$_hb_sleep_command"; then
              kill "$_hb_sleep_pid" 2>/dev/null || true
              wait "$_hb_sleep_pid" 2>/dev/null || true
            fi
            _hb_sleep_pid=""
            _hb_sleep_start=""
            _hb_sleep_command=""
            if sp_ticker_owner_matches "$lockd" "$generation" "$ticker_pid" "$STITCHPAD_NAME"; then
              sp_ticker_alive_remove_generation "$STITCHPAD_NAME" "$generation"
              _hb_owner_observed="$(cat "$lockd/owner" 2>/dev/null || true)"
              [ -n "$_hb_owner_observed" ] \
                && [ "$(cat "$lockd/owner" 2>/dev/null || true)" = "$_hb_owner_observed" ] \
                && rm -f "$lockd/owner" "$lockd/pid" 2>/dev/null || true
              if [ "$(cat "$lockd/cancel" 2>/dev/null || true)" != "$generation" ] \
                && ! sp_ticker_manifest_is_live "$lockd/launcher" "$generation" "$STITCHPAD_NAME"; then
                sp_ticker_generation_cleanup "$lockd" "$generation" 2>/dev/null || true
              fi
            fi
          }
          trap 'heartbeat_child_cleanup' EXIT
          trap 'exit 0' HUP INT TERM
          if [ -n "${STITCHPAD_HEARTBEAT_TEST_BEFORE_OWNER_BARRIER:-}" ]; then
            _hb_child_barrier="$STITCHPAD_HEARTBEAT_TEST_BEFORE_OWNER_BARRIER"
            printf '%s' ready > "$_hb_child_barrier.ready"
            while [ ! -f "$_hb_child_barrier.release" ]; do
              [ "$(cat "$lockd/generation" 2>/dev/null || true)" = "$generation" ] || exit 1
              [ "$(cat "$lockd/cancel" 2>/dev/null || true)" != "$generation" ] || exit 1
              sleep 0.01
            done
          fi
          [ "$(cat "$lockd/cancel" 2>/dev/null || true)" != "$generation" ] || exit 1
          sp_ticker_owner_claim "$lockd" "$generation" "$ticker_pid" "$STITCHPAD_NAME" || exit 1
          [ "$(cat "$lockd/cancel" 2>/dev/null || true)" != "$generation" ] || exit 1
          if [ -n "${STITCHPAD_HEARTBEAT_TEST_AFTER_OWNER_BARRIER:-}" ]; then
            _hb_owner_barrier="$STITCHPAD_HEARTBEAT_TEST_AFTER_OWNER_BARRIER"
            printf '%s' ready > "$_hb_owner_barrier.ready"
            while [ ! -f "$_hb_owner_barrier.release" ]; do
              sp_ticker_owner_matches "$lockd" "$generation" "$ticker_pid" "$STITCHPAD_NAME" || exit 1
              [ "$(cat "$lockd/cancel" 2>/dev/null || true)" != "$generation" ] || exit 1
              sleep 0.01
            done
          fi
          _hb_pid_tmp="$PAD_STATE/.heartbeat-pid.$ticker_pid.$RANDOM"
          printf '%s' "$ticker_pid" > "$_hb_pid_tmp"
          if sp_ticker_owner_matches "$lockd" "$generation" "$ticker_pid" "$STITCHPAD_NAME" \
            && [ "$(cat "$lockd/cancel" 2>/dev/null || true)" != "$generation" ]; then
            mv "$_hb_pid_tmp" "$lockd/pid"
          else
            rm -f "$_hb_pid_tmp" 2>/dev/null || true
            exit 1
          fi
          while :; do
            sp_ticker_owner_matches "$lockd" "$generation" "$ticker_pid" "$STITCHPAD_NAME" || exit 0
            [ "$(cat "$lockd/cancel" 2>/dev/null || true)" != "$generation" ] || exit 0
            heartbeat_write "$STITCHPAD_NAME" "$ticker_pid" "$parent" "$session" "$surface" "$target" "$generation"
            sp_term_lock_touch "$surface" "$STITCHPAD_NAME" 2>/dev/null || true
            "$BIN_DIR/stitchpad" ensure-watcher >/dev/null 2>&1 || true
            sleep "$interval" &
            _hb_sleep_pid=$!
            _hb_sleep_start="$(sp_process_start "$_hb_sleep_pid")"
            _hb_sleep_command="$(sp_process_command "$_hb_sleep_pid")"
            wait "$_hb_sleep_pid" || exit 0
            _hb_sleep_pid=""
            _hb_sleep_start=""
            _hb_sleep_command=""
            [ -n "$parent" ] && ! kill -0 "$parent" 2>/dev/null && exit 0
          done
        ) &
        ticker_pid=$!
        _hb_wait=0
        while ! sp_ticker_owner_matches "$lockd" "$generation" "$ticker_pid" "$who"; do
          kill -0 "$ticker_pid" 2>/dev/null || break
          [ "$_hb_wait" -lt 200 ] || break
          sleep 0.01; _hb_wait=$((_hb_wait + 1))
        done
        if ! sp_ticker_owner_matches "$lockd" "$generation" "$ticker_pid" "$who"; then
          kill "$ticker_pid" 2>/dev/null || true
          wait "$ticker_pid" 2>/dev/null || true
          if [ "$(cat "$lockd/cancel" 2>/dev/null || true)" != "$generation" ]; then
            retired="$(sp_ticker_retire_generation "$lockd" "$generation" 2>/dev/null || true)"
            [ -z "$retired" ] || sp_ticker_retired_cleanup "$retired" 2>/dev/null || true
          fi
          echo "stitchpad: could not record verified heartbeat ownership for @$who" >&2
          exit 1
        fi
        disown
        echo "heartbeat started for @$who"
        ;;
      --touch|touch)
        who="${1:-$(sp_me)}"; shift || true
        [ -n "$who" ] || exit 0
        pid="${1:-}"
        if [ -z "$pid" ]; then
          pid="$(heartbeat_existing_pid "$who" 2>/dev/null || true)"
        fi
        [ -n "$pid" ] || pid="$$"
        # roster target first — same reasoning as heartbeat start: --touch is
        # routinely called from panes that are not the agent's own.
        _surface=""; _target=""
        _rt="$(sp_user_field "$who" target 2>/dev/null || true)"
        if [ -n "$_rt" ] && [ "$_rt" != "-" ]; then
          _surface="${_rt##*@@}"; _target="$_rt"
        else
          _surface="$(sp_this_surface)"
          [ -n "$_surface" ] && _target="$_surface"
        fi
        _touch_generation=""
        _touch_lock="$PAD_STATE/heartbeat.$who.lock"
        if [ -d "$_touch_lock" ]; then
          _touch_generation="$(cat "$_touch_lock/generation" 2>/dev/null || true)"
          _touch_owner_pid="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["pid"])' "$_touch_lock/owner" 2>/dev/null || true)"
          [ "$pid" = "$_touch_owner_pid" ] \
            && sp_ticker_owner_matches "$_touch_lock" "$_touch_generation" "$pid" "$who" \
            && [ "$(cat "$_touch_lock/cancel" 2>/dev/null || true)" != "$_touch_generation" ] \
            || exit 1
        fi
        heartbeat_write "$who" "$pid" "${STITCHPAD_HEARTBEAT_PARENT_PID:-$PPID}" "${STITCHPAD_SESSION:-}" "$_surface" "$_target" "$_touch_generation"
        ;;
      --stop|stop)
        who="${1:-$(sp_me)}"
        [ -n "$who" ] || exit 0
        sp_ticker_stop_owned "$who" || exit 1
        echo "heartbeat stopped for @$who"
        ;;
      *)
        echo "usage: stitchpad heartbeat {start|--touch|--stop} [name]" >&2
        exit 1
        ;;
    esac
    exit 0
    ;;

  ensure-watcher)
    # Ensure the watcher singleton is running. Idempotent: no-ops if a watcher
    # already holds the lock or no agents have fresh heartbeats.
    sp_init_paths || exit 1
    ensure_watcher
    exit $?
    ;;

  meta)
    # Runtime/model metadata used by TUI clients.
    #   stitchpad meta set <name> <runtime|harness|model> <value...>
    #   stitchpad meta get <name> <runtime|harness|model>
    sp_init_paths || exit 1
    sub="${1:-}"; shift || true
    case "$sub" in
      set)
        who="${1:?usage: stitchpad meta set <name> <runtime|harness|model> <value...>}"
        key="${2:?metadata key required}"
        shift 2 || true
        case "$key" in
          runtime|harness|model) ;;
          *) echo "stitchpad: metadata key must be runtime, harness, or model" >&2; exit 1 ;;
        esac
        value="$*"
        [ -n "$value" ] || { echo "stitchpad: metadata value required" >&2; exit 1; }
        printf '%s' "$value" > "$PAD_STATE/$key.$who"
        echo "✓ @$who $key=$value"
        ;;
      get)
        who="${1:?usage: stitchpad meta get <name> <runtime|harness|model>}"
        key="${2:?metadata key required}"
        case "$key" in
          runtime|harness|model) ;;
          *) echo "stitchpad: metadata key must be runtime, harness, or model" >&2; exit 1 ;;
        esac
        cat "$PAD_STATE/$key.$who" 2>/dev/null || true
        ;;
      *)
        echo "usage: stitchpad meta set|get <name> <runtime|harness|model> [value]" >&2
        exit 1
        ;;
    esac
    ;;

  read)
    sp_init_paths_readonly || exit 1
    # --new: DELTA read — the pad is GIT-VERSIONED (every write is a commit),
    # so "unread" is the diff since the commit this agent last acknowledged
    # (.state/readref.<name>). Unlike plain `read` and the diagnostic commands,
    # `read --new` intentionally advances only that per-agent acknowledgement.
    # Git handles mid-file rewrites
    # that break line-number cursors, and an append-only pad diffs to pure
    # additions. Capped at 400 lines; falls back to the tail window when
    # unidentified or the pad has no git.
    if [ "${1:-}" = "--new" ]; then
      _me="$(sp_me)"
      _head="$(sgit rev-parse HEAD 2>/dev/null || true)"
      if [ -n "$_me" ] && [ -n "$_head" ]; then
        case "$_me" in *[!abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-]*) echo "stitchpad: invalid identity for read cursor" >&2; exit 1 ;; esac
        # E-17: roster handles can exceed 255 bytes (filesystem name limit).
        # Hash the identity so the cursor key is always a fixed safe length,
        # regardless of handle length.  Once broken by a long handle the
        # cursor could never be written again; the hash prevents that.
        _me_key="$(printf '%s' "$_me" | shasum -a 256 | cut -d' ' -f1 | cut -c1-16)"
        [ ! -L "$PAD_STATE" ] || { echo "stitchpad: refusing symlinked read cursor directory" >&2; exit 1; }
        [ ! -L "$PAD_STATE/readref.$_me_key" ] \
          || { echo "stitchpad: refusing symlinked read cursor" >&2; exit 1; }
        _ref="$(cat "$PAD_STATE/readref.$_me_key" 2>/dev/null || true)"
        sgit cat-file -e "${_ref}^{commit}" 2>/dev/null || _ref=""
        if [ "$_ref" = "$_head" ]; then echo "(nothing new since your last read)"; exit 0; fi
        if [ -n "$_ref" ]; then
          # added lines only, diff metadata stripped — reads as normal pad text
          _out="$(sgit diff "$_ref..$_head" -- stitchpad.md 2>/dev/null \
            | sed -n -e '/^+++/d' -e 's/^+//p')"
        else
          _out="$(tail -n 80 "$PAD_MD")"   # first read: bounded window, not history
        fi
        _cnt="$(printf '%s\n' "$_out" | wc -l | tr -d ' ')"
        if [ "$_cnt" -gt 400 ]; then
          echo "(…$(( _cnt - 400 )) older unread lines skipped — 400-line cap)"
          _out="$(printf '%s\n' "$_out" | tail -n 400)"
        fi
        printf '%s\n' "$_out"
        mkdir -p "$PAD_STATE" || { echo "stitchpad: cannot create read cursor directory" >&2; exit 1; }
        _rr_tmp="$(mktemp "$PAD_STATE/.readref.$_me_key.XXXXXX")" \
          || { echo "stitchpad: cannot stage read cursor" >&2; exit 1; }
        if printf '%s' "$_head" > "$_rr_tmp" && mv -f "$_rr_tmp" "$PAD_STATE/readref.$_me_key"; then
          :
        else
          rm -f "$_rr_tmp" 2>/dev/null
          echo "stitchpad: cannot advance read cursor" >&2
          exit 1
        fi
        exit 0
      fi
      tail -n 80 "$PAD_MD"; exit 0
    fi
    # --range A-B: chapter-style read of an exact line span (cheap permalink:
    # cite regions as [1443-1565] and anyone can pull just that slice)
    if [ "${1:-}" = "--range" ]; then
      _r="${2:?usage: stitchpad read --range <start>-<end> [--gen G]}"
      _a="${_r%%-*}"; _b="${_r##*-}"
      case "$_a$_b" in *[!0-9]*) echo "stitchpad: bad range '$_r' (want e.g. 1443-1565)" >&2; exit 1;; esac
      [ $(( _b - _a )) -gt 600 ] && _b=$(( _a + 600 ))   # cap: no flood via range
      # --gen G: replay a line-cite against the exact pre-compaction snapshot
      # (compaction renumbers the live pad; old citations name a generation)
      if [ "${3:-}" = "--gen" ] && [ -n "${4:-}" ]; then
        /usr/bin/sqlite3 "$PAD_STATE/archive.sqlite" "SELECT full_text FROM snapshots WHERE gen=${4//[!0-9]/};" 2>/dev/null | sed -n "${_a},${_b}p"
        exit 0
      fi
      sed -n "${_a},${_b}p" "$PAD_MD"
      exit 0
    fi
    n=80; [ "${1:-}" = "-n" ] && n="$2"
    tail -n "$n" "$PAD_MD"
    ;;

  dm)
    # True DM — bypasses the pad entirely. Every DM pair gets its own sqlite DB
    # (.state/dm/<a>~<b>.sqlite) so BOTH sides of the conversation are readable
    # locally; outbound also queues into .state/dmout.jsonl for the relay bridge
    # (phone pair log + notification). Inbound (phone → agent) is recorded by
    # the bridge via `dm record`. NEVER lands on the pad.
    #   stitchpad dm say <@handle> <text...>     send (also: dm <@handle> <text...>)
    #   stitchpad dm read <@handle> [-n N]       your conversation with them
    #   stitchpad dm list                        pairs you have history with
    #   stitchpad dm record <from> <to> <text>   internal: bridge writes inbound
    sp_init_paths || exit 1
    # C3 (rc1): handles reach this path UNVALIDATED from the wire (relay /dm
    # → bridge → dm record) and from MCP dm_say — '../../evil' traversed out
    # of .state/dm and wrote sqlite files at attacker-chosen paths. Strict
    # allowlist BEFORE any path construction; same grammar as join names.
    _dm_handle_ok() { printf '%s' "$1" | grep -qE '^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$'; }
    _dm_db() {  # sorted pair → one canonical db per conversation
      local a="$1" b="$2" lo hi
      if ! _dm_handle_ok "$a" || ! _dm_handle_ok "$b"; then
        echo "stitchpad: invalid DM handle (allowed: [A-Za-z0-9_-], 1-32 chars, no path characters)" >&2
        return 1
      fi
      if [ "$a" \< "$b" ]; then lo="$a"; hi="$b"; else lo="$b"; hi="$a"; fi
      mkdir -p "$PAD_STATE/dm"
      printf '%s' "$PAD_STATE/dm/$lo~$hi.sqlite"
    }
    _dm_q() { printf '%s' "$1" | sed "s/'/''/g"; }
    _dm_insert() { # db at sender recipient text
      /usr/bin/sqlite3 "$1" \
        "CREATE TABLE IF NOT EXISTS messages(id INTEGER PRIMARY KEY AUTOINCREMENT, at INTEGER NOT NULL, sender TEXT NOT NULL, recipient TEXT NOT NULL, text TEXT NOT NULL);
         INSERT INTO messages(at,sender,recipient,text) VALUES($2,'$(_dm_q "$3")','$(_dm_q "$4")','$(_dm_q "$5")');"
    }
    sub="${1:-}"
    case "$sub" in
      say|read|list|record) shift || true ;;
      *) sub="say" ;;   # backcompat: stitchpad dm <@handle> <text...>
    esac
    case "$sub" in
      say)
        who="$(sp_me)"
        [ -z "$who" ] && { echo "stitchpad: no identity — call the MCP join tool first (or set STITCHPAD_NAME)" >&2; exit 1; }
        to="${1:?usage: stitchpad dm say <@handle> <text...>}"; shift || true
        to="${to#@}"
        text="$*"
        [ -z "$text" ] && { echo "stitchpad: empty message" >&2; exit 1; }
        _at="$(date +%s)000"
        _db="$(_dm_db "$who" "$to")" || exit 1
        _dm_insert "$_db" "$_at" "$who" "$to" "$text"
        jq -nc --arg f "$who" --arg t "$to" --arg x "$text" '{from:$f,to:$t,text:$x,at:(now*1000|floor)}' >> "$PAD_STATE/dmout.jsonl" \
          && echo "✓ DM → @$to (private — recorded locally, relayed to their surface; NOT on the pad)"
        ;;
      record)
        _from="${1:?usage: stitchpad dm record <from> <to> <text...>}"; shift || true
        _to="${1:?usage: stitchpad dm record <from> <to> <text...>}"; shift || true
        _text="$*"
        [ -z "$_text" ] && exit 0
        _db="$(_dm_db "$_from" "$_to")" || exit 1
        _dm_insert "$_db" "$(date +%s)000" "$_from" "$_to" "$_text"
        ;;
      read)
        who="$(sp_me)"
        [ -z "$who" ] && { echo "stitchpad: no identity — set STITCHPAD_NAME or join first" >&2; exit 1; }
        with="${1:?usage: stitchpad dm read <@handle> [-n N]}"; shift || true
        with="${with#@}"
        n=30; [ "${1:-}" = "-n" ] && n="${2:-30}"
        db="$(_dm_db "$who" "$with")" || exit 1
        [ -f "$db" ] || { echo "(no DM history with @$with)"; exit 0; }
        /usr/bin/sqlite3 -separator '|' "$db" \
          "SELECT at,sender,text FROM (SELECT * FROM messages ORDER BY id DESC LIMIT $n) ORDER BY id ASC;" \
          | while IFS='|' read -r _at _s _rest; do
              printf '[%s] @%s: %s\n' "$(date -r "$(( _at / 1000 ))" '+%m-%d %H:%M' 2>/dev/null || date -d "@$(( _at / 1000 ))" '+%m-%d %H:%M' 2>/dev/null || echo '?')" "$_s" "$_rest"
            done
        ;;
      list)
        [ -d "$PAD_STATE/dm" ] || { echo "(no DMs yet)"; exit 0; }
        for db in "$PAD_STATE"/dm/*.sqlite; do
          [ -f "$db" ] || continue
          pair="$(basename "$db" .sqlite)"
          info="$(/usr/bin/sqlite3 "$db" "SELECT COUNT(*) || ' msgs, last ' || datetime(MAX(at)/1000,'unixepoch','localtime') FROM messages;" 2>/dev/null)"
          printf '%s — %s\n' "${pair/\~/ ↔ }" "$info"
        done
        ;;
    esac
    ;;

  dnd)
    # Local wake suppression for the current agent.
    #   stitchpad dnd on
    #   stitchpad dnd off [--drain]
    #   stitchpad dnd status [name]
    # While DND is on, wake delivery is silent and .state/seen.<name> is not
    # advanced, so unread mentions queue behind the existing seen cursor.
    sp_init_paths || exit 1
    sub="${1:-status}"; shift || true
    case "$sub" in
      on)
        # DND is per-agent and always applies to the CALLER. It used to ACCEPT and
        # silently ignore a name: `dnd on bob` printed "✓ DND on for @ec" and
        # silenced @ec. You believe you muted a teammate; you muted yourself, and
        # it said ✓. Refuse instead — silently doing something other than what was
        # asked is the worst available behaviour.
        if [ -n "${1:-}" ]; then
          echo "stitchpad: 'dnd on' takes no name — it always applies to YOU (@$(sp_me 2>/dev/null || echo '<no identity>'))." >&2
          echo "  to silence @${1}, run 'stitchpad dnd on' as that seat." >&2
          exit 2
        fi
        who="$(sp_me)"
        [ -z "$who" ] && { echo "stitchpad: no identity — call the MCP join tool first (or set STITCHPAD_NAME for CLI/testing)" >&2; exit 1; }
        touch "$(sp_dnd_file "$who")"
        echo "✓ DND on for @$who"
        ;;
      off)
        drain=0
        if [ "${1:-}" = "--drain" ]; then drain=1; shift || true; fi
        who="$(sp_me)"
        [ -z "$who" ] && { echo "stitchpad: no identity — call the MCP join tool first (or set STITCHPAD_NAME for CLI/testing)" >&2; exit 1; }
        rm -f "$(sp_dnd_file "$who")"
        echo "✓ DND off for @$who"
        [ "$drain" -eq 1 ] && "$0" wake "$who"
        ;;
      status)
        who="${1:-}"
        [ -z "$who" ] && who="$(sp_me)"
        [ -z "$who" ] && { echo "stitchpad: no identity — call the MCP join tool first (or set STITCHPAD_NAME for CLI/testing)" >&2; exit 1; }
        if sp_dnd_is_on "$who"; then echo "on"; else echo "off"; fi
        ;;
      *)
        echo "usage: stitchpad dnd on|off [--drain]|status [name]" >&2
        exit 1
        ;;
    esac
    ;;

  wake)
    # The shared wake primitive every runtime adapter calls. Blocks (prints the
    # message) iff a mention addressed to <name> is newer than <name>'s last
    # addressed reply; otherwise silent. Stateless — derived from pad git history.
    #   stitchpad wake [name] [--peek] [--relay]
    # name defaults to the joined identity. Relay mode may run on a coworker's
    # machine with no local .stitchpad checkout, so it uses global hook state.
    # TASK-7: every delivery decision is recorded to per-model telemetry
    # (best-effort — never changes the outcome or exit code).
    _tel_start="$(date +%s)"
    relay_mode=0; peek=0; ordinal_only=0; force=0; force_ord=0; who=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --peek) peek=1; shift ;;
        # --peek-ordinal: print just the open-mention ordinal (mention>reply) and
        # exit, never advancing seen. Used by watch.sh to stamp pending.<name> so
        # the stop-hook can recover a dropped turn in the same ordinal currency.
        --peek-ordinal) ordinal_only=1; peek=1; shift ;;
        # --force [<ordinal>]: bypass the seen cursor (still honors the engagement
        # gate: mention>reply). Without an ordinal, finds the first open mention
        # (since=0). With an ordinal N, uses since=N-1 to target exactly that
        # mention — the stop-hook's dropped-turn recovery uses this to re-present
        # a specific consumed mention (read from pending.<name>).
        --force) force=1; peek=1; shift
          # If next arg is a plain number, it's the target ordinal.
          if [ $# -gt 0 ] && printf '%s' "$1" | grep -qx '[0-9][0-9]*'; then
            force_ord="$1"; shift
          fi
          ;;
        --relay) relay_mode=1; shift ;;
        *) [ -z "$who" ] && who="$1"; shift ;;
      esac
    done
    if [ "$relay_mode" -eq 1 ]; then
      PAD_STATE="${STITCHPAD_RELAY_STATE_DIR:-${STITCHPAD_HOME:-$HOME/.stitchpad}/.state}"
      mkdir -p "$PAD_STATE/sessions"
    else
      sp_init_paths || exit 1
    fi
    # Identity: explicit arg, else this terminal's pinned STITCHPAD_NAME.
    [ -z "$who" ] && who="$(sp_me)"
    [ -z "$who" ] && exit 0   # unidentified → nothing to wake
    # TASK-7: record the wake outcome (best-effort) then exit. Never changes
    # the primary op's result — the record runs after unlock, in a locked-free
    # append, and every failure inside it is silent.
    _wake_record() {  # $1=outcome $2=exitcode
      local _oc="${1:-}" _rc="${2:-0}"
      sp_telemetry_record wake seat="$who" outcome="$_oc" \
        dur_ms=$(( $(sp_telemetry_now_ms) - _tel_start * 1000 )) \
        exit="$_rc" 2>/dev/null || true
      exit "$_rc"
    }
    # F5: --peek-ordinal is a NON-DELIVERY inspection (the bridge doctor and
    # watch.sh poll it per agent every 30s). Those polls are classified as
    # `poll` events — kept as their own signal, never deleted — so polling
    # volume can never inflate wake/delivery outcomes or crowd the bounded
    # reader with false zero_run rows.
    _poll_record() {  # $1=outcome $2=exitcode
      local _oc="${1:-}" _rc="${2:-0}"
      sp_telemetry_record poll seat="$who" outcome="$_oc" \
        dur_ms=$(( $(sp_telemetry_now_ms) - _tel_start * 1000 )) \
        exit="$_rc" 2>/dev/null || true
      exit "$_rc"
    }
    # ── PUSH-SEAT MISDIRECTION GUARD ─────────────────────────────────────
    # `wake` RENDERS to this process's stdout and then advances seen.<name>.
    # For a PULL seat that is exactly right: the agent ran the command itself and
    # read the output. For a PUSH seat targeted BY SOMEBODY ELSE it is total loss
    # — the text lands in the orchestrator's terminal, the cursor moves so the
    # message is never retried, and the agent is never told anything. Measured on
    # the live pad: seen.kimi had advanced to 5 while the daemon showed no turn
    # since the previous day. That is the single most expensive shape in this
    # system: it looks exactly like success.
    # Push delivery belongs to the watcher (mention → fire_adapter → adapter).
    # Refuse, name the fix, and DO NOT touch the cursor. Self-wake and every
    # --peek/--peek-ordinal inspection are unaffected.
    # k3 F4 close-out: the guard was scoped to relay_mode -eq 0, so the RELAY
    # path kept the whole defect — `wake <someone-else> --relay` renders their
    # message to this terminal and burns seen.relay.<padkey>.<name>, exactly the
    # loss the local path refuses. Relay wake legitimately runs on a coworker's
    # machine with no local pad, where no caller identity resolves; that case is
    # preserved by refusing only when a caller identity EXISTS and is someone
    # else. Every in-repo relay call is `"$0" wake --relay` with no name, so the
    # caller is the seat and nothing changes for it.
    if [ "$peek" -eq 0 ]; then
      _caller="$(sp_me 2>/dev/null || true)"; [ -n "$_caller" ] || _caller="${STITCHPAD_NAME:-}"
      if [ "$relay_mode" -eq 1 ] && [ -z "$_caller" ]; then _caller="$who"; fi
      # P43 originally scoped this to PUSH seats. That was half the bug: waking a
      # PULL seat as a third party is just as destructive, and k3 proved it —
      # @boss ran `wake dale`, the message rendered on BOSS's terminal, and
      # seen.dale advanced 0 -> 1, so dale could never see it. The seat is
      # irrelevant; what matters is that the CALLER IS NOT THE SEAT. `wake`
      # renders to this process's stdout and then consumes, so anyone else
      # running it destroys the message no matter how that seat is woken.
      if [ "$_caller" != "$who" ]; then
        _wmode="$(sp_wake_mode_for "$who")"
        echo "stitchpad: REFUSED — \`wake\` renders to THIS terminal and then advances @$who's cursor, so running it for someone else destroys the message." >&2
        if [ "$_wmode" = "push" ]; then
          echo "  to actually reach @$who:  stitchpad say \"@$who <your message>\"   (the watcher dispatches it)" >&2
          echo "  no watcher running?       stitchpad watch start" >&2
        elif [ -z "$_wmode" ]; then
          echo "  @$who is not on this pad's roster — check the name with: stitchpad roster" >&2
          echo "  posting anyway?           stitchpad say \"@$who <your message>\"" >&2
        else
          echo "  @$who is a PULL seat — it collects its own messages. Post it:" >&2
          echo "                            stitchpad say \"@$who <your message>\"" >&2
          echo "  draining @$who yourself?  run it AS that seat: STITCHPAD_NAME=$who stitchpad wake $who" >&2
        fi
        echo "  just want to look?        stitchpad wake $who --peek   (non-consuming)" >&2
        _wake_record push_misdirect 1
      fi
    fi
    # Relay-mode wake: download pad from relay, run local wake logic against it
    if [ "$relay_mode" -eq 1 ]; then
      relay="${STITCHPAD_RELAY:-}"; token="${STITCHPAD_TOKEN:-}"; pad="${STITCHPAD_PAD:-}"
      [ -z "$relay" ] || [ -z "$token" ] || [ -z "$pad" ] && exit 0
      tmpmd="$(mktemp)"; trap 'rm -f "$tmpmd"' EXIT
      relay_resp="$(curl -sf -H "Authorization: Bearer ${token}" "${relay}/pad?pad=${pad}" 2>/dev/null || true)"
      [ -z "$relay_resp" ] && exit 0
      # /pad returns {pad: "<markdown>", roster, ...} (key is "pad", not "md") OR,
      # on some paths, raw markdown. Tolerate all three so the wake never silently
      # gets an empty pad: try "pad", then "md", else treat the body as raw markdown.
      echo "$relay_resp" | python3 -c "import json,sys
b=sys.stdin.read()
try:
    d=json.loads(b); sys.stdout.write(d.get('pad') or d.get('md') or '')
except Exception:
    sys.stdout.write(b)" 2>/dev/null > "$tmpmd"
      [ -s "$tmpmd" ] || exit 0
      # Temporarily override PAD_MD to the downloaded relay pad so the local
      # engagement/wake machinery runs unchanged against it.
      PAD_MD="$tmpmd"
      # MULTI-PAD (F4): key relay state PER PAD. The relay state dir is
      # shared by every pad on this machine; one global seen.relay.<who>
      # cursor lets pad A's delivery swallow pad B's open mention (the
      # cross-pad henry bug), and one global telemetry bucket merges every
      # pad's events with no discriminator. Derive a stable per-pad key from
      # the relay pad name (sanitized slug + content hash; collision-safe,
      # path-clean). (Ported from kimi2's 3244256 F4 fix.)
      _pad_slug="$(printf '%s' "$pad" | tr -cd 'A-Za-z0-9._-' | cut -c1-24)"
      _pad_hash="$(printf '%s' "$pad" | shasum -a 256 2>/dev/null | cut -c1-12)"
      case "$_pad_hash" in ''|*[!0-9a-f]*) _pad_hash="000000000000" ;; esac
      [ -n "$_pad_slug" ] || _pad_slug="pad"
      relay_pad_key="${_pad_slug}-${_pad_hash}"
      # Track seen cursor against relay, not local pad — per pad.
      seen_file="$PAD_STATE/seen.relay.$relay_pad_key.$who"
      # One-time migration: seed the per-pad cursor from the legacy shared
      # cursor so the upgrade never mass-replays history the shared cursor
      # had already consumed. (A mention already swallowed by the shared
      # cursor stays swallowed — replay-by-default would be worse.)
      if [ ! -f "$seen_file" ] && [ ! -L "$seen_file" ] \
         && [ -f "$PAD_STATE/seen.relay.$who" ] \
         && [ ! -L "$PAD_STATE/seen.relay.$who" ]; then
        cp "$PAD_STATE/seen.relay.$who" "$seen_file" 2>/dev/null || true
      fi
      # F4: relay telemetry is per-pad for the same reason.
      STITCHPAD_TELEMETRY_ROOT="$PAD_STATE/telemetry.pads/$relay_pad_key"
      export STITCHPAD_TELEMETRY_ROOT
      mkdir -p "$STITCHPAD_TELEMETRY_ROOT" 2>/dev/null || true
    fi
    # The whole rule, one condition: I'm blocked iff a mention addressed TO me is
    # newer than my last ADDRESSED reply. Both are commit indices (each say is one
    # commit, subject "<from>: <text>"). No cursor file, no extra state — purely a
    # function of the pad. An off-topic post (no @) is not a reply, so it doesn't
    # clear the block: the hook keeps firing until I actually reply to someone.
    # Gate derived from pad CONTENT (message blocks), not git commit subjects —
    # the watch.sh daemon auto-commits as "update (HH:MM:SS)" and clobbers the
    # authored subject the old git-based gate relied on, so it could never see my
    # replies and looped forever. sp_engagement walks "## @author" blocks: prints
    # "<first_mention_after_seen> <mention_sender> <last_reply_by_me> <reply_target>".
    # FIFO cursor: pass `seen` as the `since` parameter — returns the oldest
    # unanswered mention after the current delivery cursor, stepping one ordinal
    # per delivery instead of jumping past burst middles.
    # NOTE: relay mode already set seen_file to the per-pad relay cursor
    # (seen.relay.<padkey>.<who>) above — do NOT overwrite it back to the
    # local cursor, or the remote wake collides with the local one and
    # silently never fires (the henry bug). Only default if unset.
    [ -n "${seen_file:-}" ] || seen_file="$PAD_STATE/seen.$who"
    seen=0; [ -f "$seen_file" ] && seen="$(cat "$seen_file" 2>/dev/null || echo 0)"
    # --force bypasses the seen cursor: pass since=0 (find first open mention)
    # or since=force_ord-1 (target exactly that ordinal for stop-hook recovery).
    _since="$seen"
    if [ "$force" -eq 1 ]; then
      if [ "$force_ord" -gt 0 ]; then
        _since=$((force_ord - 1))   # target exactly this mention
      else
        _since=0                    # find first open mention
      fi
    fi
    read -r oldest_mention_to_me mention_sender last_reply_by_me reply_target <<<"$(sp_engagement "$who" "$_since")"
    if [ "${oldest_mention_to_me:-0}" -eq 0 ]; then
      # no unanswered mention after seen → nothing to do
      if [ "$ordinal_only" -eq 1 ]; then _poll_record idle 0; else _wake_record zero_run 0; fi
    fi
    # REPLY-CLEARS-GATE narrowed to same-sender: my reply only clears the gate
    # when it's directed at the SAME sender who mentioned me. Replying to X no
    # longer swallows Y's unanswered mention.
    if [ "${last_reply_by_me:-0}" -gt "$oldest_mention_to_me" ] \
       && [ -n "${mention_sender:-}" ] && [ -n "${reply_target:-}" ] \
       && [ "$reply_target" = "$mention_sender" ]; then
      if [ "$ordinal_only" -eq 1 ]; then _poll_record noop 0; else _wake_record noop 0; fi
      # my reply to the SAME sender is newer than their mention → handled
    fi
    # --peek-ordinal: gate is open (mention unanswered) → print the ordinal, done.
    # Uses the already-computed oldest_mention_to_me from sp_engagement; independent
    # of the seen cursor on purpose. Pending stamps answer "owes a reply" while
    # seen answers "already nudged". They answer different questions.
    if [ "$ordinal_only" -eq 1 ]; then printf '%s' "$oldest_mention_to_me"; _poll_record peek 0; fi
    # WAKE-ONCE with FIFO stepping: the seen cursor was already passed as `since`
    # to sp_engagement, which returned the first mention > seen. When we deliver
    # (non-peek), advance seen to exactly this mention's ordinal. The next wake
    # will find the next mention > this one. --peek never advances seen.
    # --force bypasses the seen gate (delivers even if already seen).
    if [ "$force" -eq 0 ] && [ "$oldest_mention_to_me" -le "${seen:-0}" ]; then
      _wake_record noop 0   # already delivered this mention; not nagging (--force bypasses this)
    fi
    if sp_dnd_is_on "$who"; then
      _wake_record deferred 0   # muted locally; leave seen untouched so the mention queues
    fi
    # Unanswered → compact one-liner wake message (no "untrusted" alarm noise).
    # Fetch the delivery block BY the gate ordinal (sp_engagement returns the
    # first OPEN mention; sp_latest_to's single forward pass would return the
    # first mention > seen even when that mention was already answered by a
    # newer same-sender reply, mis-printing the old question instead of the
    # later sender's). sp_message_ordinal keeps the nudge byte-exact with the
    # ordinal whose FIFO cursor will advance.
    _latest="$(sp_message_ordinal "$oldest_mention_to_me")"
    _sender="$(printf '%s\n' "$_latest" | sed -n 's/^## @\([^ ]*\).*/\1/p' | head -1)"
    [ -n "$_sender" ] || _sender="$who"
    _snip="$(printf '%s\n' "$_latest" | grep -v '^## ' | grep -v '^[[:space:]]*$' | head -1 | sed 's/^[[:space:]]*//' | cut -c1-120)"
    # context discipline: point at the WINDOWED read, never the raw file — the
    # pad grows unbounded and "read the whole file" invites an 80K-token cat.
    _wake_text="$(printf 'pasture: NEW from @%s — %s — reply with @%s (context: `stitchpad read --new` for unread only, `stitchpad read -n 40` for the recent window — do NOT cat stitchpad.md)' "$_sender" "$_snip" "$_sender")"
    # TASKS-IN-WAKE: append the woken agent's open tickets so status upkeep happens
    # at the exact moment they're already engaging with the pad — no human nagging.
    # Relay mode has no local pad tasks; skip there.
    if [ "$relay_mode" -eq 0 ]; then
      _open="$(sp_tasks --mine "$who" 2>/dev/null | awk -F'|' '$3=="todo"||$3=="in_progress"||$3=="in_review" {printf "%s[%s] %s · ", $1, $3, $2}')"
      if [ -n "$_open" ]; then
        _wake_text="$_wake_text
your open tasks: ${_open}— move each with the task tool (in_progress when you start, done when finished), unprompted."
      fi
      # TICKET DISCIPLINE: numbering work items in prose without creating the
      # ticket makes every board lie. Nag while the phantom refs are fresh.
      _known="$(sp_tasks 2>/dev/null | awk -F'|' '{print $1}')"
      _phantom="$(tail -n 80 "$PAD_MD" | grep -o 'TASK-[0-9]*' | sort -u | while read -r _t; do printf '%s\n' "$_known" | grep -qx "$_t" || echo "$_t"; done | head -4 | paste -sd, -)"
      if [ -n "$_phantom" ]; then
        _ticket_line="$(printf 'ticket discipline: %s referenced on the pad with NO ticket — whoever owns them must run `stitchpad task new "<title>" --to <name> --desc "<scope>"` (ids follow automatically).' "$_phantom")"
        _wake_text="$_wake_text
$_ticket_line"
      fi
    fi
    # Preserve the wake nudge as line 1 (existing hooks and terse UIs depend on
    # it) while still attaching the canonical instruction block once.
    printf '%s\n' "$_wake_text" | sp_prompt_with_ponytail append
    [ "$peek" -eq 0 ] && printf '%s' "$oldest_mention_to_me" > "$seen_file"   # mark delivered: FIFO steps one ordinal per delivery
    _wake_record delivered 0
    ;;

  claim-hook)
    # The PreToolUse-hook brain (Claude). Shim (adapters/claim-hook.sh) pipes the
    # runtime's PreToolUse JSON here: {tool_name, tool_input:{file_path}, cwd}.
    # We lease the target file via `stitchpad claim`; if a DIFFERENT agent holds a
    # fresh lease, emit a PreToolUse deny so the write is blocked. This is what
    # turns the advisory claim into enforced atomic-write protection.
    input="$(cat 2>/dev/null || true)"
    cwd="$(printf '%s' "$input" | sed -n 's/.*"cwd"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)"
    [ -n "$cwd" ] && cd "$cwd" 2>/dev/null || true
    sid="$(printf '%s' "$input" | sed -n 's/.*"session_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)"
    [ -n "$sid" ] && export STITCHPAD_SESSION="$sid"
    # Pull file_path out of tool_input. python3 if present (robust), else sed fallback.
    fp="$(printf '%s' "$input" | python3 -c 'import json,sys
try:
  d=json.load(sys.stdin); print(d.get("tool_input",{}).get("file_path","") or "")
except: print("")' 2>/dev/null)"
    [ -z "$fp" ] && fp="$(printf '%s' "$input" | sed -n 's/.*"file_path"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)"
    [ -z "$fp" ] && exit 0   # no file target (not a file write) → allow
    # Claims only apply INSIDE a pad. No .stitchpad here → not a shared worktree,
    # fail-open (else we'd block every write in every non-pad project). Walk up like the CLI does.
    # MY WORKAROUND DELETED. This branch carried a bounded $HOME walk here because
    # it was 4 behind master and lacked sp_find_pad's install-home guard — the same
    # class of workaround the arena branch carried. master fixes it properly, so
    # there is one pad resolver again instead of three hand-rolled walks.
    # Use the shared resolver so the install-home guard (sp_is_install_home)
    # applies here too — ~/.stitchpad symlinks to the checkout's tool/ dir, which
    # ships stitchpad.md and so read as a valid pad, denying every write under $HOME.
    _pad="$(sp_find_pad "$PWD" 2>/dev/null || true)"
    [ -z "$_pad" ] && exit 0   # not in a pad → allow
    # Try to lease it. `claim` exits 0 if I get/hold it, non-zero if someone else holds a fresh one.
    # `claim` has THREE documented outcomes (see the claim arm): 0 = I hold it,
    # 1 = someone else holds a FRESH lease, 2 = no identity. Treating "non-zero" as
    # "someone else holds it" turned rc=2 into the accusation
    #   "another agent holds a fresh write-lease on this file"
    # while `stitchpad claims` printed "(no active claims)" — a lying denial that
    # blocked every write and named a holder who did not exist. Deny ONLY on rc=1.
    "$0" claim "$fp" >/dev/null 2>&1; _claim_rc=$?
    [ "$_claim_rc" -eq 0 ] && exit 0   # claim held by me → allow the write
    [ "$_claim_rc" -ne 1 ] && exit 0   # no identity / internal error → FAIL OPEN, never accuse
    holder="$("$0" claims 2>/dev/null | grep -F "$fp" | head -1)"
    reason="stitchpad: @$(sp_me 2>/dev/null) blocked — another agent holds a fresh write-lease on this file (${holder:-$fp}). Coordinate on the pad or wait for their release (stale leases free after 600s)."
    # PreToolUse deny contract (current Claude): hookSpecificOutput.permissionDecision=deny.
    printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":%s}}\n' \
      "$(printf '%s' "$reason" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))' 2>/dev/null || printf '"write blocked by stitchpad claim lease"')"
    exit 0
    ;;

  hook)
    # The Stop-hook brain. The shim (adapters/stop-hook.sh) just pipes the
    # runtime's stdin JSON here, so ALL logic lives in the CLI and the shim's hash
    # never changes (trust it once in codex /hooks, edit freely forever).
    # Claude & Codex share an identical Stop contract: stdin JSON {cwd, session_id,
    # stop_hook_active}; reply {"decision":"block","reason":TEXT} to keep going.
    input="$(cat 2>/dev/null || true)"
    cwd="$(printf '%s' "$input" | sed -n 's/.*"cwd"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)"
    [ -n "$cwd" ] && cd "$cwd" 2>/dev/null || true
    sid="$(printf '%s' "$input" | sed -n 's/.*"session_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)"
    [ -n "$sid" ] && export STITCHPAD_SESSION="$sid"
    # Relay-mode MCP runs in a different process from this Stop hook. Persisted
    # hook env lets remote agents wake via the same Stop hook without users
    # hand-exporting relay vars in the runtime shell.
    if [ -z "${STITCHPAD_RELAY:-}" ] || [ -z "${STITCHPAD_TOKEN:-}" ] || [ -z "${STITCHPAD_PAD:-}" ]; then
      # MULTI-PAD (H2): the shared relay-hook.env is machine-global — a second
      # pad's relay join OVERWRITES it (mcp/server.mjs persistRelayHookEnv).
      # When this Stop hook carries a session id, only that session's own
      # per-sid env file is authority; falling back to the shared file would
      # source a DIFFERENT pad's relay credentials and wake the wrong pad's
      # mentions into this session. The shared file is consulted only when
      # there is no session id (legacy hooks).
      if [ -n "$sid" ]; then
        _relay_env="${STITCHPAD_HOME:-$HOME/.stitchpad}/.state/relay-hook.$sid.env"
      else
        _relay_env="${STITCHPAD_HOME:-$HOME/.stitchpad}/.state/relay-hook.env"
      fi
      # single authoritative file, always quoted — never word-split a list
      # (TMPDIR with spaces must not shatter the path)
      if [ -f "$_relay_env" ] && [ ! -L "$_relay_env" ]; then
        # shellcheck disable=SC1090
        . "$_relay_env" 2>/dev/null || true
      fi
      # Sourced assignments are shell-local; the relay wake below runs as a
      # SUBPROCESS ("$0" wake --relay) and never sees unexported vars — the
      # wake silently no-ops without this (caught by multipad-isolation P2).
      [ -n "${STITCHPAD_RELAY:-}" ] && export STITCHPAD_RELAY
      [ -n "${STITCHPAD_TOKEN:-}" ] && export STITCHPAD_TOKEN
      [ -n "${STITCHPAD_PAD:-}" ] && export STITCHPAD_PAD
      [ -n "${STITCHPAD_NAME:-}" ] && export STITCHPAD_NAME
    fi
    # Don't re-block a turn we already continued (avoids an infinite Stop loop).
    if printf '%s' "$input" | grep -q '"stop_hook_active"[[:space:]]*:[[:space:]]*true'; then exit 0; fi
    # Relay mode: check relay for @mentions instead of local pad
    if [ -n "${STITCHPAD_RELAY:-}" ] && [ -n "${STITCHPAD_TOKEN:-}" ] && [ -n "${STITCHPAD_PAD:-}" ]; then
      msgs="$("$0" wake --relay 2>/dev/null || true)"
    else
      sp_init_paths || exit 0
      # In Stop-hook context, session id is the authority. A stale STITCHPAD_NAME
      # in the runtime env must not override the session binding and wake the
      # wrong agent. If the session cannot be resolved, fail closed.
      who="$(sp_session_name)"
      [ -z "$who" ] && exit 0
      msgs=""
      # Reset-created exact redelivery has its own provenance record. Reconcile
      # it under the pad mutation lock before normal FIFO wake delivery so a
      # concurrent reply cannot leave a permanent pending marker or cause an
      # older exact request to be skipped behind a newer unread mention.
      _reset_marker="$PAD_STATE/pending.$who.reset"
      _pend="$PAD_STATE/pending.$who"
      if [ -f "$_reset_marker" ]; then
        if sp_lock; then
          _reset_line="$(cat "$_reset_marker" 2>/dev/null || true)"
          IFS='|' read -r _reset_ord _reset_id _reset_extra <<<"$_reset_line"
          _reset_pipes="${_reset_line//[^|]/}"
          _pending_ord="$(cat "$_pend" 2>/dev/null || true)"
          if [ "${#_reset_pipes}" -ne 1 ] || [ -n "${_reset_extra:-}" ] \
            || [ -z "${_reset_id:-}" ]; then
            # Malformed provenance is not authority to delete a possibly legacy
            # pending marker. Leave both visible for health/manual repair.
            :
          elif [ ! -f "$_pend" ]; then
            rm -f "$_reset_marker" 2>/dev/null || true
          elif [ "$_pending_ord" != "$_reset_ord" ]; then
            # The pending marker is unrelated; remove only our orphaned reset
            # provenance and never consume the legacy/supervisor state.
            rm -f "$_reset_marker" 2>/dev/null || true
          else
            _current_id="$(sp_open_mention_identity "$who" "$_reset_ord" 2>/dev/null || true)"
            if [ -z "$_current_id" ] || [ "$_current_id" != "$_reset_id" ]; then
              # A reply, rewrite, or different ordinal closed the exact request.
              # Both files are proven reset-owned and can be self-healed.
              rm -f "$_pend" "$_reset_marker" 2>/dev/null || true
            else
              _recovered="$("$0" wake "$who" --force "$_reset_ord" 2>/dev/null || true)"
              if [ -n "$_recovered" ]; then
                rm -f "$_pend" "$_reset_marker" 2>/dev/null || true
                printf '%s' "$_reset_ord" > "$PAD_STATE/delivered_no_reply.$who" 2>/dev/null || true
                msgs="$_recovered"
              fi
            fi
          fi
          sp_unlock
        fi
      fi
      [ -n "$msgs" ] || msgs="$("$0" wake ${who:+"$who"} 2>/dev/null || true)"
      # DROPPED-TURN RECOVERY (local mode only). The normal wake above respects the
      # seen cursor, so a mention already consumed by the watcher returns nothing —
      # correct for a legitimately-silent turn, WRONG for a turn that died mid-tool
      # before posting (the human sees silence). pending.<who> was stamped by
      # watch.sh with the delivered ordinal. If it's still set AND the gate is
      # STILL open at the SAME ordinal (no reply posted), re-present ONCE via
      # 'wake --force' (bypasses the consumed seen cursor).
      #
      # SUCCESS-GATED TRANSITION: only delete pending and write delivered_no_reply
      # when the targeted recovery actually produces output. If --force returns
      # empty (DND active, gate closed, etc.), leave pending intact so the next
      # hook cycle can retry. This is the defer-not-destroy property: a suppressed
      # recovery attempt must not consume the one-shot re-block bound.
      _pend="$PAD_STATE/pending.$who"
      if [ -z "$msgs" ] && [ -f "$_pend" ] && [ ! -f "$_reset_marker" ]; then
        _pend_ord="$(cat "$_pend" 2>/dev/null || echo 0)"
        # Validate independently of seen via sp_engagement(since=_pend_ord-1).
        if [ "$_pend_ord" -gt 0 ] 2>/dev/null; then
          _chk="$(sp_engagement "$who" "$((_pend_ord - 1))" 2>/dev/null || echo "0 x 0 x")"
          _chk_ord="$(printf '%s' "$_chk" | awk '{print $1}')"
          if [ "${_chk_ord:-0}" = "${_pend_ord:-x}" ]; then
            _recovered="$("$0" wake "$who" --force "$_pend_ord" 2>/dev/null || true)"
            if [ -n "$_recovered" ]; then
              # Recovery succeeded → one-shot re-block consumed, mark visible.
              rm -f "$_pend" 2>/dev/null
              msgs="$_recovered"
              printf '%s' "$_pend_ord" > "$PAD_STATE/delivered_no_reply.$who" 2>/dev/null || true
            fi
            # Recovery failed (DND, empty output): leave pending intact.
            # Next hook cycle re-validates and retries.
          fi
        fi
      fi
    fi
    [ -z "$msgs" ] && exit 0   # nothing for me → stop normally
    # Blocking the stop IS the delegated request creation: this reply dispatches
    # the drained messages into the seat's next turn. Record the REAL dispatch
    # (session id came from the hook's stdin JSON; an unresolvable one stays
    # explicitly empty) and refresh the pad-header projection under the pad
    # mutation lock. Relay mode has no local pad/state — `who` is only resolved
    # on the local branch, so gate on it. A busy pad skips the refresh; the
    # wake delivery itself is never blocked on projection bookkeeping.
    if [ -n "${who:-}" ]; then
      STITCHPAD_NAME="$who" sp_session_registry_lifecycle_commit dispatch || true
    fi
    esc="$(printf '%s' "$msgs" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))' 2>/dev/null)"
    [ -z "$esc" ] && esc="$(printf '%s' "$msgs" | sed 's/\\/\\\\/g; s/"/\\"/g' | awk 'BEGIN{ORS="\\n"}{print}')" && esc="\"$esc\""
    printf '{"decision":"block","reason":%s}\n' "$esc"
    ;;

  start)
    sp_init_paths || exit 1
    ensure_watcher || exit 1
    if sp_any_alive && ! sp_watcher_alive; then
      echo "stitchpad: watcher could not be ensured" >&2
      exit 1
    fi
    echo "→ watcher ensured"
    ;;
  stop)
    sp_init_paths || exit 1
    if ! sp_stop_watchers_for_pad; then
      sp_stop_delivery_workers
      echo "stitchpad: watcher stop left unverified ownership evidence" >&2
      exit 1
    fi
    sp_stop_delivery_workers
    echo "→ watcher stopped"
    ;;
  status) sp_init_paths_readonly || exit 1; sp_watcher_alive_readonly && echo "running (pid $(cat "$PAD_STATE/watch.lock.d/pid" 2>/dev/null))" || echo "stopped"; ;;
  restart)
    sp_init_paths || exit 1
    sp_stop_watchers_for_pad || {
      echo "stitchpad: watcher restart refused unverified ownership evidence" >&2
      exit 1
    }
    sp_stop_delivery_workers
    ensure_watcher || exit 1
    if sp_any_alive && ! sp_watcher_alive; then
      echo "stitchpad: watcher restart did not establish a verified owner" >&2
      exit 1
    fi
    echo "→ watcher restarted"
    ;;
  watch)
    # This arm was `exec watch.sh` with NO argument handling, so EVERY argument
    # was silently discarded. `stitchpad watch start` ran the watcher in the
    # FOREGROUND forever (which is what hung operator-conduct-gate at G1), and —
    # worse — `stitchpad watch stop` STARTED one too. An operator asking to stop
    # got the exact opposite, blocking their terminal, with no error.
    # Real subcommands now; an unknown one is refused instead of ignored.
    case "${1:-}" in
      ''|--foreground|fg)
        exec "$STITCHPAD_HOME/bin/watch.sh"
        ;;
      start)
        sp_init_paths || exit 1
        # Surface the missing dependency HERE, where the operator is looking,
        # instead of only in .state/watch.log which nobody is told about.
        if ! command -v fswatch >/dev/null 2>&1; then
          echo "stitchpad: fswatch is not installed (or not on PATH) — a watcher cannot receive events." >&2
          echo "  install it:  brew install fswatch" >&2
          echo "  pull seats work without it; push seats will not be woken." >&2
          exit 1
        fi
        if sp_watcher_alive; then
          echo "✓ watcher already running for $(basename "$(dirname "$PAD_DIR")")"
          exit 0
        fi
        ensure_watcher || true
        # ensure_watcher spawns detached; give it a bounded moment to publish.
        _w_i=0
        while [ "$_w_i" -lt 40 ]; do
          sp_watcher_alive && break
          sleep 0.25; _w_i=$((_w_i + 1))
        done
        if sp_watcher_alive; then
          echo "✓ watcher started"
        else
          echo "stitchpad: watcher did not start (is any agent alive? a watcher only runs when someone is listening)" >&2
          exit 1
        fi
        ;;
      stop)
        sp_init_paths || exit 1
        sp_stop_watchers_for_pad
        if sp_watcher_alive; then
          echo "stitchpad: watcher still running after stop" >&2; exit 1
        fi
        echo "✓ watcher stopped"
        ;;
      status)
        sp_init_paths_readonly || exit 1
        if sp_watcher_alive; then echo "✓ watcher running"; else echo "no watcher running"; exit 1; fi
        ;;
      *)
        echo "usage: stitchpad watch [start|stop|status]   (no argument = run in the foreground)" >&2
        exit 1
        ;;
    esac
    ;;
  daemon)  exec "$STITCHPAD_HOME/bin/daemon.sh" "${@}" ;;

  bridge)
    # The relay bridge as a permanent login service — so EVERY pad anywhere under
    # $HOME auto-mirrors to the PWA with zero per-pad setup, surviving reboots.
    #   stitchpad bridge install   write+load the launchd agent (one time)
    #   stitchpad bridge uninstall remove it
    #   stitchpad bridge status    is it loaded/running?
    sub="${1:-status}"
    plist="$HOME/Library/LaunchAgents/org.stitchpad.bridge.plist"
    tmpl="$STITCHPAD_HOME/relay/org.stitchpad.bridge.plist.template"
    case "$sub" in
      install)
        relay="${STITCHPAD_RELAY:-https://stitchpad.agentsworld.org}"
        token="${STITCHPAD_TOKEN:-}"
        [ -z "$token" ] && { echo "set STITCHPAD_TOKEN (the relay bearer token) and re-run" >&2; exit 1; }
        [ -f "$tmpl" ] || { echo "missing template: $tmpl" >&2; exit 1; }
        mkdir -p "$HOME/Library/LaunchAgents"
        sed -e "s|__HOME__|$HOME|g" -e "s|__RELAY__|$relay|g" -e "s|__TOKEN__|$token|g" "$tmpl" > "$plist"
        launchctl unload "$plist" 2>/dev/null || true
        launchctl load "$plist" 2>/dev/null && echo "✓ bridge installed + running (auto-starts at login, scans all of \$HOME)" || { echo "launchctl load failed" >&2; exit 1; }
        ;;
      uninstall)
        launchctl unload "$plist" 2>/dev/null || true
        rm -f "$plist" && echo "✓ bridge service removed"
        ;;
      status)
        if launchctl list org.stitchpad.bridge >/dev/null 2>&1; then
          echo "✓ bridge service loaded + auto-starts at login"; pgrep -fl "relay/bridge.sh" | head -1
        else echo "bridge service not installed (run: stitchpad bridge install)"; fi
        ;;
      *) echo "usage: stitchpad bridge {install|uninstall|status}" >&2; exit 1 ;;
    esac
    ;;

  invite)
    # Mint a remote-join invite token for the CURRENT pad via the relay, so an agent
    # anywhere can join with just a link — no clone, no local pad.
    #   stitchpad invite [--name <handle>] [--ttl 1h|30m|7d|never]   create an invite
    #   stitchpad invite --revoke <token>   revoke an invite
    #   stitchpad invite --list             (not supported yet)
    sp_init_paths || exit 1
    relay="${STITCHPAD_RELAY:-https://stitchpad.agentsworld.org}"
    token="${STITCHPAD_TOKEN:-}"
    if [ -z "$token" ]; then
      for tf in "$HOME/.stitchpad/.state/relay-token" "$PAD_STATE/relay-token"; do
        [ -f "$tf" ] && { token="$(cat "$tf" 2>/dev/null | tr -d '[:space:]')"; [ -n "$token" ] && break; }
      done
    fi
    [ -z "$token" ] && { echo "stitchpad: set STITCHPAD_TOKEN (the relay bearer token) — or write it to ~/.stitchpad/.state/relay-token — and re-run" >&2; exit 1; }

    handle="guest"
    ttl_arg="1h"
    revoke=""
    do_list=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --name)   shift; handle="${1:-}"; [ -n "$handle" ] || { echo "usage: stitchpad invite --name <handle>" >&2; exit 1; } ;;
        --ttl)    shift; ttl_arg="${1:-}"; [ -n "$ttl_arg" ] || { echo "usage: stitchpad invite --ttl <1h|30m|7d|never>" >&2; exit 1; } ;;
        --revoke) shift; revoke="${1:-}"; [ -n "$revoke" ] || { echo "usage: stitchpad invite --revoke <token>" >&2; exit 1; } ;;
        --list)   do_list=1 ;;
        *) echo "usage: stitchpad invite [--name <handle>] [--ttl 1h|30m|7d|never] | --revoke <token>" >&2; exit 1 ;;
      esac
      shift
    done

    if [ -n "$do_list" ]; then
      echo "invite listing not supported yet"
      exit 0
    fi

    if [ -n "$revoke" ]; then
      curl -fsS -X DELETE -H "authorization: Bearer $token" "${relay%/}/invite?revoke=$revoke" >/dev/null || {
        echo "stitchpad: revoke failed" >&2; exit 1; }
      echo "✓ revoked"
      exit 0
    fi

    # human duration → seconds; "never" → 0 (permanent)
    case "$ttl_arg" in
      never|0)         ttl_sec=0 ;;
      *[sS])           ttl_sec="${ttl_arg%[sS]}" ;;
      *[mM])           ttl_sec=$(( ${ttl_arg%[mM]} * 60 )) ;;
      *[hH])           ttl_sec=$(( ${ttl_arg%[hH]} * 3600 )) ;;
      *[dD])           ttl_sec=$(( ${ttl_arg%[dD]} * 86400 )) ;;
      *[0-9])          ttl_sec="$ttl_arg" ;;
      *) echo "stitchpad: bad --ttl '$ttl_arg' (use e.g. 30m, 1h, 7d, never)" >&2; exit 1 ;;
    esac
    case "$ttl_sec" in ''|*[!0-9]*) echo "stitchpad: bad --ttl '$ttl_arg'" >&2; exit 1 ;; esac

    pad_name="$(basename "$(dirname "$PAD_DIR")")"
    resp="$(curl -fsS -X POST -H "authorization: Bearer $token" -H "content-type: application/json" \
      -d "{\"handle\":\"$handle\",\"ttlSec\":$ttl_sec}" "${relay%/}/invite?pad=$pad_name")" || {
        echo "stitchpad: invite request failed (relay $relay, pad $pad_name)" >&2; exit 1; }

    new_token="$(printf '%s' "$resp" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("token",""))' 2>/dev/null || true)"
    [ -n "$new_token" ] || { echo "stitchpad: relay returned no token: $resp" >&2; exit 1; }
    if [ "$ttl_sec" -eq 0 ]; then
      when="never"
    else
      expires="$(printf '%s' "$resp" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("expires",""))' 2>/dev/null || true)"
      when="${expires:-in ${ttl_sec}s}"
    fi

    echo "✓ invite created for #$pad_name as @$handle (expires $when)"
    echo "Share this link:"
    echo "  ${relay%/}/?invite=$new_token"
    echo "Or the token: $new_token"
    ;;

  test)
    # Discover and run all test scripts in test/ and bin/test-*.sh
    passed=0; failed=0; total=0
    tests=()
    _runner_command_sha256() {
      printf '%s' "$1" | shasum -a 256 2>/dev/null | awk '{print $1}'
    }
    _runner_process_is_alive() {
      local _rp_pid="$1" _rp_start="$2" _rp_command_sha="$3" _rp_stat _rp_command
      _rp_stat="$(ps -p "$_rp_pid" -o stat= 2>/dev/null || true)"
      case "$_rp_stat" in ''|*Z*) return 1 ;; esac
      _rp_command="$(sp_process_command "$_rp_pid")"
      [ "$(sp_process_start "$_rp_pid")" = "$_rp_start" ] \
        && [ "$(_runner_command_sha256 "$_rp_command")" = "$_rp_command_sha" ]
    }
    _runner_register_exact() {
      local _rp_pid="$1" _rp_registry="$2" _rp_start _rp_command _rp_command_sha _rp_line
      case "$_rp_pid" in ''|*[!0-9]*) return 0 ;; esac
      [ "$_rp_pid" -gt 1 ] 2>/dev/null || return 0
      _rp_start="$(sp_process_start "$_rp_pid")"
      _rp_command="$(sp_process_command "$_rp_pid")"
      [ -n "$_rp_start" ] && [ -n "$_rp_command" ] || return 0
      _rp_command_sha="$(_runner_command_sha256 "$_rp_command")"
      [ -n "$_rp_command_sha" ] || return 0
      _rp_line="${_rp_pid}|$(sp_b64_encode "$_rp_start")|${_rp_command_sha}"
      grep -Fqx "$_rp_line" "$_rp_registry" 2>/dev/null \
        || printf '%s\n' "$_rp_line" >> "$_rp_registry"
    }
    _runner_register_descendants() {
      local _rp_root="$1" _rp_registry="$2" _rp_scan
      _rp_scan="${_rp_registry}.scan"
      local _rp_known=" $_rp_root " _rp_changed=1 _rp_pid _rp_ppid
      ps -axo pid=,ppid= > "$_rp_scan" 2>/dev/null || return 0
      while [ "$_rp_changed" -eq 1 ]; do
        _rp_changed=0
        while read -r _rp_pid _rp_ppid; do
          case "$_rp_known" in
            *" $_rp_ppid "*)
              case "$_rp_known" in *" $_rp_pid "*) ;; *)
                _rp_known="${_rp_known}${_rp_pid} "
                _rp_changed=1
                ;;
              esac
              ;;
          esac
        done < "$_rp_scan"
      done
      rm -f "$_rp_scan"
      for _rp_pid in $_rp_known; do
        [ "$_rp_pid" = "$_rp_root" ] && continue
        _runner_register_exact "$_rp_pid" "$_rp_registry"
      done
    }
    _runner_register_group() {
      local _rp_group="$1" _rp_root="$2" _rp_registry="$3" _rp_scan _rp_pid _rp_pgid
      _rp_scan="${_rp_registry}.scan"
      ps -axo pid=,pgid= > "$_rp_scan" 2>/dev/null || return 1
      while read -r _rp_pid _rp_pgid; do
        [ "$_rp_pgid" = "$_rp_group" ] || continue
        [ "$_rp_pid" = "$_rp_root" ] && continue
        _runner_register_exact "$_rp_pid" "$_rp_registry"
      done < "$_rp_scan"
      rm -f "$_rp_scan"
    }
    _runner_reap_registered() {
      local _rp_registry="$1" _rp_group="$2" _rp_root="$3"
      local _rp_pid _rp_start64 _rp_command_sha _rp_start
      local _rp_i=0 _rp_any=0 _rp_found=0
      # Give well-behaved teardown a short bounded window before classifying a
      # surviving exact descendant as fixture residue.
      while [ "$_rp_i" -lt 10 ]; do
        _runner_register_group "$_rp_group" "$_rp_root" "$_rp_registry" || return 1
        _rp_any=0
        while IFS='|' read -r _rp_pid _rp_start64 _rp_command_sha; do
          [ -n "$_rp_pid" ] || continue
          _rp_start="$(sp_b64_decode "$_rp_start64" 2>/dev/null || true)"
          _runner_process_is_alive "$_rp_pid" "$_rp_start" "$_rp_command_sha" \
            && { _rp_any=1; break; }
        done < "$_rp_registry"
        [ "$_rp_any" -eq 0 ] && break
        sleep 0.05
        _rp_i=$((_rp_i + 1))
      done
      _runner_register_group "$_rp_group" "$_rp_root" "$_rp_registry" || return 1
      while IFS='|' read -r _rp_pid _rp_start64 _rp_command_sha; do
        [ -n "$_rp_pid" ] || continue
        _rp_start="$(sp_b64_decode "$_rp_start64" 2>/dev/null || true)"
        if _runner_process_is_alive "$_rp_pid" "$_rp_start" "$_rp_command_sha"; then
          _rp_found=1
          echo "stitchpad: fixture process residue: exact pid=$_rp_pid command_sha256=$_rp_command_sha" >&2
          kill "$_rp_pid" 2>/dev/null || true
        fi
      done < "$_rp_registry"
      [ "$_rp_found" -eq 0 ] && return 0
      sleep 0.2
      _runner_register_group "$_rp_group" "$_rp_root" "$_rp_registry" || return 1
      while IFS='|' read -r _rp_pid _rp_start64 _rp_command_sha; do
        [ -n "$_rp_pid" ] || continue
        _rp_start="$(sp_b64_decode "$_rp_start64" 2>/dev/null || true)"
        _runner_process_is_alive "$_rp_pid" "$_rp_start" "$_rp_command_sha" \
          && kill -KILL "$_rp_pid" 2>/dev/null || true
      done < "$_rp_registry"
      return 1
    }
    # TASK-10: defense-in-depth fixture reap — three independent detectors.
    # (a) GROUP:    recorded PGID scan (_runner_reap_registered above)
    # (b) MARKER:   ps eww env scan — catches setsid/reparented escapes
    # (c) FS:       lsof +D sweep — catches env-scrubbed evaders whose cwd
    #               or open fd is still under the fixture root
    _runner_reap_count=0
    _runner_fixture_id=""
    _runner_fixture_root=""
    _runner_generate_fixture_id() {
      _runner_fixture_id="$(python3 -c 'import uuid; print(uuid.uuid4())' 2>/dev/null || uuidgen 2>/dev/null || echo "pro6-$$-$RANDOM")"
    }
    _runner_generate_fixture_root() {
      _runner_fixture_root="$(mktemp -d "${TMPDIR:-/tmp}/stitchpad-fixture.XXXXXX")"
    }
    _runner_marker_pids() {
      ps eww -axo pid=,command= 2>/dev/null | grep "STITCHPAD_FIXTURE_ID=$_runner_fixture_id" | awk '{print $1}' | sort -un
    }
    _runner_reap_by_marker() {
      local _pid _killed=0 _survivor=0
      [ -n "${_runner_fixture_id:-}" ] || return 0
      for _pid in $(_runner_marker_pids); do
        [ "$_pid" = "$$" ] && continue
        [ "$_pid" = "$PPID" ] && continue
        kill -0 "$_pid" 2>/dev/null || continue
        kill -TERM "$_pid" 2>/dev/null && _killed=$((_killed + 1)) || true
      done
      sleep 0.1
      for _pid in $(_runner_marker_pids); do
        [ "$_pid" = "$$" ] && continue
        [ "$_pid" = "$PPID" ] && continue
        kill -0 "$_pid" 2>/dev/null || continue
        kill -KILL "$_pid" 2>/dev/null && _killed=$((_killed + 1)) || true
        echo "stitchpad: TASK-10 marker reap: killed evader pid=$_pid fixture_id=$_runner_fixture_id" >&2
      done
      _runner_reap_count=$((_runner_reap_count + _killed))
      sleep 0.1
      for _pid in $(_runner_marker_pids); do
        [ "$_pid" = "$$" ] && continue
        [ "$_pid" = "$PPID" ] && continue
        kill -0 "$_pid" 2>/dev/null || continue
        _survivor=1
        echo "stitchpad: TASK-10 boundary guard: pid=$_pid survived marker reap (fixture_id=$_runner_fixture_id)" >&2
      done
      [ "$_survivor" -eq 0 ] && return 0
      return 1
    }
    _runner_assert_zero_tmpdir_handles() {
      local _rp_registry="$1" _rp_group="$2" _rp_root="$3"
      local _pid _found=0
      [ -n "${_runner_fixture_id:-}" ] || return 0
      # Independent ps eww scan — does NOT delegate to _runner_marker_pids.
      # If _runner_marker_pids is mutated/neutered, this assertion still fires.
      for _pid in $(ps eww -axo pid=,command= 2>/dev/null | grep "STITCHPAD_FIXTURE_ID=$_runner_fixture_id" | awk '{print $1}' | sort -un); do
        [ "$_pid" = "$$" ] && continue
        [ "$_pid" = "$PPID" ] && continue
        kill -0 "$_pid" 2>/dev/null || continue
        _found=1
        echo "stitchpad: TASK-10 boundary guard: pid=$_pid bears fixture marker $_runner_fixture_id after all reaps" >&2
      done
      [ "$_found" -eq 0 ] && return 0
      return 1
    }
    _runner_reap_by_filesystem() {
      local _pid _killed=0 _survivor=0 _root="${_runner_fixture_root:-}"
      [ -n "$_root" ] && [ -d "$_root" ] || return 0
      for _pid in $(lsof -Fp +D "$_root" 2>/dev/null | grep '^p' | sed 's/^p//' | sort -un); do
        [ "$_pid" = "$$" ] && continue
        [ "$_pid" = "$PPID" ] && continue
        kill -0 "$_pid" 2>/dev/null || continue
        kill -TERM "$_pid" 2>/dev/null && _killed=$((_killed + 1)) || true
      done
      sleep 0.1
      for _pid in $(lsof -Fp +D "$_root" 2>/dev/null | grep '^p' | sed 's/^p//' | sort -un); do
        [ "$_pid" = "$$" ] && continue
        [ "$_pid" = "$PPID" ] && continue
        kill -0 "$_pid" 2>/dev/null || continue
        kill -KILL "$_pid" 2>/dev/null && _killed=$((_killed + 1)) || true
        echo "stitchpad: TASK-10 fs reap: killed filesystem evader pid=$_pid root=$_root" >&2
      done
      _runner_reap_count=$((_runner_reap_count + _killed))
      sleep 0.1
      for _pid in $(lsof -Fp +D "$_root" 2>/dev/null | grep '^p' | sed 's/^p//' | sort -un); do
        [ "$_pid" = "$$" ] && continue
        [ "$_pid" = "$PPID" ] && continue
        kill -0 "$_pid" 2>/dev/null || continue
        _survivor=1
        echo "stitchpad: TASK-10 boundary guard: pid=$_pid survived filesystem reap (root=$_root)" >&2
      done
      [ "$_survivor" -eq 0 ] && return 0
      return 1
    }
    _runner_assert_zero_filesystem_survivors() {
      local _pid _found=0 _root="${_runner_fixture_root:-}"
      [ -n "$_root" ] && [ -d "$_root" ] || return 0
      # Independent lsof scan — not delegated to _runner_reap_by_filesystem.
      for _pid in $(lsof -Fp +D "$_root" 2>/dev/null | grep '^p' | sed 's/^p//' | sort -un); do
        [ "$_pid" = "$$" ] && continue
        [ "$_pid" = "$PPID" ] && continue
        kill -0 "$_pid" 2>/dev/null || continue
        _found=1
        echo "stitchpad: TASK-10 boundary guard: pid=$_pid holds handle under fixture root $_root after all reaps" >&2
      done
      [ "$_found" -eq 0 ] && return 0
      return 1
    }
    _runner_registry=""
    _runner_output=""
    _runner_cleanup_files() {
      [ -z "${_runner_registry:-}" ] || rm -f "$_runner_registry" "${_runner_registry}.scan" 2>/dev/null || true
      [ -z "${_runner_output:-}" ] || rm -f "$_runner_output" 2>/dev/null || true
      [ -z "${_runner_fixture_root:-}" ] || rm -rf "$_runner_fixture_root" 2>/dev/null || true
    }
    trap '_runner_cleanup_files' EXIT
    # STITCHPAD_HOME is tool/; repo root is one level up
    REPO_ROOT="$(cd "$STITCHPAD_HOME/.." && pwd)"
    for dir in "$STITCHPAD_HOME/test" "$REPO_ROOT/test"; do
      [ -d "$dir" ] || continue
      while IFS= read -r -d '' t; do
        tests+=("$t")
      done < <(find "$dir" -maxdepth 1 -name '*.sh' -print0 2>/dev/null)
    done
    if [ -d "$STITCHPAD_HOME/bin" ]; then
      while IFS= read -r -d '' t; do
        tests+=("$t")
      done < <(find "$STITCHPAD_HOME/bin" -maxdepth 1 -name 'test-*.sh' -print0 2>/dev/null)
    fi
    if [ ${#tests[@]} -eq 0 ]; then
      echo "No test scripts found."
      exit 1
    fi
    echo "=== stitchpad test ==="
    # TASK-6: label the whole run with environment facts + the immutable
    # candidate (SHA/tree) so a green/red result can never be mistaken for
    # one of a different environment or commit. Value-free for session vars.
    if [ -x "$STITCHPAD_HOME/bin/evidence-stamp" ]; then
      echo "--- evidence ---"
      STITCHPAD_EVIDENCE_COMMAND="stitchpad test" \
        "$STITCHPAD_HOME/bin/evidence-stamp" 2>/dev/null || true
      echo "--- evidence ---"
    fi
    echo ""
    for t in "${tests[@]}"; do
      total=$((total + 1))
      name="$(basename "$t")"
      echo "--- $name ---"
      rc=0
      _runner_registry="$(mktemp "${TMPDIR:-/tmp}/stitchpad-test-processes.XXXXXX")"
      _runner_output="$(mktemp "${TMPDIR:-/tmp}/stitchpad-test-output.XXXXXX")"
      _runner_generate_fixture_id
      _runner_generate_fixture_root
      # Defense in depth: three independent detectors for fixture processes.
      # (a) GROUP:  recorded PGID catches ordinary children
      # (b) MARKER: ps eww env scan catches setsid/reparented escapes
      # (c) FS:     lsof sweep catches env-scrubbed evaders still under the fixture root
      STITCHPAD_HOME="$STITCHPAD_HOME" \
        STITCHPAD_FIXTURE_ID="$_runner_fixture_id" \
        STITCHPAD_FIXTURE_ROOT="$_runner_fixture_root" env \
        -u HERDR_PANE_ID -u HERDR_TAB_ID -u HERDR_ENV \
        -u HERDR_SOCKET_PATH -u HERDR_WORKSPACE_ID \
        python3 -c 'import os,sys; os.setsid(); os.execvp(sys.argv[1], sys.argv[1:])' \
        bash "$t" > "$_runner_output" 2>&1 &
      _runner_test_pid=$!
      _runner_test_group="$_runner_test_pid"
      while true; do
        _runner_stat="$(ps -p "$_runner_test_pid" -o stat= 2>/dev/null || true)"
        case "$_runner_stat" in ''|*Z*) break ;; esac
        _runner_register_descendants "$_runner_test_pid" "$_runner_registry"
        sleep 0.05
      done
      wait "$_runner_test_pid" || rc=$?
      cat "$_runner_output"
      # Phase 1: group reap (catches ordinary children)
      if ! _runner_reap_registered "$_runner_registry" "$_runner_test_group" "$_runner_test_pid"; then
        [ "$rc" -ne 0 ] || rc=97
      fi
      # Phase 2: global marker reap (catches double-fork+setsid evaders)
      _runner_reap_by_marker || { [ "$rc" -ne 0 ] || rc=97; }
      # Phase 3: global filesystem reap (catches env-scrubbed evaders)
      _runner_reap_by_filesystem || { [ "$rc" -ne 0 ] || rc=97; }
      # Phase 4: zero-survivor assertions across all three layers
      _runner_assert_zero_tmpdir_handles "$_runner_registry" "$_runner_test_group" "$_runner_test_pid" || { [ "$rc" -ne 0 ] || rc=97; }
      _runner_assert_zero_filesystem_survivors || { [ "$rc" -ne 0 ] || rc=97; }
      rm -f "$_runner_registry" "$_runner_output"
      rm -rf "$_runner_fixture_root" 2>/dev/null || true
      _runner_registry=""
      _runner_output=""
      _runner_fixture_root=""
      if [ "$rc" -eq 0 ]; then
        echo "  PASS: $name  (reaped $_runner_reap_count fixture processes)"
        passed=$((passed + 1))
      else
        echo "  FAIL: $name (exit code $rc, reaped $_runner_reap_count fixture processes)"
        failed=$((failed + 1))
      fi
      echo ""
    done
    echo "Results: $passed passed, $failed failed, $total total"
    [ "$failed" -gt 0 ] && exit 1
    exit 0
    ;;

  color)
    # Collision-aware color assignment for a roster member.
    #   stitchpad color <name>   prints the RGB hex for <name>
    #   stitchpad color --all    prints all members and their colors
    # Single source of truth: terminal surfaces and the TUI both shell out to this.
    sp_init_paths || exit 1

    # FIXED 1:1 color map — a case function keeps Apple Bash 3.2 support.
    color_override() {
      case "$1" in
        smaths) echo '#f1ece4' ;; randy) echo '#0d9488' ;;
        dale) echo '#00d000' ;; larry) echo '#e01010' ;;
        ernie) echo '#9b30ff' ;; dennis) echo '#ff8c00' ;;
        Jill|jill) echo '#ff1493' ;; mark) echo '#ffd700' ;;
        nancy) echo '#00ffff' ;; henry) echo '#1e90ff' ;;
        codex) echo '#a8a3ff' ;; fable|claude) echo '#d97757' ;;
        claude-main) echo '#c96442' ;; pi) echo '#aeb8c4' ;;
        ocean) echo '#38bdf8' ;; deepseek) echo '#4d6bfe' ;;
        kimi-pi|kimi) echo '#1783ff' ;;
        *) return 1 ;;
      esac
    }

    # 20-color palette (256-index → hex). Used when no override exists.
    declare -a _pidx=(39 208 76 170 214 51 199 220 123 141 203 82 205 114 177 226 87 213 155 159)
    declare -a _phex=(
      '#00afff' '#ff8700' '#5fff00' '#d75fff' '#ffaf00' '#00ffff' '#ff00af' '#ffd700'
      '#87ffff' '#af87ff' '#ff5faf' '#5fff5f' '#ff5fff' '#87d787' '#d7af5f' '#ffff00'
      '#5fffff' '#ff87ff' '#afffaf' '#afffff'
    )
    plist=${#_pidx[@]}

    # Hash function: sum of char codes mod palette size
    color_hash() {
      local name="$1" sum=0
      for (( i=0; i<${#name}; i++ )); do
        printf -v ch '%d' "'${name:$i:1}"
        (( sum += ch ))
      done
      echo $(( sum % plist ))
    }
    # Roster names are validated tokens, so a newline/space scalar is safe and
    # avoids mapfile/associative arrays unavailable in macOS Bash 3.2.
    _names="$(sp_roster | awk -F'|' '{gsub(/^[ \t]+|[ \t]+$/, "", $1); if ($1 != "") print $1}')"
    _taken=""; _color_rows=""
    for _n in $_names; do
      _color="$(color_override "$_n" 2>/dev/null || true)"
      if [ -z "$_color" ]; then
      h=$(color_hash "$_n")
      idx=$h
        while :; do
          case "|$_taken|" in
            *"|$idx|"*) idx=$(( (idx + 1) % plist )); [ "$idx" -ne "$h" ] || break ;;
            *) break ;;
          esac
        done
        _taken="${_taken:+$_taken|}$idx"
        _color="${_phex[$idx]}"
      fi
      _color_rows="${_color_rows}${_n}|${_color}
"
    done
    if [ -z "${1:-}" ] || [ "${1:-}" = "--all" ]; then
      printf '%s' "$_color_rows" | awk -F'|' 'NF == 2 {print $1, $2}'
    else
      _color="$(printf '%s' "$_color_rows" | awk -F'|' -v name="$1" '$1 == name {print $2; exit}')"
      echo "${_color:-#808080}"
    fi
    ;;

  send)
    # stitchpad send <file> [caption...]  — upload image + post to pad in one step
    sp_init_paths || exit 1
    file="${1:?usage: stitchpad send <file> [caption...]}"
    shift || true
    caption="$*"
    exec "$0" say --image "$file" ${caption:+"$caption"}
    ;;


  roster|who)
    sp_init_paths_readonly || exit 1
    # P5 (NARROW): a deleted pad git makes roster print ZERO ROWS and exit 0 —
    # indistinguishable from an idle fleet. That cost the captain a full cycle and a
    # near-misdiagnosis of a DESTROYED pad as a quiet one. Fail loud HERE, in the read
    # command the operator actually looks at.
    # Deliberately NOT in sp_init_paths: pro4's version lived there and broke pillar
    # recover-migrated-pad, websec, heal-roster and authority-redesign, because
    # journal/recovery paths legitimately operate on empty or not-yet-initialised git
    # dirs. Blast radius belongs at the call site, not in shared init.
    sp_assert_pad_git_usable || exit 1
    sp_roster ;;

  sessions)
    # Read-only projection of the session registry: who ran here, on which
    # provider/model/worktree, how many requests, and derived status
    # (active/idle/stale/terminal). Mutates nothing — resolves paths through
    # the readonly initializer and only reads .state.
    sp_init_paths_readonly || exit 1
    if [ "${1:-}" = "--json" ]; then
      sp_session_registry_project
    else
      sp_session_registry_list
    fi
    ;;
  log)
    sp_init_paths || exit 1
    n=10; [ "${1:-}" = "-n" ] && n="$2"
    sgit log --oneline -n "$n"
    ;;

  health)
    # Structured, non-mutating local snapshot. `--deep` is the only mode that
    # performs I/O beyond local files/process probes, and it is loopback GET-only.
    sp_init_paths_readonly || exit 1
    command -v python3 >/dev/null 2>&1 || { echo "stitchpad: health requires python3" >&2; exit 1; }
    exec python3 "$BIN_DIR/health.py" \
      --pad-dir "$PAD_DIR" --pad-md "$PAD_MD" --state-dir "$PAD_STATE" \
      --adapter-dir "$ADAPTER_DIR" --watch-start-grace "$STITCHPAD_WATCH_START_GRACE" "$@"
    ;;

  doctor)
    # doctor exists to DIAGNOSE a broken pad — refusing to run would be backwards.
    # Report the condition (pad-visibility-gate G3 asserts the wording) and continue.
    sp_assert_pad_git_usable || true
    # Roster health check — read-only diagnostic, no mutations.
    # Reports: untargeted push entries, missing adapter scripts, missing pull
    # session identity, duplicate names, orphaned session files.
    #   stitchpad doctor
    #   stitchpad doctor --json   machine-readable roster array for TUI/widgets
    sp_init_paths_readonly || exit 1
    _json=0; [ "${1:-}" = "--json" ] && _json=1
    warn=0; err=0
    declare -a _json_entries=()
    _doc_read_state() {
      [ ! -L "$PAD_STATE" ] && [ ! -L "$1" ] && [ -f "$1" ] || return 0
      head -c 4096 "$1" 2>/dev/null || true
    }
    _doc_json_entry() {
      python3 - "$@" <<'PY'
import json, sys
keys = ("name", "adapter", "wake", "target", "harness", "model",
        "status", "health", "role", "level")
values = sys.argv[1:]
entry = dict(zip(keys, values[:10]))
if len(values) > 10:
    entry["delivered_no_reply"] = values[10] == "true"
print(json.dumps(entry, ensure_ascii=False, separators=(",", ":")))
PY
    }
    [ "$_json" -eq 0 ] && printf 'stitchpad doctor — roster health check\n\n'

    # Collect roster entries
    declare -a _doc_names=()
    declare -a _doc_adapters=()
    declare -a _doc_wakes=()
    declare -a _doc_targets=()
    while IFS='|' read -r _dn _da _dw _dt; do
      _doc_names+=("$_dn"); _doc_adapters+=("$_da")
      _doc_wakes+=("$_dw"); _doc_targets+=("$_dt")
    done < <(sp_roster)

    # Check 1-4: per-entry diagnostics
    for _di in "${!_doc_names[@]}"; do
      _name="${_doc_names[_di]}"; _adapter="${_doc_adapters[_di]}"
      _wake="${_doc_wakes[_di]}"; _target="${_doc_targets[_di]}"
      issues=()
      _doc_name_safe=1
      case "$_name" in ''|*[!abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-]*) _doc_name_safe=0 ;; esac

      # Operator/human members are NOT agents — they read & post, they don't get
      # woken. So they're exempt from wake-health checks (no target is expected,
      # not a fault). Mark healthy and skip the agent diagnostics.
      _rt=""
      [ "$_doc_name_safe" -eq 1 ] && _rt="$(_doc_read_state "$PAD_STATE/runtime.$_name")"
      _rt="${_rt:-$_adapter}"
      if [ "$_rt" = "operator" ] || [ "$_rt" = "human" ]; then
        if [ "$_json" -eq 1 ]; then
          _role=""; _level=""
          if [ "$_doc_name_safe" -eq 1 ]; then
            _role="$(_doc_read_state "$PAD_STATE/role.$_name")"
            _level="$(_doc_read_state "$PAD_STATE/level.$_name")"
          fi
          _entry="$(_doc_json_entry "$_name" "$_adapter" "$_wake" "$_target" \
            "$_rt" "human" "operator" "ok" "$_role" "$_level")"
          _json_entries+=("$_entry")
        else
          printf '  ✓ @%s (%s) — operator\n' "$_name" "$_rt"
        fi
        continue
      fi

      # Check 1: push adapters require an external target. Pull adapters wake
      # through their bound runtime session and intentionally use target '-'.
      if [ "$_wake" != "pull" ] && { [ "$_target" = "-" ] || [ -z "$_target" ]; }; then
        issues+=("target '-' (no wake target, unreachable)")
        (( warn++ ))
      fi

      # Check 2: adapter is installed. Avoid a hard-coded allowlist so a real
      # adapter such as herdr becomes diagnosable as soon as its script lands.
      case "$_adapter" in ''|*[!abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-]*) _adapter_ok=0 ;; *) _adapter_ok=1 ;; esac
      if [ "$_adapter_ok" -eq 0 ] || [ ! -f "$ADAPTER_DIR/$_adapter.sh" ]; then
        issues+=("missing adapter script '$_adapter.sh'")
        (( err++ ))
      fi

      # Check 3: missing session identity (read-only)
      _found_session=0
      if [ "$_doc_name_safe" -eq 1 ] && [ ! -L "$PAD_STATE" ] && [ ! -L "$PAD_STATE/sessions" ]; then
        for _sf in "$PAD_STATE/sessions/"*; do
          [ -f "$_sf" ] && [ ! -L "$_sf" ] || continue
          if [ "$(_doc_read_state "$_sf")" = "$_name" ]; then
            _found_session=1; break
          fi
        done
      fi
      if [ "$_doc_name_safe" -eq 1 ] && [ "$(_doc_read_state "$PAD_STATE/whoami")" = "$_name" ]; then
        _found_session=1
      fi
      if [ "$_wake" = "pull" ] && [ "$_found_session" -eq 0 ]; then
        issues+=("no session identity file")
        (( warn++ ))
      fi

      # Check 4: duplicates (count occurrences)
      _dup_count=0
      for _dj in "${!_doc_names[@]}"; do
        if [ "${_doc_names[_dj]}" = "$_name" ]; then
          (( _dup_count++ ))
        fi
      done
      if [ "$_dup_count" -gt 1 ]; then
        issues+=("duplicate name in roster ($_dup_count occurrences)")
        (( err++ ))
      fi

      _harness=""

      # Compute online from heartbeat freshness + pid liveness
      _online="offline"
      _alive="$PAD_STATE/alive.$_name"
      if [ "$_doc_name_safe" -eq 1 ] && [ ! -L "$PAD_STATE" ] \
        && [ -f "$_alive" ] && [ ! -L "$_alive" ]; then
        _alive_ts="$(stat -f %m "$_alive" 2>/dev/null || stat -c %Y "$_alive" 2>/dev/null || echo 0)"
        _alive_age=$(( $(date +%s) - _alive_ts ))
        if [ "$_alive_age" -lt 90 ]; then
          _alive_pid="$(grep -o '"pid":[0-9]*' "$_alive" 2>/dev/null | head -1 | cut -d: -f2)"
          [ -n "$_alive_pid" ] && kill -0 "$_alive_pid" 2>/dev/null && _online="online"
        fi
      fi

      # Determine health/status
      _health="ok"
      if [ ${#issues[@]} -gt 0 ]; then
        _health="warn"
        for _issue in "${issues[@]}"; do
          if [[ "$_issue" == *"stale"* ]] || [[ "$_issue" == *"duplicate"* ]]; then
            _health="error"; break
          fi
        done
      fi
      _harness_display="${_harness:-$_adapter}"
      _model=""; _role=""; _level=""
      if [ "$_doc_name_safe" -eq 1 ]; then
        _model="$(_doc_read_state "$PAD_STATE/model.$_name")"
        _role="$(_doc_read_state "$PAD_STATE/role.$_name")"
        _level="$(_doc_read_state "$PAD_STATE/level.$_name")"
      fi

      if [ "$_json" -eq 1 ]; then
        # delivered_no_reply: a mention was re-delivered to this agent and STILL got
        # no authored reply (dropped twice). Surfaced so persistent silence is
        # visible, not lost. "true"/"false" — TUI can flag the row.
        _dnr="false"
        [ "$_doc_name_safe" -eq 1 ] && [ ! -L "$PAD_STATE" ] && [ -f "$PAD_STATE/delivered_no_reply.$_name" ] \
          && [ ! -L "$PAD_STATE/delivered_no_reply.$_name" ] && _dnr="true"
        _entry="$(_doc_json_entry "$_name" "$_adapter" "$_wake" "$_target" \
          "$_harness_display" "${_model:-}" "$_online" "$_health" "$_role" "$_level" "$_dnr")"
        _json_entries+=("$_entry")
      else
        if [ ${#issues[@]} -eq 0 ]; then
          if [ -n "$_harness" ]; then
            printf '  ✓ @%s (%s/%s) %s — %s\n' "$_name" "$_adapter" "$_wake" "$_harness" "$_online"
          else
            printf '  ✓ @%s (%s/%s) — %s\n' "$_name" "$_adapter" "$_wake" "$_online"
          fi
        else
          for _issue in "${issues[@]}"; do
            if [[ "$_issue" == *"stale"* ]] || [[ "$_issue" == *"duplicate"* ]]; then
              printf '  ✗ @%s (%s/%s) — %s\n' "$_name" "$_adapter" "$_wake" "$_issue"
              printf '     → suggested: stitchpad leave %s\n' "$_name"
            else
              printf '  ⚠ @%s (%s/%s) — %s\n' "$_name" "$_adapter" "$_wake" "$_issue"
            fi
          done
        fi
      fi
    done

    # JSON output (machine-readable roster) — emit before human-only sections
    if [ "$_json" -eq 1 ]; then
      if [ "${#_json_entries[@]}" -eq 0 ]; then
        printf '[]\n'
      else
        for _e in "${_json_entries[@]}"; do printf '%s\n' "$_e"; done | python3 -c 'import sys,json; print(json.dumps([json.loads(x) for x in sys.stdin.read().split("\n") if x.strip()]))'
      fi
      exit 0
    fi

    # Check 5: orphaned session files
    printf '\nSession files:\n'
    for _sf in "$PAD_STATE/sessions/"*; do
      [ ! -L "$PAD_STATE" ] && [ ! -L "$PAD_STATE/sessions" ] \
        && [ -f "$_sf" ] && [ ! -L "$_sf" ] || continue
      _sname="$(_doc_read_state "$_sf")"
      _skey=$(basename "$_sf")
      _in_roster=0
      for _dn in "${_doc_names[@]}"; do
        if [ "$_dn" = "$_sname" ]; then _in_roster=1; break; fi
      done
      if [ "$_in_roster" -eq 0 ]; then
        printf '  ⚠ orphaned: sessions/%s → @%s (not in roster)\n' "$_skey" "$_sname"
        (( warn++ ))
      else
        printf '  ✓ sessions/%s → @%s\n' "$_skey" "$_sname"
      fi
    done

    # Bridge liveness check
    printf '\nBridge:\n'
    _bridge_file="$PAD_STATE/bridge-heartbeat"
    _bridge_raw="$(_doc_read_state "$_bridge_file")"
    if [ -n "$_bridge_raw" ]; then
      _bridge_ts="$(printf '%s' "$_bridge_raw" | jq -r '.ts // empty' 2>/dev/null)"
      # TASK-70: fall back to the SLOWEST known writer cadence, not the
      # fastest. The polling bridge writes interval=3; the ws bridge writes
      # 15. A writer that omits the field (as ws did) previously defaulted to
      # 3 -> a 9s threshold -> a permanently-stale warning on a healthy
      # bridge. Defaulting high can only delay a real staleness report by a
      # few cycles; defaulting low cries wolf forever, and a health check
      # nobody trusts is worse than none.
      _bridge_interval="$(printf '%s' "$_bridge_raw" | jq -r '.interval // 15' 2>/dev/null)"
      case "$_bridge_interval" in ''|*[!0-9]*) _bridge_interval=15 ;; esac
      if [ -n "$_bridge_ts" ]; then
        _bridge_ts_s="$(printf '%s' "$_bridge_ts" | sed 's/\.[0-9]*Z$/Z/')"
        _bridge_epoch="$(date -juf '%Y-%m-%dT%H:%M:%SZ' "$_bridge_ts_s" +%s 2>/dev/null || date -u -d "$_bridge_ts_s" +%s 2>/dev/null || echo 0)"
        _now_epoch="$(date +%s)"
        _bridge_age=$(( _now_epoch - _bridge_epoch ))
        _threshold=$(( _bridge_interval * 3 ))
        if [ "$_bridge_age" -lt "$_threshold" ]; then
          printf '  ✓ bridge alive (last drain %ds ago, interval=%ss)\n' "$_bridge_age" "$_bridge_interval"
        else
          printf '  ⚠ bridge stale (last drain %ds ago, threshold=%ss)\n' "$_bridge_age" "$_threshold"
          (( warn++ ))
        fi
      else
        printf '  ⚠ bridge heartbeat file exists but unreadable\n'
        (( warn++ ))
      fi
    else
      printf '  ⚠ no bridge heartbeat file (bridge not running or not yet cycled)\n'
      (( warn++ ))
    fi

    # Git health check (P5): a missing or broken pad git makes roster/sessions
    # meaningless. Report it here so the operator sees it before relying on output.
    printf '\nPad Git:\n'
    if [ ! -d "$PAD_GIT" ]; then
      printf '  \033[0;31m✗\033[0m pad git is MISSING — this pad is broken\n'
      printf '    Restore from backup or re-init:\n'
      printf '    %s %s %s %s\n' 'cd' "$(dirname "$PAD_DIR")" '&& stitchpad init --name' '<name>'
      (( err++ ))
    elif ! sgit rev-parse --git-dir >/dev/null 2>&1; then
      printf '  \033[0;31m✗\033[0m pad git is CORRUPT — rev-parse failed\n'
      printf '    The git repository at %s is unreadable.\n' "$PAD_GIT"
      printf '    Restore from backup or re-init.\n'
      (( err++ ))
    else
      _doc_commit_count="$(sgit rev-list --count HEAD 2>/dev/null || echo 0)"
      _doc_head="$(sgit rev-parse --short HEAD 2>/dev/null || echo "???")"
      printf '  ✓ pad git healthy (%s commits, HEAD %s)\n' "$_doc_commit_count" "$_doc_head"
    fi

    # Orphan-journal self-heal: a PARTIAL rollback (e.g. a `say` killed mid-op)
    # PRESERVES its .registry-journal.* dir, and journal_recover then refuses to
    # auto-roll-back anything it can't prove safe — which permanently wedges
    # every subsequent guarded `say`. Doctor clears ONLY the provably-safe case:
    # an orphan whose stamped .base-sha equals current pad-git HEAD means the
    # crashed operation's commit never landed, so the pre-op bytes are already
    # live and there is nothing to undo — dropping the journal is a no-op-safe
    # unwedge. Every other orphan (base-sha != HEAD, missing/unborn stamp, live
    # owner) is left untouched for the existing recovery path to adjudicate.
    printf '\nStale journals:\n'
    _doc_head_sha=""
    if [ -d "$PAD_GIT" ]; then
      _doc_head_sha="$(sgit rev-parse --verify -q HEAD 2>/dev/null || true)"
    fi
    _doc_orphan_found=0
    for _orphan in "$PAD_STATE"/.registry-journal.*; do
      [ -d "$_orphan" ] || continue
      _doc_orphan_found=1
      _ob="$(cat "$_orphan/.base-sha" 2>/dev/null || true)"
      if [ -n "$_doc_head_sha" ] && [ -n "$_ob" ] && [ "$_ob" = "$_doc_head_sha" ]; then
        if rm -rf "$_orphan" 2>/dev/null; then
          printf '  \033[0;32m✓\033[0m cleared safe orphan %s (base-sha == HEAD; commit never landed)\n' "$(basename "$_orphan")"
        else
          printf '  \033[0;31m✗\033[0m could not remove %s\n' "$(basename "$_orphan")"
          (( err++ ))
        fi
      else
        printf '  \033[0;33m!\033[0m %s preserved — base-sha does not match HEAD; needs manual review\n' "$(basename "$_orphan")"
        (( warn++ ))
      fi
    done
    [ "$_doc_orphan_found" -eq 0 ] && printf '  ✓ no stale journals\n'

    # Summary
    total=$(( warn + err ))
    printf '\n%d issues found (%d warnings, %d errors)\n' "$total" "$warn" "$err"
    if [ "$err" -gt 0 ]; then exit 1; fi
    ;;

  evidence)
    # P7: canonical evidence location management.
    #   stitchpad evidence list            — list all evidence artifacts
    #   stitchpad evidence verify          — check .sha256 sidecars, report OK/STALE/MISSING
    #   stitchpad evidence seal <file>     — create .sha256 sidecar for a file
    sp_init_paths_readonly || exit 1
    _ev_dir="$PAD_DIR/evidence"
    sub="${1:-list}"; shift 2>/dev/null || true
    _ev_ok()  { printf '  \033[0;32mOK\033[0m    %s\n' "$1"; }
    _ev_stale() { printf '  \033[0;31mSTALE\033[0m %s\n' "$1"; }
    _ev_miss()  { printf '  \033[0;33mMISS\033[0m %s\n' "$1"; }

    case "$sub" in
      list)
        if [ ! -d "$_ev_dir" ]; then
          echo "No evidence directory: $_ev_dir"
          echo "Evidence artifacts are sealed to this location with 'stitchpad evidence seal <file>'."
          exit 0
        fi
        find "$_ev_dir" -type f ! -name '*.sha256' | sort | while read -r f; do
          _rel="${f#"$_ev_dir"/}"
          _sha="$f.sha256"
          if [ -f "$_sha" ]; then
            _stored="$(head -1 "$_sha" 2>/dev/null | awk '{print $1}')"
            _computed="$(shasum -a 256 "$f" 2>/dev/null | awk '{print $1}' || true)"
            if [ "$_stored" = "$_computed" ] && [ -n "$_stored" ]; then
              printf '  OK    %s  (sha256: %s)\n' "$_rel" "$_stored"
            else
              printf '  STALE %s  (stored: %s, computed: %s)\n' "$_rel" "${_stored:-MISSING}" "${_computed:-ERROR}"
            fi
          else
            printf '  UNSLD %s  (no .sha256 sidecar)\n' "$_rel"
          fi
        done
        ;;

      verify)
        # P7: verify is the CI/script surface for "is it sealed?" — it MUST
        # count in the current shell (a `find | while` pipeline counts in a
        # subshell and loses every increment) and MUST exit non-zero when any
        # artifact is STALE or unsealed, or when a sidecar is orphaned.
        # Otherwise "verify" is a printer, not a verdict.
        if [ ! -d "$_ev_dir" ]; then
          echo "No evidence directory: $_ev_dir"
          echo "Evidence artifacts are sealed to this location with 'stitchpad evidence seal <file>'."
          exit 0
        fi
        _v_ok=0; _v_stale=0; _v_miss=0
        while IFS= read -r f; do
          _rel="${f#"$_ev_dir"/}"
          _sha="$f.sha256"
          if [ ! -f "$_sha" ]; then
            _ev_miss "$_rel (no .sha256 sidecar)"
            _v_miss=$(( _v_miss + 1 ))
            continue
          fi
          _stored="$(head -1 "$_sha" 2>/dev/null | awk '{print $1}')"
          _computed="$(shasum -a 256 "$f" 2>/dev/null | awk '{print $1}' || true)"
          if [ "$_stored" = "$_computed" ] && [ -n "$_stored" ]; then
            _ev_ok "$_rel"
            _v_ok=$(( _v_ok + 1 ))
          else
            _ev_stale "$_rel"
            _v_stale=$(( _v_stale + 1 ))
          fi
        done < <(find "$_ev_dir" -type f ! -name '*.sha256' | sort)
        # Orphan sidecar: a .sha256 whose artifact is gone is evidence
        # pointing at nothing — that is a MISSING verdict, not silence.
        while IFS= read -r s; do
          [ -f "${s%.sha256}" ] && continue
          _ev_miss "${s#"$_ev_dir"/} (sidecar with no artifact)"
          _v_miss=$(( _v_miss + 1 ))
        done < <(find "$_ev_dir" -type f -name '*.sha256' | sort)
        echo "verify: $_v_ok OK, $_v_stale STALE, $_v_miss MISSING"
        if [ "$_v_stale" -gt 0 ] || [ "$_v_miss" -gt 0 ]; then
          echo "stitchpad: evidence verification FAILED — reseal changed artifacts with 'stitchpad evidence seal <file>'" >&2
          exit 1
        fi
        ;;

      seal)
        _seal_file="${1:-}"
        [ -n "$_seal_file" ] || { echo "usage: stitchpad evidence seal <file>" >&2; exit 1; }
        [ -f "$_seal_file" ] || { echo "stitchpad: file not found: $_seal_file" >&2; exit 1; }
        mkdir -p "$_ev_dir" 2>/dev/null || true
        _seal_name="$(basename "$_seal_file")"
        _seal_dest="$_ev_dir/$_seal_name"
        cp "$_seal_file" "$_seal_dest" 2>/dev/null || { echo "stitchpad: could not copy evidence" >&2; exit 1; }
        shasum -a 256 "$_seal_dest" | awk '{print $1}' > "$_seal_dest.sha256"
        printf '✓ sealed: %s\n' "$_seal_dest"
        ;;

      *)
        echo "usage: stitchpad evidence {list|verify|seal <file>}" >&2
        exit 1
        ;;
    esac
    ;;

  # ── Stitch-Tasks (Linear-style issue tracking) ────────────────────────
  task)
    sp_init_paths || exit 1
    sub="${1:-list}"; shift 2>/dev/null || true
    case "$sub" in
      new)
        # stitchpad task new "title" [--priority high] [--to name] [--labels a,b] [--desc text] [--estimate 30m]
        # An unknown flag used to be swallowed as the TITLE:
        #   stitchpad task new --title "Real Title"   ->  card titled "--title"
        # printed "TASK-N created", rc=0. Refuse a leading flag; the title is
        # positional and naming the real form is more useful than a wrong card.
        case "${1:-}" in
          --help|-h) echo "usage: stitchpad task new \"<title>\" [--priority p] [--to name] [--labels a,b] [--desc text] [--estimate 30m]" >&2; exit 2 ;;
          -*) echo "stitchpad: task new takes the title as the FIRST positional argument, not '${1}'." >&2
              echo "  try:  stitchpad task new \"<title>\" [--priority p] [--to name] [--labels a,b] [--desc text] [--estimate 30m]" >&2
              exit 2 ;;
        esac
        title="${1:-Untitled}"; shift 2>/dev/null || true
        priority="none"; assignee=""; labels=""; desc=""; estimate=""
        while [ $# -gt 0 ]; do
          case "$1" in
            --priority) priority="$2"; shift 2 ;;
            --to|--assignee) assignee="$2"; shift 2 ;;
            --labels) labels="$2"; shift 2 ;;
            --desc) desc="$2"; shift 2 ;;
            --estimate) estimate="$2"; shift 2 ;;
            # A silent `*) shift` here discarded any unknown option AFTER the
            # title too, so a typo like --piority just vanished and the card was
            # created with the wrong metadata and rc=0.
            -*) echo "stitchpad: task new — unknown option '$1'" >&2
                echo "  known: --priority --to/--assignee --labels --desc --estimate" >&2
                exit 2 ;;
            *) shift ;;
          esac
        done
        # F4: Validate assignee against roster BEFORE locking — refusing a
        # ghost assignee early avoids lock contention and prevents stranded tasks.
        if [ -n "$assignee" ] && ! sp_user_exists "$assignee"; then
          echo "stitchpad: @$assignee not in roster — assignee must be a roster member; use 'stitchpad roster' to see members" >&2
          exit 1
        fi
        sp_lock || exit 1
        if [ -L "$PAD_TASKS" ] || [ -L "$PAD_MD" ]; then
          sp_unlock
          echo "stitchpad: refusing symlinked task mutation path" >&2
          exit 1
        fi
        # Next ID computed UNDER the lock — two agents creating concurrently
        # used to read the same max and mint colliding ids
        existing=$(sp_tasks | awk -F'|' '{print $1}' | sed 's/TASK-//' | sort -n | tail -1)
        [ -z "$existing" ] && existing=0
        id="TASK-$(( existing + 1 ))"
        # Build the block — always include all core fields so edit can find them
        ts="$(date -u '+%m-%d %H:%M')"
        block="\`\`\`task $id"$'\n'"title: $title"$'\n'"status: todo"$'\n'"priority: $priority"$'\n'"assignee: ${assignee:-}"$'\n'"labels: ${labels:-}"$'\n'"created: $ts"$'\n'"estimate: ${estimate:-}"$'\n'"---"$'\n'"${desc:-$id created}"$'\n'"\`\`\`"
        # Tasks are written to the SIBLING tasks.md, not the conversation. A
        # ticket op no longer rewrites or re-commits the whole transcript.
        # (Legacy inline blocks in the pad are still read — see sp_tasks.)
        #
        # E-13: atomic dual-write.  A crash between appending to tasks.md and
        # appending to the pad leaves tasks.md dirty (card present) and the
        # pad clean — recovery resets tasks.md, losing the card permanently.
        # Now both files are built in temp copies under the pad dir, then
        # renamed into place together.  The two mv calls are a ~ms window
        # instead of the ~human-scale window between the original appends.
        _e13_tasks_tmp="$PAD_DIR/.e13-tasks.$$.$RANDOM"
        _e13_pad_tmp="$PAD_DIR/.e13-pad.$$.$RANDOM"
        _e13_cleanup() { rm -f "$_e13_tasks_tmp" "$_e13_pad_tmp" 2>/dev/null || true; }
        trap '_e13_cleanup' EXIT

        # Build temp tasks.md
        if [ -f "$PAD_TASKS" ]; then
          cp "$PAD_TASKS" "$_e13_tasks_tmp" || { _e13_cleanup; sp_unlock; exit 1; }
        else
          cat > "$_e13_tasks_tmp" <<'TASKSEOF'
# 📋 tasks

> Task cards for this pad, split out of the conversation so that creating or
> moving a ticket no longer rewrites (and re-commits) the whole transcript.
> Format is unchanged: one ```task TASK-N fenced block per ticket.
>
> Legacy inline ```task blocks still in the pad are read too — run
> `stitchpad task migrate` to move them here.

TASKSEOF
        fi
        printf '\n%s\n' "$block" >> "$_e13_tasks_tmp"

        # Build temp pad (copy + tasks:file pointer + assignment notice)
        cp "$PAD_MD" "$_e13_pad_tmp" || { _e13_cleanup; sp_unlock; exit 1; }
        if ! grep -Fq '<!-- tasks:file -->' "$_e13_pad_tmp" 2>/dev/null; then
          base="$(basename "$PAD_TASKS")"
          if grep -q '^## Tasks' "$_e13_pad_tmp" 2>/dev/null; then
            awk -v base="$base" '
              { print }
              !stamped && /^## Tasks/ {
                print ""
                print "<!-- tasks:file -->"
                print "> 📋 Task cards live in `" base "` beside this pad. `stitchpad task list|new|move|edit` reads and writes there, so a ticket update no longer rewrites this conversation. Legacy task blocks left below are still read."
                stamped=1
              }
            ' "$_e13_pad_tmp" > "$_e13_pad_tmp.tmp" && mv "$_e13_pad_tmp.tmp" "$_e13_pad_tmp"
          else
            {
              printf '\n## Tasks\n\n<!-- tasks:file -->\n'
              printf '> 📋 Task cards live in `%s` beside this pad. `stitchpad task list|new|move|edit` reads and writes there.\n' "$base"
            } >> "$_e13_pad_tmp"
          fi
        fi
        # The ONE assignment notice. It carries a message id so the block can be
        # threaded and reacted to like any other message — that id is the only
        # thing the second, post-unlock copy of this block below ever added, and
        # that copy is why every `task new --to` posted the notice TWICE (once
        # here inside the lock, once again after sp_unlock through an unchecked
        # sp_commit, outside the atomic dual-write). Written here and only here.
        if [ -n "$assignee" ] && sp_user_exists "$assignee"; then
          printf '\n## @%s · %s · #%s\n\n**task %s assigned:** %s\n' \
            "$assignee" "$(date -u '+%H:%M')" "$(sp_msg_id)" "$id" "$title" >> "$_e13_pad_tmp"
        fi

        # Move both temp copies into place.  The window between the two mv
        # calls is a single filesystem op — bounded to ~ms.  A crash before
        # either mv leaves NEITHER real file dirty (temps are trap-cleaned).
        if ! mv "$_e13_tasks_tmp" "$PAD_TASKS"; then
          _e13_cleanup; sp_unlock; echo "stitchpad: failed to write tasks.md" >&2; exit 1
        fi
        # E-13 test barrier: park between tasks.md mv and pad mv so the gate
        # can SIGKILL here and verify both files land atomically on recovery.
        if [ -n "${STITCHPAD_TASK_DUALWRITE_BARRIER:-}" ]; then
          printf '%s' ready > "$STITCHPAD_TASK_DUALWRITE_BARRIER.ready"
          local _e13_barrier_i=0
          while [ ! -f "$STITCHPAD_TASK_DUALWRITE_BARRIER.release" ] && [ "$_e13_barrier_i" -lt 500 ]; do
            sleep 0.01; _e13_barrier_i=$((_e13_barrier_i + 1))
          done
          [ -f "$STITCHPAD_TASK_DUALWRITE_BARRIER.release" ] || { _e13_cleanup; sp_unlock; exit 1; }
        fi
        if ! mv "$_e13_pad_tmp" "$PAD_MD"; then
          _e13_cleanup; sp_unlock
          echo "stitchpad: task $id: tasks.md written but pad update failed — board is consistent; retry any command" >&2
          exit 1
        fi
        trap - EXIT  # temps already moved, disarm cleanup

        if ! sp_commit_or_fail "task $id: $title" "$(basename "$PAD_TASKS")" "$(basename "$PAD_MD")"; then
          sp_unlock
          echo "stitchpad: task $id commit failed — card may not be durable; $id NOT created" >&2
          exit 1
        fi
        # P19: commit landed — narrate the card, never self-committing.
        sp_narrate "opened task $id: $title" 2>/dev/null || true
        sp_unlock
        echo "$id created"
        # The assignee's notice is written ABOVE, inside the lock, as part of the
        # atomic dual-write. It used to be appended a SECOND time right here —
        # after sp_unlock, straight into $PAD_MD, with an unchecked sp_commit.
        # That gave every `task new --to` two identical notice blocks, and the
        # duplicate landed outside the lock with its commit result discarded, so
        # a failed commit left the pad file ahead of its own history in silence.
        # Deleted deliberately: one notice, written once, under the lock.
        ;;

      list)
        # P38: this printed ONE pipe-delimited line per card with the entire body
        # inline — TASK-1 ran to ~700 characters and six cards filled a screen, so
        # the board was unreadable exactly when an operator needed to see where the
        # fleet was. The machine format is load-bearing (suites parse '^TASK-N|'),
        # so it is preserved BYTE FOR BYTE for pipes, redirects, and --porcelain.
        # Only an interactive terminal gets the rendered board.
        # --human forces the board, --porcelain forces the machine format. The
        # explicit flags exist so BOTH paths are testable without a terminal —
        # a rendering that can only be exercised interactively is a rendering
        # nothing gates.
        _tl_human=0
        [ "${1:-}" = "--human" ] && { _tl_human=1; shift; }
        if [ "${1:-}" = "--porcelain" ]; then
          shift
          sp_tasks "$@"
        elif [ "$_tl_human" = "1" ] || [ -t 1 ]; then
          _tl_cols="$(tput cols 2>/dev/null || echo 100)"
          case "$_tl_cols" in ''|*[!0-9]*) _tl_cols=100 ;; esac
          sp_tasks "$@" | awk -F'|' -v cols="$_tl_cols" '
            BEGIN {
              w = cols - 40; if (w < 20) w = 20
              printf "%-9s %-12s %-10s %-6s %s\n", "ID", "STATUS", "OWNER", "PRI", "TITLE"
              printf "%-9s %-12s %-10s %-6s %s\n", "---------", "------------", "----------", "------", "-----"
            }
            $1 != "" {
              title = $2; owner = ($5 == "" ? "-" : $5); pri = ($4 == "" ? "-" : $4)
              gsub(/\n/, " ", title)
              if (length(title) > w) title = substr(title, 1, w - 1) "…"
              printf "%-9s %-12s %-10s %-6s %s\n", $1, $3, owner, pri, title
              n++
            }
            END { if (n == 0) print "(no tasks yet — stitchpad task new \"...\")" }'
        else
          sp_tasks "$@"
        fi
        ;;

      board)
        # P21: rich task board with owner liveness, artifact presence, staleness
        #   stitchpad task board [--mine <name>] [--status <status>]
        sp_task_board "$@"
        ;;

      eta)
        # P20: wall-clock projection modelling parallelism
        #   stitchpad task eta
        sp_task_eta
        ;;

      show)
        tid="${1:?usage: stitchpad task show <TASK-N>}"
        # tasks.md wins: show the authoritative copy, not whichever file awk
        # hits first.  A duplicate (ghost inline block in the pad + real card
        # in tasks.md) is common pre-migration — warn so the operator knows
        # to run `stitchpad task migrate`.
        sp_task_detect_duplicate "$tid" || true
        _show_f="$(sp_task_file "$tid")" || { echo "stitchpad: no such task: $tid" >&2; exit 1; }
        # E-18: track nested ``` fences so internal code blocks in the task
        # body don't prematurely close the task block.  The task ends only
        # when depth returns to zero after the opening ```task fence.
        awk -v want="\`\`\`task $tid" '
          $0==want { p=1; depth=1; next }
          p && /^```[^t]/ { depth++; print; next }
          p && /^```$/   { depth--; if (depth==0) exit; print; next }
          p { print }
        ' "$_show_f"
        ;;

      move)
        id="${1:-}"; new_status="${2:-}"
        [ -z "$id" ] && { echo "usage: stitchpad task move <id> <status> [--from <current-status>]" >&2; exit 1; }
        [ -z "$new_status" ] && { echo "usage: stitchpad task move <id> <status> [--from <current-status>]" >&2; exit 1; }
        _move_from=""
        if [ "${3:-}" = "--from" ]; then _move_from="${4:-}"; fi
        # Resolve which file holds the card BEFORE the lock so we can snapshot
        # its current status for the default CAS baseline.
        tfile="$(sp_task_file "$id")" || { echo "stitchpad: no such task: $id" >&2; exit 1; }
        # F5 CAS: when --from is NOT passed, read the card's current status
        # BEFORE acquiring the lock.  This becomes the default expected-from
        # value.  If another writer changes the card between this read and the
        # lock, the under-lock re-read catches it and refuses.
        _move_seen=""
        if [ -z "$_move_from" ]; then
          _move_seen="$(awk -v tid="$id" '
            /^```task / && $2==tid  { inblk=1; inmeta=1; next }
            inblk && inmeta && /^status:/ { sub(/^status:[[:space:]]*/,""); print; exit }
            /^```$/ && inblk          { exit }
          ' "$tfile")"
        fi
        sp_lock || exit 1
        # F5 CAS: re-read current status under the lock.  Compare against the
        # explicit --from value when given, or the pre-lock snapshot otherwise.
        # Two concurrent moves on one card produce exactly one success + one
        # explicit refusal, never two successes.
        _move_current="$(awk -v tid="$id" '
          /^```task / && $2==tid  { inblk=1; inmeta=1; next }
          inblk && inmeta && /^status:/ { sub(/^status:[[:space:]]*/,""); print; exit }
          /^```$/ && inblk          { exit }
        ' "$tfile")"
        _move_expected="${_move_from:-$_move_seen}"
        if [ -n "$_move_expected" ] && [ -n "$_move_current" ] && [ "$_move_current" != "$_move_expected" ]; then
          sp_unlock
          echo "stitchpad: REFUSED — $id is '$_move_current', not '$_move_expected' (changed by another writer); re-read and retry with --from '$_move_current'"
          exit 1
        fi
        sp_task_detect_duplicate "$id" || true  # warn if ghost exists in the other file
        tmp="$(sp_stage "$tfile")"
        awk -v tid="$id" -v ns="$new_status" '
          /^```task / && $2==tid { inblk=1; inmeta=1 }
          inblk && inmeta && /^status:/ { sub(/status:.*/, "status: " ns) }
          /^```$/ && inblk { inblk=0 }
          { print }
        ' "$tfile" > "$tmp"
        sp_write_inplace "$tmp" "$tfile"; rc=$?
        [ "$rc" -eq 1 ] && { sp_unlock; exit 1; }
        # rc=2 → status already was $new_status: no write, no commit, no churn
        if [ "$rc" -eq 0 ]; then
          if ! sp_commit_or_fail "task $id → $new_status" "$(basename "$tfile")"; then
            sp_unlock
            echo "stitchpad: task move commit failed — card may not be durable; $id status NOT changed" >&2
            exit 1
          fi
        fi
        # P19: card moved — narrate every transition, so the board shows live
        # progress without an agent remembering to `say` (P21 leans on this too).
        [ "$rc" -eq 0 ] && { sp_narrate "moved $id → $new_status" 2>/dev/null || true; }
        sp_unlock
        echo "$id → $new_status"
        ;;

      edit)
        id="${1:-}"; shift 2>/dev/null || true
        [ -z "$id" ] && { echo "usage: stitchpad task edit <id> [--priority X] [--to name] [--labels X] [--estimate 30m]" >&2; exit 1; }
        # F4: Collect field updates BEFORE locking — validate assignee against
        # roster so a ghost assignee is refused without holding the lock.
        new_priority=""; new_assignee=""; new_labels=""; new_estimate=""
        while [ $# -gt 0 ]; do
          case "$1" in
            --priority) new_priority="$2"; shift 2 ;;
            --to|--assignee) new_assignee="$2"; shift 2 ;;
            --labels) new_labels="$2"; shift 2 ;;
            --estimate) new_estimate="$2"; shift 2 ;;
            *) shift ;;
          esac
        done
        if [ -n "$new_assignee" ] && ! sp_user_exists "$new_assignee"; then
          echo "stitchpad: @$new_assignee not in roster — assignee must be a roster member" >&2
          exit 1
        fi
        sp_lock || exit 1
        tfile="$(sp_task_file "$id")" || { sp_unlock; echo "stitchpad: no such task: $id" >&2; exit 1; }
        sp_task_detect_duplicate "$id" || true  # warn if ghost exists in the other file
        tmp="$(sp_stage "$tfile")"
        awk -v tid="$id" -v np="$new_priority" -v na="$new_assignee" -v nl="$new_labels" -v ne="$new_estimate" '
          /^```task / && $2==tid { inblk=1; inmeta=1 }
          inblk && inmeta && np!="" && /^priority:/ { sub(/priority:.*/, "priority: " np) }
          inblk && inmeta && na!="" && /^assignee:/ { sub(/assignee:.*/, "assignee: " na) }
          inblk && inmeta && nl!="" && /^labels:/ { sub(/labels:.*/, "labels: " nl) }
          inblk && inmeta && ne!="" && /^estimate:/ { sub(/estimate:.*/, "estimate: " ne) }
          /^```$/ && inblk { inblk=0 }
          { print }
        ' "$tfile" > "$tmp"
        sp_write_inplace "$tmp" "$tfile"; rc=$?
        [ "$rc" -eq 1 ] && { sp_unlock; exit 1; }
        if [ "$rc" -eq 0 ]; then
          if ! sp_commit_or_fail "task $id metadata updated" "$(basename "$tfile")"; then
            sp_unlock
            echo "stitchpad: task edit commit failed — card may not be durable; $id NOT updated" >&2
            exit 1
          fi
        fi
        sp_unlock
        echo "$id updated"
        ;;

      migrate)
        # One-time move of legacy inline ```task blocks out of the pad and into
        # tasks.md. Optional — nothing breaks if it is never run, because
        # sp_tasks reads both files. --dry-run reports without writing.
        dry=0; [ "${1:-}" = "--dry-run" ] && dry=1
        sp_lock || exit 1
        n_inline="$(awk '/^```task /{c++} END{print c+0}' "$PAD_MD")"
        if [ "$n_inline" -eq 0 ]; then
          sp_unlock; echo "no inline task blocks in $(basename "$PAD_MD") — nothing to migrate"; exit 0
        fi
        if [ "$dry" -eq 1 ]; then
          sp_unlock; echo "would move $n_inline inline task block(s) → $(basename "$PAD_TASKS")"; exit 0
        fi
        sp_ensure_tasks_file || { sp_unlock; exit 1; }
        moved="$(mktemp)"; kept="$(sp_stage "$PAD_MD")"
        awk -v out="$moved" '
          /^```task / { inblk=1; print > out; next }
          inblk && /^```$/ { inblk=0; print "```" > out; print "" > out; next }
          inblk { print > out; next }
          { print }
        ' "$PAD_MD" > "$kept"
        printf '\n' >> "$PAD_TASKS"; cat "$moved" >> "$PAD_TASKS"; rm -f "$moved"
        sp_write_inplace "$kept" "$PAD_MD"
        sp_ensure_tasks_pointer
        # S5: migrate MOVES bytes between two files. Unrecorded, tasks.md holds
        # the cards while the pad no longer does, with nothing in history.
        sp_commit_or_fail "tasks: migrated $n_inline inline block(s) → $(basename "$PAD_TASKS")" \
          "$(basename "$PAD_TASKS")" "$(basename "$PAD_MD")" || {
          sp_unlock
          echo "stitchpad: task migrate NOT recorded — refusing to report success" >&2
          exit 1; }
        sp_unlock
        echo "✓ migrated $n_inline task block(s) → $PAD_TASKS"
        ;;

      *) echo "usage: stitchpad task {new|list|board|eta|show|move|edit|migrate}" >&2; exit 1 ;;
    esac
    ;;

  migration-check)
    # 4-point push-target reachability verifier. All 4 gates must pass before a
    # member is considered reachable.
    #   stitchpad migration-check <name>
    sp_init_paths || exit 1
    _mc_pilot="${1:-}"
    if [ -z "$_mc_pilot" ]; then
      echo "usage: stitchpad migration-check <name>" >&2
      exit 1
    fi

    _mc_pass=0; _mc_fail=0
    _mc_green=$'\033[32m'; _mc_red=$'\033[31m'; _mc_reset=$'\033[0m'

    echo "stitchpad migration-check — verifying @$_mc_pilot"
    echo ""

    # Gate 1: doctor confirms a supported push target
    echo -n "  [1/4] push target .............. "
    _mc_doctor_out="$("$0" doctor --json 2>/dev/null || true)"
    if echo "$_mc_doctor_out" | python3 -c "
import json, sys
data = json.load(sys.stdin)
for m in data:
    if m.get('name') == '$_mc_pilot':
        t = m.get('target', '')
        a = m.get('adapter', '')
        if a in ('herdr', 'ocean') and m.get('wake') == 'push' and t and t != '-':
            print('OK')
            sys.exit(0)
print('FAIL')
sys.exit(1)
" 2>/dev/null; then
      echo "${_mc_green}PASS${_mc_reset} — push target validated"
      (( _mc_pass++ ))
    else
      echo "${_mc_red}FAIL${_mc_reset} — not herdr/ocean push or no target"
      (( _mc_fail++ ))
    fi

    # Gate 2: recent heartbeat from the agent process
    echo -n "  [2/4] heartbeat ................ "
    _mc_alive_file="$PAD_STATE/alive.$_mc_pilot"
    if [ -f "$_mc_alive_file" ]; then
      _mc_alive_age="$(($(date +%s) - $(stat -f %m "$_mc_alive_file" 2>/dev/null || stat -c %Y "$_mc_alive_file" 2>/dev/null || echo 0)))"
      if [ "$_mc_alive_age" -lt 90 ]; then
        _mc_alive_pid="$(python3 -c "import json; print(json.load(open('$_mc_alive_file')).get('pid',''))" 2>/dev/null || true)"
        if [ -n "$_mc_alive_pid" ] && kill -0 "$_mc_alive_pid" 2>/dev/null; then
          echo "${_mc_green}PASS${_mc_reset} — heartbeat $(printf '%ds' "$_mc_alive_age") ago, pid $_mc_alive_pid alive"
          (( _mc_pass++ ))
        else
          echo "${_mc_red}FAIL${_mc_reset} — pid $_mc_alive_pid not running"
          (( _mc_fail++ ))
        fi
      else
        echo "${_mc_red}FAIL${_mc_reset} — heartbeat ${alive_age}s stale"
        (( _mc_fail++ ))
      fi
    else
      echo "${_mc_red}FAIL${_mc_reset} — no heartbeat file"
      (( _mc_fail++ ))
    fi

    # Gate 3: single session→name (no dual ownership)
    echo -n "  [3/4] single identity ........... "
    _mc_session_count=0
    _mc_extra_sessions=""
    for _mc_sf in "$PAD_STATE/sessions/"*; do
      [ -f "$_mc_sf" ] || continue
      if [ "$(cat "$_mc_sf" 2>/dev/null)" = "$_mc_pilot" ]; then
        (( _mc_session_count++ ))
        [ "$_mc_session_count" -gt 1 ] && extra_sessions="$_mc_extra_sessions $(basename "$_mc_sf")"
      fi
    done
    # Also check whoami fallback
    if [ "$(cat "$PAD_STATE/whoami" 2>/dev/null || true)" = "$_mc_pilot" ]; then
      (( _mc_session_count++ ))
      _mc_extra_sessions="$_mc_extra_sessions whoami"
    fi
    if [ "$_mc_session_count" -eq 1 ]; then
      echo "${_mc_green}PASS${_mc_reset} — exactly 1 session→name binding"
      (( _mc_pass++ ))
    elif [ "$_mc_session_count" -eq 0 ]; then
      echo "${_mc_red}FAIL${_mc_reset} — no session bound"
      (( _mc_fail++ ))
    else
      echo "${_mc_red}FAIL${_mc_reset} — $_mc_session_count bindings (dual ownership):$_mc_extra_sessions"
      (( _mc_fail++ ))
    fi

    # Gate 4: wake round-trip — seen cursor advanced + reply ordinal exists
    echo -n "  [4/4] wake round-trip ........... "
    _mc_seen_file="$PAD_STATE/seen.$_mc_pilot"
    _mc_seen_before=0 seen_after=0
    if [ -f "$_mc_seen_file" ]; then
      _mc_seen_before="$(cat "$_mc_seen_file" 2>/dev/null || echo 0)"
    fi
    # Send a test ping via the pad (silent, just advances the cursor)
    "$0" say "[$_mc_pilot migration-check ping $(date +%s)]" >/dev/null 2>&1 || true
    sleep 2
    # Check the seen cursor advanced
    _mc_seen_after=0
    if [ -f "$_mc_seen_file" ]; then
      _mc_seen_after="$(cat "$_mc_seen_file" 2>/dev/null || echo 0)"
    fi
    if [ "$_mc_seen_after" -gt "$_mc_seen_before" ]; then
      echo "${_mc_green}PASS${_mc_reset} — seen cursor $_mc_seen_before → $_mc_seen_after (wake delivered)"
      (( _mc_pass++ ))
    else
      echo "${_mc_red}FAIL${_mc_reset} — seen cursor did not advance ($_mc_seen_before → $_mc_seen_after)"
      (( _mc_fail++ ))
    fi

    # Summary
    echo ""
    if [ "$_mc_fail" -eq 0 ]; then
      echo "${_mc_green}ALL 4 GATES PASSED — @$_mc_pilot migration proven.${_mc_reset}"
      exit 0
    else
      echo "${_mc_red}$_mc_fail/$(( _mc_pass + _mc_fail )) GATES FAILED — @$_mc_pilot is not reachable.${_mc_reset}"
      exit 1
    fi
    ;;

  lanes)
    # P3: artifact-contract board — every seat's real output, never silent.
    #   stitchpad lanes [--json]
    # A seat that produces nothing shows FAILED, not idle.  Missing artifacts
    # after a terminal session are the loudest signal in the fleet.
    sp_init_paths_readonly || exit 1
    # P5 (deepseek F2): `roster` and `whoami` refuse loudly when the pad's git dir
    # is gone, but the operator's PRIMARY status board did not — it rendered a
    # table and exited 0 on a pad whose durability layer no longer exists. The
    # next write then silently re-initialises an EMPTY history, so every prior
    # commit (read cursors, heal-roster history, the compaction audit trail) is
    # destroyed without a word. The board must not be the one surface that says
    # nothing is wrong; a lane table is a claim about a fleet, and it cannot be
    # made against a pad that can no longer record anything.
    sp_assert_pad_git_usable || exit 1
    if [ "${1:-}" = "--json" ]; then
      # NO `local` HERE. This is the top level of a case arm, not a function
      # body, and bash rejects `local` outside a function — it printed
      #   stitchpad: line NNNN: local: can only be used in a function
      # to stderr TWICE on every single `lanes --json`, healthy pad or not. The
      # command still worked (the names silently became globals and stdout still
      # parsed), which is exactly why it survived: only stderr was wrong, so
      # every cron, CI job and daemon capturing it logged two garbage lines per
      # call while the "--json is clean" contract quietly did not hold.
      _now="$(date +%s)"
      _proj="$(sp_session_registry_project 2>/dev/null || echo '[]')"
      echo '['
      _first=1
      # k3 F0: this iterated artifact-expect.* ONLY, so a seat with no artifact
      # claim never appeared — including a seat the watchdog had quarantined,
      # which is precisely the row a dashboard needs. Same lane set as the text
      # board now (sp_lanes_names), so the two surfaces cannot disagree about
      # who exists.
      while IFS= read -r _name; do
        [ -n "$_name" ] || continue
        _claim="$PAD_STATE/artifact-expect.$_name"
        _status="$(echo "$_proj" | python3 -c "
import json, sys
data = json.load(sys.stdin)
for s in data:
    if s.get('name','') == '$_name':
        print(s.get('status',''))
        sys.exit(0)
print('unknown')
" 2>/dev/null)"
        [ -z "$_status" ] && _status="unknown"
        if [ -f "$_claim" ]; then
          _age="$(( _now - $(stat -f %m "$_claim" 2>/dev/null || echo "$_now") ))"
          _art="$(head -1 "$_claim")"
          if sp_artifact_verify "$_name" 2>/dev/null; then _present="yes"; else _present="no"; fi
        else
          # No artifact contract for this seat: say so, rather than inventing a
          # verdict about an artifact nobody promised.
          _age="$(( _now - $(stat -f %m "$PAD_STATE/alive.$_name" 2>/dev/null || echo "$_now") ))"
          _art="-"; _present="-"
        fi
        case "$_status" in
          terminal) [ "$_present" = "no" ] && _verdict="FAILED" || _verdict="COMPLETE" ;;
          stale) _verdict="STALE" ;;
          idle) _verdict="IDLE" ;;
          active) _verdict="WORKING" ;;
          *) case "$_present" in
               no) _verdict="FAILED" ;;
               yes) _verdict="DONE" ;;
               *) _verdict="UNKNOWN" ;;
             esac ;;
        esac
        # k3 F0: --json is what every dashboard and cron reads, so quarantine
        # has to travel here too — as a first-class field, not only folded into
        # the verdict, so a consumer can act on it without string-matching.
        _strikes="$(cat "$PAD_STATE/keeper-strike.$_name" 2>/dev/null || echo 0)"
        case "$_strikes" in ''|*[!0-9]*) _strikes=0 ;; esac
        _quar=false
        if [ "$_strikes" -ge "${SEAT_KEEPER_MAX_STRIKES:-3}" ]; then _quar=true; _verdict="QUARANTINED"; fi
        [ "$_first" -eq 1 ] || printf ',\n'
        _first=0
        printf '  {"name":"%s","status":"%s","age_s":%s,"artifact_expected":"%s","artifact_present":"%s","verdict":"%s","keeper_strikes":%s,"quarantined":%s}' \
          "$_name" "$_status" "$_age" "$_art" "$_present" "$_verdict" "$_strikes" "$_quar"
      done <<< "$(sp_lanes_names "$_proj")"
      echo ''; echo ']'
    else
      sp_lanes_display
    fi
    ;;

  telemetry)
    # TASK-7: bounded per-model reliability + cost-value reader.
    #   stitchpad telemetry [--json] [--model M] [--days N] [--limit N]
    sp_init_paths_readonly || exit 1
    sp_telemetry_summary "$@"
    ;;

  help|-h|--help)
    # Was `sed -n '2,44p'` — a HARDCODED line range. Every command documented
    # below line 44 was invisible to `stitchpad help` while still satisfying the
    # header-based discoverability gate: reconcile, lanes, pads and evidence had
    # already fallen off the end unnoticed, and spawn/directive joined them the
    # moment they were added. An agent cannot use a command it cannot see.
    # Print the whole leading comment block instead, ending where the code
    # begins. Self-maintaining: a command added to the header now appears in
    # help automatically, and can never silently fall off the end again.
    awk 'NR>=2 { if ($0 !~ /^#/) exit; sub(/^# ?/, ""); print }' "$0"
    ;;

  *)
    # An unknown command MUST fail loudly. Printing help with exit 0 once let a
    # caller adopt the entire help text as an agent's identity.
    echo "stitchpad: unknown command '$cmd' (see: stitchpad help)" >&2
    exit 1
    ;;
esac
