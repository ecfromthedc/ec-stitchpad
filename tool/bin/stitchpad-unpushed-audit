#!/usr/bin/env bash
# stitchpad-unpushed-audit — find work that exists in exactly one place.
#
# The wedge this exists for (2026-08-17, found twice in one morning):
#
# A seat can look perfectly clean and still be holding work nobody else can see.
# `git status` says nothing because the work is COMMITTED; the commit is simply
# not pushed. During one overnight build two seats were found holding 15 and 23
# such commits, and one of them was the highest-value fix on the board — sitting
# where no reviewer could reach it. Separately, the tool everyone depends on for
# rotations had two unpushed fixes on a branch the operator was not looking at,
# because the main clone sits on a different branch and the installed binary
# symlinks into another worktree entirely.
#
# Same house failure family as the seat death zone: A THING THAT LOOKS FINE AND
# IS NOT. "clean worktree" means "nothing uncommitted", never "nothing at risk".
#
# THREE WAYS WORK HIDES, and this checks all three:
#
#   unpushed commits  — committed on a branch, ahead of its upstream. Invisible to
#                       `git status`. The common case.
#   ORPHAN commits    — committed on a DETACHED HEAD, reachable from no branch at
#                       all. Strictly worse: no branch name to find it by, and a
#                       per-branch sweep cannot see it. This is the one that gets
#                       lost for good.
#   diverged branches — local and upstream have both moved, so a plain push is
#                       REJECTED. Work stays local while the operator believes a
#                       push succeeded. Only the branch's owner should resolve
#                       this, with --force-with-lease; never force another lane.
#   UNREACHABLE wip    — a commit that no branch and no worktree HEAD points at,
#                       findable only through the reflog. Added 2026-08-17 after
#                       this tool MISSED 333 lines of the last open P0 for nine
#                       hours: a rotation-secure commit whose branch then moved,
#                       recovered only because a stash message happened to name
#                       the SHA. A per-branch sweep cannot see it by construction,
#                       and the detached-HEAD check above does not either — the
#                       worktree had a branch, the COMMIT just stopped being on it.
#                       One `git gc` from gone.
#
# Usage:
#   stitchpad-unpushed-audit [repo ...]        # default: cwd
#   stitchpad-unpushed-audit --quiet [repo]    # findings only, for a loop tick
#
# Exit: 0 nothing at risk · 3 something is held in one place (advisory, not fatal
#       — the caller decides; a build loop should report it, not stop for it)
set -uo pipefail

QUIET=0
ROOTS=""
for arg in "$@"; do
  case "$arg" in
    --quiet|-q) QUIET=1 ;;
    -h|--help) sed -n '2,40p' "$0"; exit 0 ;;
    *) ROOTS="$ROOTS $arg" ;;
  esac
done
[ -n "${ROOTS// /}" ] || ROOTS="$PWD"

FOUND=0

say() { [ "$QUIET" = "1" ] || printf '%s\n' "$*"; }
finding() { FOUND=1; printf '%s\n' "$*"; }

for repo in $ROOTS; do
  if ! git -C "$repo" rev-parse --git-dir >/dev/null 2>&1; then
    finding "NOT-A-REPO $repo"
    continue
  fi
  say "== $repo"
  git -C "$repo" fetch --all --quiet 2>/dev/null || say "   (fetch failed — results may be stale)"

  # 1. Branches ahead of, or diverged from, their upstream.
  #    Bash 3.2: one `local`-free loop, one variable per line. (A `local` used
  #    with multiple assignments outside a function is the bug that shipped in
  #    this tool's sibling — see its history.)
  for br in $(git -C "$repo" for-each-ref --format='%(refname:short)' refs/heads/ 2>/dev/null); do
    up=$(git -C "$repo" rev-parse --abbrev-ref --symbolic-full-name "$br@{upstream}" 2>/dev/null)
    if [ -z "$up" ]; then
      # Same test as below: a branch with no upstream is only a problem if some
      # commit on it is reachable from no remote ref at all. Local backup/ and
      # rescue/ refs pointing at already-pushed history are not findings.
      at_risk=$(git -C "$repo" rev-list "$br" --not --remotes 2>/dev/null | wc -l | tr -d ' ')
      if [ "${at_risk:-0}" != "0" ]; then
        finding "NO-UPSTREAM  $repo  $br — no upstream AND $at_risk commit(s) on no remote ref"
      fi
      continue
    fi
    ahead=$(git -C "$repo" rev-list --count "$up..$br" 2>/dev/null)
    behind=$(git -C "$repo" rev-list --count "$br..$up" 2>/dev/null)
    # AHEAD OF ITS OWN UPSTREAM IS NOT THE SAME AS AT RISK. A fully-merged lane
    # branch is ahead of its stale `origin/<lane>` ref forever while every one of
    # its commits sits safely in `origin/main`. Reporting those cries wolf, and a
    # noisy audit gets ignored — which is worse than no audit. So the question is
    # not "ahead of upstream" but "reachable from ANY remote ref". This caught a
    # 38-commit lane that looked lost and was entirely merged.
    at_risk=$(git -C "$repo" rev-list "$up..$br" --not --remotes 2>/dev/null | wc -l | tr -d ' ')
    if [ "${at_risk:-0}" = "0" ]; then
      if [ "${ahead:-0}" != "0" ]; then
        say "   ok  $br — $ahead ahead of $up but every commit is on some remote ref (merged elsewhere)"
      fi
      continue
    fi
    # PREDICT THE PUSH AGAINST THE REF THE PUSH ACTUALLY TARGETS.
    #
    # `git push origin <br>` writes refs/heads/<br> on the remote — which is NOT
    # necessarily `<br>@{upstream}`. A lane tracking origin/main is "0 behind"
    # its upstream while origin/sell/<lane> has moved on, and this tool then
    # reported UNPUSHED for a branch whose plain push is rejected
    # non-fast-forward. Measured on sell/billing and sell/ops-hardening: both
    # called UNPUSHED, both rejected. A wrong prediction is worse than none,
    # because the caller acts on it — so ask origin/<same-name>.
    push_target="origin/$br"
    if git -C "$repo" rev-parse --verify -q "$push_target" >/dev/null 2>&1; then
      target_only=$(git -C "$repo" rev-list --count "$br..$push_target" 2>/dev/null)
    else
      target_only=0   # no such remote ref: a plain push CREATES it, never rejected
    fi
    if [ "${target_only:-0}" != "0" ]; then
      finding "DIVERGED     $repo  $br — $at_risk commit(s) on NO remote ref, $target_only on $push_target that you do not have; a plain push WILL be rejected non-fast-forward. The branch OWNER resolves with --force-with-lease."
    else
      finding "UNPUSHED     $repo  $br — $at_risk commit(s) exist only here; a plain push to $push_target should succeed"
    fi
  done

  # 1b. UNREACHABLE wip commits — reachable from the reflog and nothing else.
  #
  # Precision matters more than recall here. A busy repo has hundreds of
  # reflog-only commits (every intermediate rebase state), and reporting them all
  # would bury the one that counts — a noisy audit gets ignored, which is worse
  # than no audit. So report only commits that were created to PRESERVE work and
  # then fell off: this tooling's own rotation-secure commits, whose subject is
  # `wip(...)` / `secured by overseer`. That is exactly the commit shape that hid
  # 333 lines of P0-12. Everything else is counted, not listed, so the noise
  # floor stays visible without drowning the signal.
  unreachable_all=$(git -C "$repo" rev-list --reflog --not --all 2>/dev/null | wc -l | tr -d ' ')
  if [ "${unreachable_all:-0}" != "0" ]; then
    listed=0
    for h in $(git -C "$repo" rev-list --reflog --not --all 2>/dev/null | head -400); do
      subj=$(git -C "$repo" log -1 --format='%s' "$h" 2>/dev/null)
      case "$subj" in
        wip\(*|*"secured by overseer"*) ;;
        *) continue ;;
      esac
      short=$(git -C "$repo" rev-parse --short "$h" 2>/dev/null)
      files=$(git -C "$repo" show --stat --format='' "$h" 2>/dev/null | tail -1 | tr -d '\n')
      finding "UNREACHABLE  $repo  $short — on NO branch and no worktree HEAD, findable only via reflog: \"$subj\" ($files). Some of these are SUPERSEDED (the work landed later via a rebase) and some are lost work — this tool does not know which, and finding out costs more than insuring against it. So rescue first, decide after: git branch rescue/wip-$short $short && git push origin rescue/wip-$short. Cheap, reversible, and one gc from impossible."
      listed=$((listed + 1))
    done
    if [ "$listed" = "0" ]; then
      say "   ok  $unreachable_all reflog-only commit(s), none of them secured-work commits (rebase noise)"
    else
      say "   note $unreachable_all reflog-only commit(s) total; $listed look like preserved work and are listed above"
    fi
  fi

  # 2. Detached-HEAD worktrees whose HEAD is on no remote branch = orphan.
  git -C "$repo" worktree list --porcelain 2>/dev/null \
    | awk '/^worktree /{w=$2} /^detached$/{print w}' \
    | while read -r wt; do
        [ -n "$wt" ] || continue
        h=$(git -C "$wt" rev-parse --short HEAD 2>/dev/null)
        [ -n "$h" ] || continue
        onremote=$(git -C "$repo" branch -r --contains "$h" 2>/dev/null | wc -l | tr -d ' ')
        if [ "${onremote:-0}" = "0" ]; then
          # Orphan: no branch name to recover this by.
          printf '%s\n' "ORPHAN       $repo  $wt @ $h — detached HEAD on NO remote branch. Give it a branch before this worktree is pruned."
        fi
      done
  # The while-loop above runs in a subshell, so FOUND cannot be set there.
  # Re-detect cheaply so the exit code is honest.
  if git -C "$repo" worktree list --porcelain 2>/dev/null \
      | awk '/^worktree /{w=$2} /^detached$/{print w}' \
      | while read -r wt; do
          [ -n "$wt" ] || continue
          h=$(git -C "$wt" rev-parse --short HEAD 2>/dev/null) || continue
          n=$(git -C "$repo" branch -r --contains "$h" 2>/dev/null | wc -l | tr -d ' ')
          [ "${n:-0}" = "0" ] && exit 7
        done; [ $? -eq 7 ]; then
    FOUND=1
  fi
done

if [ "$FOUND" = "0" ]; then
  say "nothing held in one place — every commit is on a remote branch"
  exit 0
fi
exit 3
