.DS_Store
*.log
# local tooling, not part of the product
.claude/
# per-project channel runtime state (when stitchpad is used somewhere)
.stitchpad/.state/
.stitchpad/stitchpad-git/
.pasture/.state/
.pasture/pasture-git/
.chatroom/.state/
.chatroom/channel-git/

# rust build artifacts
tool/tui-rs/target/

# stray test runtime under tool/
tool/.state/

# mcp server deps (installed via npm install)
tool/mcp/node_modules/
tool/mcp/package-lock.json

tool/relay/.wrangler/

# machine-local — the "never git add -A" rule, now enforced instead of remembered:
# keeper runtime config, bridge runtime state, and per-operator wrangler configs
# (some carry credential-shaped lines). The generic tool/relay/wrangler.toml
# template stays tracked; the glob below does not match it.
tool/keeper.conf
tool/relay/state/
tool/relay/wrangler.*.toml

tool/stitchpad-git/

# stitchpad runtime (isolated history)
.stitchpad/
__pycache__/
